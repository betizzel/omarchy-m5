From ad562d5528760b17b22d81a8189638dc2e83c1cb Mon Sep 17 00:00:00 2001
From: Julian Arango <95070226+ja-818@users.noreply.github.com>
Date: Sun, 22 Nov 2026 21:46:25 -0500
Subject: [PATCH 11/11] arm64: dts: apple: t6050-j716s: jack, microphones and
 AOP sensors; speakers held off

The J716s's AOP, its audio service, microphone array, light sensor and
lid angle, the CS42L84 jack codec on i2c2, and a jack-only macaudio
card, each checked against the J716sAP 27.2 (26B123) ADT (the J714s's
nodes; only the acoustic ID differs). The six SN012776 amps are not
described and their shutdown line (AP pin 107) is held low from boot:
no speaker protection has played on this board yet.

Seen on one J716s (27.2 stub): the AOP and both cards come up, the jack
reports a plug (PipeWire shows Headphones and the headset microphone),
the internal microphones record speech, the light sensor reads.
Playback through the jack was not listened to.

Signed-off-by: Julian Arango <95070226+ja-818@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t6050-j716s.dts | 102 ++++++++++++++++++++--
 1 file changed, 97 insertions(+), 5 deletions(-)

diff --git a/arch/arm64/boot/dts/apple/t6050-j716s.dts b/arch/arm64/boot/dts/apple/t6050-j716s.dts
index d6cf011a7786..216f7f37762d 100644
--- a/arch/arm64/boot/dts/apple/t6050-j716s.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j716s.dts
@@ -447,23 +447,53 @@ &usb_drd2_dart_1 {
 	status = "okay";
 };
 
-/* Audio is not brought up: six sn012776 on i2c1/i2c3 and a cs42l84 on i2c2 */
+/*
+ * Sound, first stage: the headphone jack, the microphones and the AOP's sensors
+ * (light, lid angle); the speakers stay off. The J716sAP 27.2 (26B123) ADT's
+ * audio is the J714sAP's: a CS42L84 jack codec at i2c2 0x4b (reset AP pin 139,
+ * interrupt pin 134), the same AOP audio service and microphone array, and six
+ * SN012776 amps at i2c1 0x38-0x3a and i2c3 0x3b-0x3d whose shutdown line is AP
+ * pin 107 (function-reset of /arm-io/i2c1/audio-speaker, as on the J714s). No
+ * speaker protection has played on this board, so the amps are not described
+ * (i2c1 and i2c3 stay off), the card has no speaker link and macaudio's J716
+ * entry refuses one, the AOP audio service gets no speaker DMA channel, and the
+ * amps' shutdown line is held low from boot.
+ */
 &i2c1 {
 	status = "disabled";
 };
 
 &i2c2 {
-	status = "disabled";
+	status = "okay";
+
+	jack_codec: codec@4b {
+		compatible = "cirrus,cs42l84";
+		reg = <0x4b>;
+		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Jack";
+	};
 };
 
 /*
- * Pin 112 takes an SError when read (as on the J716c), so only the pins a node
- * here names are exposed: 80 (PCIe port 0's PERST#).
+ * Pin 112 takes an SError when read (as on the J716c), so only the pins nodes
+ * here name are exposed: 80 (PCIe port 0's PERST#), 107 (the speaker amps'
+ * shutdown line, held low below), 134 and 139 (the jack codec's interrupt and
+ * reset).
  */
