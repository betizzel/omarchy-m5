From b7028feb2f7acdd9e788c38e53a4dab2aedaec18 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Tue, 24 Nov 2026 15:05:03 -0500
Subject: [PATCH] ASoC: apple: t8152-aop-audio: guard sense_ring_done against
 stop race

Clear SenseRing's new active flag (Release) before calling
device_terminate_all() in SenseRing::stop(), and check it (Acquire) both
before and after device_tx_status() in sense_ring_done().

admac_chan_tasklet() drops adchan->lock before invoking the callback,
while admac_terminate_all() clears adchan->current_tx under the same
lock before device_synchronize() kills the tasklet. If sense_ring_done()
called admac_tx_status() in that window, admac_tx_status() returned
DMA_IN_PROGRESS with residue = 0, which sense_ring_done() treated as a
wrap to ring offset 0 and delivered stale tail-of-ring frames (or a
spurious XRUN). Checking active after device_tx_status() pairs through
adchan->lock with the store in stop(), ensuring sense_ring_done() bails
out whenever admac_tx_status() saw the terminated channel.

Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 sound/soc/apple/t8152_aop_audio.rs | 13 +++++++++++++
 1 file changed, 13 insertions(+)

diff --git a/sound/soc/apple/t8152_aop_audio.rs b/sound/soc/apple/t8152_aop_audio.rs
index a586570d67ec3..bc95c387dc54a 100644
--- a/sound/soc/apple/t8152_aop_audio.rs
+++ b/sound/soc/apple/t8152_aop_audio.rs
@@ -303,6 +303,10 @@ struct SenseRing {
     done: AtomicUsize,
     /// When `done` was last moved (or the ring started), CLOCK_MONOTONIC ns.
     done_at: AtomicI64,
+    /// True while a cyclic transfer is active; cleared before terminating the
+    /// channel so `sense_ring_done` never consumes a terminated channel's
+    /// zero-residue status.
+    active: AtomicBool,
     /// The attached sense front-end, or null; cleared under that front-end's
     /// stream lock, which the callback holds while it uses the front-end.
     sub: AtomicPtr<bindings::snd_pcm_substream>,
@@ -323,6 +327,7 @@ impl SenseRing {
             cookie: AtomicI32::new(0),
             done: AtomicUsize::new(0),
             done_at: AtomicI64::new(0),
+            active: AtomicBool::new(false),
             sub: AtomicPtr::new(ptr::null_mut()),
             fe_pos: AtomicUsize::new(0),
             fe_running: AtomicBool::new(false),
@@ -409,6 +414,7 @@ impl SenseRing {
             }
             self.cookie.store(cookie, Ordering::Release);
             if let Some(f) = (*dma).device_issue_pending {
+                self.active.store(true, Ordering::Release);
                 f(chan);
             }
         }
@@ -417,6 +423,7 @@ impl SenseRing {
 
     /// Stops the transfer and waits for its callback; a no-op without a channel.
     fn stop(&self) {
+        self.active.store(false, Ordering::Release);
         let chan = self.chan.load(Ordering::Acquire);
         if chan.is_null() {
             return;
@@ -620,6 +627,9 @@ impl SenseRing {
