+        let period_frames = SENSE_RING_PERIOD_FRAMES as u64;
+
+        assert!(!sense_ring_may_lap(0));
+        assert!(!sense_ring_may_lap(frames_ns(period_frames)));
+        assert!(!sense_ring_may_lap(frames_ns(ring_frames / 2)));
