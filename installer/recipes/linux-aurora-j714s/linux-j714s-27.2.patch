     let now_ns = unsafe { bindings::ktime_get() };
     let ring_bytes = ring.ring_bytes();
From cf330a1c264ce860e3afcab87061ec8b985ce887 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Tue, 24 Nov 2026 15:48:57 -0500
Subject: [PATCH] ASoC: apple: t8152-aop-audio: constrain sense FE buffer size

Require at least one SenseRing period (SENSE_RING_PERIOD_FRAMES) per
ALSA period on the VMALLOC sense front-end, updating periods_max to
match. With periods_min = 2, ALSA negotiation rejects buffers too small
to fit a single ring batch (such as two 60-frame periods), preventing
immediate XRUNs on the first callback, and covers the smallest admitted
buffer in KUnit.

Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 sound/soc/apple/t8152_aop_audio.rs | 56 +++++++++++++++++++++++++-----
 1 file changed, 48 insertions(+), 8 deletions(-)

diff --git a/sound/soc/apple/t8152_aop_audio.rs b/sound/soc/apple/t8152_aop_audio.rs
index bc95c387dc54a..5fdd6e7e917ef 100644
--- a/sound/soc/apple/t8152_aop_audio.rs
+++ b/sound/soc/apple/t8152_aop_audio.rs
@@ -1293,9 +1293,25 @@ unsafe fn sense_ring<'a>(
     data.sense_ring.as_ref()
 }
 
+/// Hardware description for the VMALLOC sense front-end: require at least one
+/// ring period per ALSA period so even the minimum two-period buffer holds
+/// incoming ring batches without XRUNning on the first callback.
+fn sense_pcm_hw(formats: u64, ring_period_bytes: usize) -> bindings::snd_pcm_hardware {
+    let mut hw = pcm_hw();
+    hw.info |= bindings::SNDRV_PCM_INFO_BLOCK_TRANSFER | bindings::SNDRV_PCM_INFO_BATCH;
+    hw.formats = formats;
+    hw.period_bytes_min = hw.period_bytes_min.max(ring_period_bytes);
+    hw.periods_max = (hw.buffer_bytes_max / hw.period_bytes_min) as u32;
+    hw
+}
+
 /// The sense front-end's buffer: plain memory the ring callback copies whole
 /// frames into.
-fn sense_open(substream: *mut bindings::snd_pcm_substream, formats: u64) -> i32 {
+fn sense_open(
+    substream: *mut bindings::snd_pcm_substream,
+    formats: u64,
+    ring_period_bytes: usize,
+) -> i32 {
     // SAFETY: a live substream in its open.
     unsafe {
         if (*substream).dma_buffer.dev.type_ == bindings::SNDRV_DMA_TYPE_UNKNOWN as i32 {
@@ -1310,10 +1326,7 @@ fn sense_open(substream: *mut bindings::snd_pcm_substream, formats: u64) -> i32
                 return ret;
             }
         }
-        let mut hw = pcm_hw();
-        hw.info |= bindings::SNDRV_PCM_INFO_BLOCK_TRANSFER | bindings::SNDRV_PCM_INFO_BATCH;
-        hw.formats = formats;
-        (*(*substream).runtime).hw = hw;
+        (*(*substream).runtime).hw = sense_pcm_hw(formats, ring_period_bytes);
     }
     0
 }
@@ -1344,7 +1357,7 @@ unsafe extern "C" fn asoc_pcm_open(
     };
     if fe == 2 && !playback {
         if let Some(ring) = &data.sense_ring {
-            let ret = sense_open(substream, data.cfg.sense_formats);
+            let ret = sense_open(substream, data.cfg.sense_formats, ring.period_bytes());
             if ret < 0 {
                 return ret;
             }
@@ -2350,8 +2363,35 @@ mod tests {
 
     #[test]
     fn sense_ring_fe_space_guards_overrun() {
-        // Small legal capture buffer (two 12-frame periods) cannot fit one 120-frame ring period
-        assert!(!sense_ring_has_fe_space(24, 0, 0, SENSE_RING_PERIOD_FRAMES));
+        // Every supported multi-amp geometry constrains ALSA negotiation so the
+        // smallest admitted buffer (2 periods of period_bytes_min) exceeds one
+        // 120-frame ring batch and cannot XRUN on an empty capture buffer.
+        for cfg in [&HW_CFG_T8142, &HW_CFG_T8142_6AMP, &HW_CFG_T6050] {
+            let frame = cfg.sense_channels as usize * 2;
+            let ring = SenseRing::new(frame);
+            let hw = sense_pcm_hw(cfg.sense_formats, ring.period_bytes());
+            assert_eq!(hw.period_bytes_min, ring.period_bytes());
+            assert!(hw.period_bytes_min <= hw.period_bytes_max);
+            assert_eq!(hw.periods_min, 2);
+            assert!(hw.periods_min <= hw.periods_max);
+            let min_period_frames = hw.period_bytes_min / frame;
+            let min_buffer_frames = hw.periods_min as usize * min_period_frames;
+            assert_eq!(min_period_frames, SENSE_RING_PERIOD_FRAMES);
+            assert_eq!(min_buffer_frames, 2 * SENSE_RING_PERIOD_FRAMES);
+            assert!(sense_ring_has_fe_space(
+                min_buffer_frames,
+                0,
+                0,
+                SENSE_RING_PERIOD_FRAMES
+            ));
+            assert!(!sense_ring_has_fe_space(
+                min_buffer_frames,
+                SENSE_RING_PERIOD_FRAMES,
+                0,
+                SENSE_RING_PERIOD_FRAMES
+            ));
+        }
+
         // Exact full-buffer advance (e.g. 120 frames into a 120-frame buffer) wraps the
         // modulo pointer back to the same offset, so it must trigger XRUN; strictly less fits.
         assert!(!sense_ring_has_fe_space(120, 0, 0, 120));
From 5f1321879f348f5c636f9b208ee816b29241b6a4 Mon Sep 17 00:00:00 2001
From: Erik Bourget <erik@ebourget.net>
Date: Wed, 25 Nov 2026 17:18:10 -0500
Subject: [PATCH] ASoC: apple: t8152-aop-audio: require verified pw0 before
 rearming sense ring

Do not clear spkr running state or stop SenseRing DMA when a pw0
transition fails in spkr_stop_locked() (except on shutdown, which still
releases DMA resources while keeping running set). On suspend, still
stop and synchronize SenseRing DMA and record resume_run even when pw0
fails, because snd_soc_component_suspend() discards the callback error
and proceeds with sleep.

Track pw0_verified in SpkrState, clear it before every pwrd attempt so
an unconfirmed pwrd failure forces a fresh verified pw0 before rearming,
have resume_with_ring() verify pw0 via ensure_pw0() when running or
unverified before rearming SenseRing, and fail closed in both
resume_with_ring() and start_with_ring() if pw0 still fails so neither
prepare nor resume can arm RX on a running or unverified serializer.

Add KUnit coverage in spkr_state_requires_verified_pw0_before_rearm and
spkr_state_suspend_pw0_failure_and_resume.

Signed-off-by: Erik Bourget <erik@ebourget.net>
---
 sound/soc/apple/t8152_aop_audio.rs | 566 ++++++++++++++++++++++++++---
 1 file changed, 511 insertions(+), 55 deletions(-)

diff --git a/sound/soc/apple/t8152_aop_audio.rs b/sound/soc/apple/t8152_aop_audio.rs
index 5fdd6e7e917ef..4180507b619fb 100644
--- a/sound/soc/apple/t8152_aop_audio.rs
+++ b/sound/soc/apple/t8152_aop_audio.rs
@@ -239,9 +239,126 @@ impl Service {
 struct SpkrState {
     open: bool,
     running: bool,
+    /// True only after `pw0 ` has been verified and before any `pwrd`
+    /// transition attempt. `SenseRing` may only be armed while
+    /// `!running && pw0_verified`.
+    pw0_verified: bool,
     resume_run: bool,
 }
 
+impl SpkrState {
+    const fn new() -> Self {
+        Self {
+            open: false,
+            running: false,
+            pw0_verified: false,
+            resume_run: false,
+        }
+    }
+
+    fn ensure_pw0(
+        &mut self,
+        spkr_running: &AtomicFlag,
+        set_pw0: impl FnOnce() -> Result<()>,
+    ) -> Result<()> {
+        if self.running || (self.open && !self.pw0_verified) {
+            self.pw0_verified = false;
+            set_pw0()?;
+            self.running = false;
+            self.pw0_verified = true;
+            spkr_running.store(false, Relaxed);
+        }
+        Ok(())
+    }
+
+    fn start_with_ring(
+        &mut self,
+        spkr_running: &AtomicFlag,
+        ring_stop: impl Fn(),
+        ring_start: impl FnOnce() -> Result<()>,
+        set_pwrd: impl FnOnce() -> Result<()>,
+    ) -> Result<()> {
+        if self.running || !self.pw0_verified {
+            return Err(EIO);
+        }
+        ring_stop();
+        ring_start()?;
+        self.pw0_verified = false;
+        if let Err(e) = set_pwrd() {
+            ring_stop();
+            return Err(e);
+        }
+        self.running = true;
+        spkr_running.store(true, Relaxed);
+        Ok(())
+    }
+
+    fn stop(
+        &mut self,
+        spkr_running: &AtomicFlag,
+        has_ring: bool,
+        set_pw0: impl FnOnce() -> Result<()>,
+        ring_stop: impl FnOnce(),
+    ) -> Result<()> {
+        self.ensure_pw0(spkr_running, set_pw0)?;
+        if has_ring {
+            ring_stop();
+        }
+        Ok(())
+    }
+
+    fn prepare_with_ring(
+        &mut self,
+        spkr_running: &AtomicFlag,
+        quiesce: impl FnOnce() -> Result<()>,
+        set_pw0: impl FnOnce() -> Result<()>,
+        ring_stop: impl Fn(),
+        ring_start: impl FnOnce() -> Result<()>,
+        set_pwrd: impl FnOnce() -> Result<()>,
+    ) -> Result<()> {
+        if self.running || !self.pw0_verified {
+            quiesce()?;
+            self.pw0_verified = false;
+            set_pw0()?;
+            self.running = false;
+            self.pw0_verified = true;
+            spkr_running.store(false, Relaxed);
