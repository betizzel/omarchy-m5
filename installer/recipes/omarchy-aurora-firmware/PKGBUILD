pkgname=omarchy-aurora-firmware
pkgver=20261014.j714s9
pkgrel=1
pkgdesc='Order Apple peripheral admission after device firmware extraction'
arch=('aarch64')
groups=('omarchy-platform-apple-silicon')
license=('MIT' 'GPL-2.0-only' 'BSD-3-Clause')
backup=('etc/mkinitcpio.conf.d/95-aurora-vendor-order.conf' 'etc/sddm.conf.d/60-aurora-m5-display.conf')
makedepends=('git' 'clang' 'lld' 'llvm')
url='https://github.com/aurora-silicon/omarchy-mac'
source=(aurora-firmware-order.conf aurora-peripheral-firmware.sh
        aurora-peripheral-firmware.service aurora-vendor-order.install
        95-aurora-vendor-order.conf aurora-vendor-order-cryptsetup.conf
        20-aurora-vendor-order.conf aurora-regdom-fallback
        aurora-regdom-fallback.service 86-aurora-regdom-fallback.rules
        # J714 microphones: edimoldovan/omarchy-mac-pkgs j714-speaker-route-volume 0a00f7a88711
        j714-mic.json wireplumber-j714-mic.conf
        # N1 6 GHz: edimoldovan/omarchy-mac-pkgs iwd-6ghz-bcm4388-only 702a6ec363
        iwd-n1-main.conf 30-aurora-n1-6ghz.conf
        # RT uclamp: edimoldovan/omarchy-mac-pkgs rt-uclamp 74d8f8bbef
        90-aurora-rt-uclamp.conf
        # DCP two-card Hyprland session (rolotrealanis98's J716s daily session)
        aurora-m5-display-env start-hyprland-m5 60-aurora-m5-display.conf
        # J714 UCM: aurora-silicon/alsa-ucm-conf-asahi #10 (edimoldovan, merged, 401a49d4f7ee); busy-card discovery: kazuhidet
        ucm-macaudio-j714.conf ucm-macaudio-hifi-j714.conf ucm-aop-j714.conf wireplumber-81-aurora-busy-discovery.conf
        # J714s: speakerguardd v2 at boot once it qualifies, the panel's VRR range, the camera's tuning
        70-aurora-speaker-upgrade-auto.conf aurora-m5-vrr.conf aurora-j714s-camera-setfile aurora-j714s-camera-setfile.service
        # The video decoder's v5-t2 firmware (MIT), built from source; avd-fw 0.1 has up to v5-t1
        "avd-fw::git+https://github.com/aurora-silicon/avd-fw.git#commit=ea3a65cc9c0c41907e6ad2714b813e4be6858485"
        # liblzfse (BSD-3-Clause), for apfs_ro: macOS keeps many System files LZFSE-compressed; not in Arch Linux ARM
        "lzfse::git+https://github.com/lzfse/lzfse.git#commit=e634ca58b4821d9f3d560cdc6df5dec02ffc93fd")
sha256sums=('e2d6d6008bfde44ba871da2fcaae22b409d52ea8695fcf672bc3b06d786f823e'
