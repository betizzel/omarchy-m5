From 643302f57c3af654d3d64ce878859729b07cd96d Mon Sep 17 00:00:00 2001
From: TripleU <182648541+TripleU613@users.noreply.github.com>
Date: Wed, 11 Nov 2026 17:02:15 -0500
Subject: [PATCH 1/7] kboot: T6050: hand the GPU and the internal display over
 on 27.3 beta 1

The J714s needs the macOS 27.3 beta 1 stub (26C5035r, mBoot-20457.60.65.0.1) to boot all of
its cores with a raw Stage 1, and the T6050 GPU and DCP handoffs only accepted 27.0 (GPU also
26B8125 since #187).

- GPU: add the J714s's 27.2 (26B123) and 27.3 beta 1 (26C5035r) G17S builds to #187's build
  table: per build the boot-filled ranges and the TEXT digest Linux's hw/t6050.rs identifies,
  from aurora-silicon/linux #1173 (Rolando Trevino, rolotrealanis98).
- DCP: accept 27.3 beta 1 (V27_3B, #216) beside 27.0, take its DCP image as the ADT names it
  (27.0 stays pinned), and publish apple,firmware-compat <27 3 0>, the key aurora-silicon/linux
  #1174 chooses its 27.3 method table and swap layout by. dcpext engines must run the internal
  display's image. The compat idea follows TripleU613's J714s m1n1 (0004; betizzel, FatBoy721).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kboot_display_handoff.c | 32 +++++++++++++++++---------
 src/kboot_gpu.c             | 45 ++++++++++++++++++++++++++++++-------
 2 files changed, 59 insertions(+), 18 deletions(-)

diff --git a/src/kboot_display_handoff.c b/src/kboot_display_handoff.c
index ad3edb2a..1ce1df49 100644
--- a/src/kboot_display_handoff.c
+++ b/src/kboot_display_handoff.c
@@ -3235,7 +3235,11 @@ static bool dcp6_dt_describes(void *dt)
  * iBoot leaves the DCP running and both of its DARTs locked on four-level roots. The kernel adopts
  * that session and resolves firmware DVAs through the live tables, so this publishes no
  * iommu-addresses: only what the ADT says, checked against the device tree and the registers.
- * The image is pinned because 27.0 and 27.0.1 report the same iBoot version.
+ * The 27.0 image is pinned because 27.0 and 27.0.1 report the same iBoot version. The 27.3 beta 1
+ * stub (26C5035r, the first that boots all of the M5 Pro's cores) is one iBoot version; its image
+ * is taken as the ADT names it, and published with apple,firmware-compat <27 3 0>, the key Linux's
+ * firmware-27 DCP driver chooses its 27.3 method table and swap layout by (aurora-silicon/linux
+ * #1174). As TripleU613's m1n1 for the J714s does (betizzel's 27.3 handoff).
  */
 #define T6050_DCP_UUID  "64863924-B56B-3E32-87FE-038677F52709"
 #define T6050_NDISP     5       /* disp0 reg[0..4] are the dcp's disp-0..disp-4 */
@@ -3259,8 +3263,12 @@ static struct {
     u64 coproc, pmc, pmc_size, vram, vram_size;
     u32 bw_offset, nits, nclk, clk_id[T6050_CLOCKS], clk_hz[T6050_CLOCKS], pmc_ph;
     const char *gamut;
+    char uuid[40];
+    const struct fw_version_info *compat;
 } t6050;
 
+static const struct fw_version_info t6050_compat_27_3 = {V27_3B, "27.3", {27, 3, 0}, 3, "compat"};
+
 /* The dcp's reg entries and the ADT reg each equals (coproc: a prefix of it) */
 static const struct {
     char name[10];
@@ -3313,10 +3321,14 @@ static T6050_INIT int t6050_check_adt(void)
     int disp0 = adt_path_offset(adt, "/arm-io/disp0");
     const char *uuid = nub < 0 ? NULL : adt_getprop(adt, nub, "uuid", &len);
 
-    if (os_firmware.version != V27_0)
-        bail("OS firmware %s is not 27.0\n", os_firmware.string);
-    if (!dcp6_is_uuid(uuid, len) || strcmp(uuid, T6050_DCP_UUID))
+    if (os_firmware.version != V27_0 && os_firmware.version != V27_3B)
+        bail("OS firmware %s is not 27.0 or 27.3 beta 1\n", os_firmware.string);
+    t6050.compat = os_firmware.version == V27_3B ? &t6050_compat_27_3 : &os_firmware;
+    if (!dcp6_is_uuid(uuid, len) || len > sizeof(t6050.uuid) ||
+        (os_firmware.version == V27_0 && strcmp(uuid, T6050_DCP_UUID)))
         bail("DCP image %s is not " T6050_DCP_UUID "\n", dcp6_is_uuid(uuid, len) ? uuid : "(none)");
+    strcpy(t6050.uuid, uuid);
+    dlog("DCP image %s, firmware-compat %s\n", t6050.uuid, t6050.compat->string);
     if (dcp6_adt_u32(nub, "running", &val) || val != 1 || disp0 < 0 ||
         adt_getprop(adt, disp0, "external", NULL))
         bail("the DCP is not running an internal panel\n");
@@ -3493,8 +3505,8 @@ static T6050_TEXT int t6050_publish(void *dt)
     if (firmware_set_fdt(dt, kboot_fdt_path_exact(dt, t6050.path[T6050_DCP]),
                          "apple,firmware-version", &os_firmware) ||
         firmware_set_fdt(dt, kboot_fdt_path_exact(dt, t6050.path[T6050_DCP]),
-                         "apple,firmware-compat", &os_firmware) ||
-        t6050_setprop(dt, T6050_DCP, "apple,firmware-uuid", T6050_DCP_UUID, sizeof(T6050_DCP_UUID)))
+                         "apple,firmware-compat", t6050.compat) ||
+        t6050_setprop(dt, T6050_DCP, "apple,firmware-uuid", t6050.uuid, strlen(t6050.uuid) + 1))
         return -1;
 
     /* The bandwidth scratch, in the PMC metadata (disp0 reg[4]), as register window 5 */
@@ -3574,7 +3586,7 @@ static T6050_TEXT int t6050_ext_one(void *dt, int n)
     snprintf(a, sizeof(a), "/arm-io/dcpext%d/iop-dcpext%d-nub", n, n);
     int nub = adt_path_offset(adt, a);
     const char *uuid = nub < 0 ? NULL : adt_getprop(adt, nub, "uuid", &len);
-    if (!dcp6_is_uuid(uuid, len) || strcmp(uuid, T6050_DCP_UUID) ||
+    if (!dcp6_is_uuid(uuid, len) || strcmp(uuid, t6050.uuid) ||
         dcp6_adt_u32(nub, "running", &val) || val != 1)
         bail("dcpext%d: not running the pinned image\n", n);
     snprintf(a, sizeof(a), "/arm-io/dcpext%d", n);
@@ -3672,9 +3684,9 @@ static T6050_TEXT int t6050_ext_one(void *dt, int n)
     if (firmware_set_fdt(dt, kboot_fdt_path_exact(dt, path[0]), "apple,firmware-version",
                          &os_firmware) ||
         firmware_set_fdt(dt, kboot_fdt_path_exact(dt, path[0]), "apple,firmware-compat",
-                         &os_firmware) ||
-        fdt_setprop(dt, kboot_fdt_path_exact(dt, path[0]), "apple,firmware-uuid", T6050_DCP_UUID,
-                    sizeof(T6050_DCP_UUID)) ||
+                         t6050.compat) ||
+        fdt_setprop(dt, kboot_fdt_path_exact(dt, path[0]), "apple,firmware-uuid", t6050.uuid,
+                    strlen(t6050.uuid) + 1) ||
         fdt_setprop(dt, kboot_fdt_path_exact(dt, path[0]), "apple,bw-scratch", v, sizeof(v)))
         return -1;
     if (output && fdt_appendprop(dt, kboot_fdt_path_exact(dt, t6050.path[T6050_DISP]), "iommus",
diff --git a/src/kboot_gpu.c b/src/kboot_gpu.c
index 99f172fa..19572731 100644
--- a/src/kboot_gpu.c
+++ b/src/kboot_gpu.c
@@ -3994,12 +3994,12 @@ disable:
 }
 
 /*
- * T6050 G17S (M5 Pro: J714s on the 27.0 firmware, K116s on 27.2). iBoot loads both roles' __TEXT
- * back to back, their __DATA and __DATA_SHARED_RO in one run, and leaves the UAT ranges empty:
- * each role publishes its kernel root while it boots. Linux's driver takes the four UAT ranges,
- * fw-text and fw-data as no-map reservations, and admits only a build whose TEXT normalizes to
- * that build's digest (its fwid rule: the build's boot-filled ranges, the entropy records among
- * them, zeroed; Linux also checks the records' tags).
+ * T6050 G17S (M5 Pro: J714s on the 27.0, 27.2 and 27.3 beta 1 firmware, K116s on 27.2). iBoot
+ * loads both roles' __TEXT back to back, their __DATA and __DATA_SHARED_RO in one run, and leaves
+ * the UAT ranges empty: each role publishes its kernel root while it boots. Linux's driver takes
+ * the four UAT ranges, fw-text and fw-data as no-map reservations, and admits only a build whose
+ * TEXT normalizes to that build's digest (its fwid rule: the build's boot-filled ranges, the
+ * entropy records among them, zeroed; Linux also checks the records' tags).
  *
  * When the device tree describes the GPU (alias "gpu", apple,agx-g17s, disabled), check the ADT
  * and this build, then fill the reservations and enable the GPU power states, both mailboxes and
@@ -4018,7 +4018,7 @@ static const struct {
         u32 fill[8][2];
         u8 sha[32];
         char name[8];
-    } build[2];
+    } build[4];
 } t6050_gpu = {
     /* The UAT ranges (base, size), then the bounds of both roles' __DATA and SRO */
     {"gpu-region-base", "gpu-region-size", "gfx-shared-region-base", "gfx-shared-region-size",
@@ -4061,7 +4061,36 @@ static const struct {
       {0xaf, 0x68, 0xd0, 0x34, 0xa3, 0xf0, 0x06, 0xb4, 0x3d, 0xab, 0x66,
        0x1b, 0x82, 0x5f, 0x12, 0x59, 0x8c, 0xb8, 0x6e, 0x4d, 0x2a, 0x0e,
        0x38, 0x44, 0xf1, 0x4f, 0xa5, 0x05, 0x9f, 0x38, 0xf6, 0xcb},
-      "26B8125"}},
+      "26B8125"},
+     /*
+      * 26B123 (27.2) G17S, the J714s restore image: 26B8125's record offsets, its own digest.
+      * 27.2 and 27.3 beta 1 from aurora-silicon/linux #1173 (Rolando Trevino).
+      */
+     {{{0x224, 4},
+       {0x23c, 8},
+       {0x49764, 0x740},
+       {0x49ea4, 0x231},
+       {0x50224, 4},
+       {0x5023c, 8},
+       {0x9d1ec, 0x740},
+       {0x9d92c, 0x231}},
+      {0x2b, 0x46, 0x13, 0xc6, 0x2a, 0x8a, 0x00, 0x7f, 0x22, 0xa9, 0x41,
+       0x01, 0x70, 0x2c, 0x9a, 0xc6, 0xc4, 0xe9, 0x0f, 0x2e, 0x12, 0x3f,
+       0x3b, 0x36, 0xfb, 0xe6, 0xff, 0xea, 0x91, 0x3f, 0x0f, 0xd9},
+      "26B123"},
+     /* 26C5035r (27.3 beta 1) G17S, J714s */
+     {{{0x224, 4},
+       {0x23c, 8},
+       {0x4976c, 0x740},
+       {0x49eac, 0x231},
+       {0x50224, 4},
+       {0x5023c, 8},
+       {0x9d1ec, 0x740},
+       {0x9d92c, 0x231}},
+      {0xb5, 0x53, 0x7c, 0x8f, 0x06, 0xbd, 0x19, 0xeb, 0xf0, 0xef, 0xd0,
+       0xcb, 0xfb, 0x65, 0x52, 0x33, 0x9a, 0x10, 0xd4, 0xaf, 0xc4, 0xed,
+       0xa9, 0xd2, 0x1c, 0xbe, 0xdc, 0x36, 0x66, 0x76, 0x36, 0x00},
+      "26C5035"}},
 };
