			opp-level = <9>;
			opp-microvolt = <980000>;
			clock-latency-ns = <8000>;
		};
		opp10 {
			opp-hz = /bits/ 64 <3696000000>;
			opp-level = <10>;
			opp-microvolt = <1000000>;
			clock-latency-ns = <8000>;
		};
		opp11 {
			opp-hz = /bits/ 64 <3876000000>;
			opp-level = <11>;
			opp-microvolt = <1020000>;
			clock-latency-ns = <8000>;
		};
		opp12 {
			opp-hz = /bits/ 64 <4044000000>;
			opp-level = <12>;
			opp-microvolt = <1040000>;
			clock-latency-ns = <8000>;
		};
		opp13 {
