			opp-level = <6>;
			opp-microvolt = <890000>;
			clock-latency-ns = <8000>;
		};
		opp07 {
			opp-hz = /bits/ 64 <2964000000>;
			opp-level = <7>;
			opp-microvolt = <925000>;
			clock-latency-ns = <8000>;
		};
		opp08 {
			opp-hz = /bits/ 64 <3240000000>;
			opp-level = <8>;
