		};
	};

	m1_opp: opp-table-m1 {
		compatible = "operating-points-v2";

		opp02 {
			opp-hz = /bits/ 64 <1344000000>;
			opp-level = <2>;
			opp-microvolt = <765000>;
			clock-latency-ns = <8000>;
		};
		opp03 {
