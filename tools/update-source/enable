#!/bin/bash
# Turn on the [omarchy-m5] package repository on a J714s installed from this repo's images.
#
# After this, `omarchy update` installs our tested builds of the J714s boot and graphics packages
# (linux-aurora, omarchy-aurora-firmware, m1n1-aurora, hyprland-m5, mesa-aurora, vulkan-aurora) from
# https://github.com/betizzel/omarchy-m5/releases/tag/repo-aarch64, signed with key
# E86FAF980FDC450871B7EA99FCA533429F69AE22.
#
# How it stays safe:
# - The repository is listed above [omarchy]. pacman takes a package from the first repository
#   that has it, so omacom's generic builds of these can't replace ours; that's why they
#   can leave IgnorePkg. Every other pin from the image stays.
# - Packages and the database must be signed by that key (SigLevel = Required); the key's
#   fingerprint is checked before it is trusted.
# - `omarchy refresh pacman` rewrites /etc/pacman.conf; this script installs itself as an Omarchy
#   pre-refresh-pacman hook, which puts the repository line and the pins back each time.
#
# Usage: tools/update-source/enable          (asks for sudo; or run it with sudo)
#        tools/update-source/enable --hook   (what the refresh hook runs: only fix pacman.conf)
#        tools/update-source/enable --disable
set -euo pipefail

FPR=E86FAF980FDC450871B7EA99FCA533429F69AE22
BASE=https://github.com/betizzel/omarchy-m5/releases/download/repo-aarch64
SNIPPET=/etc/pacman.d/omarchy-m5.conf
CONF=/etc/pacman.conf
MARKER="Include = $SNIPPET"
SERVED=(linux-aurora omarchy-aurora-firmware m1n1-aurora hyprland-m5 mesa-aurora vulkan-aurora)
# The image's other pins (release 10's pacman.conf minus SERVED).
PINNED=(aurora-sep aurora-speaker-upgrade libfprint-aurora omarchy omarchy-mac omarchy-mac-boot omarchy-settings speakerguardd-v2 uboot-aurora)

if [[ $EUID -eq 0 ]]; then SUDO=(); user=${SUDO_USER:-root}; else SUDO=(sudo); user=$USER; fi
home=$(getent passwd "$user" | cut -d: -f6)
hook=$home/.config/omarchy/hooks/pre-refresh-pacman.d/omarchy-m5

fix_conf() {
  local tmp current word keep=()
  tmp=$(mktemp)
  # The repository above [omarchy], once.
  if ! grep -qxF "$MARKER" "$CONF"; then
    grep -q '^\[omarchy\]' "$CONF" || { echo "No [omarchy] section in $CONF" >&2; return 1; }
    sed "0,/^\[omarchy\]/s||$MARKER\n\n[omarchy]|" "$CONF" >"$tmp"
  else
    cat "$CONF" >"$tmp"
  fi
  # IgnorePkg: what is there plus PINNED, minus SERVED, on one line under [options].
  current=$(sed -n 's/^IgnorePkg[[:space:]]*=//p' "$tmp" | tr -s ' \t' '\n\n' | sed '/^$/d')
  for word in $current "${PINNED[@]}"; do
    [[ " ${SERVED[*]} " == *" $word "* ]] && continue
    [[ " ${keep[*]} " == *" $word "* ]] && continue
    keep+=("$word")
  done
  sed -i '/^IgnorePkg[[:space:]]*=/d' "$tmp"
  sed -i "0,/^\[options\]/s||[options]\nIgnorePkg = ${keep[*]}|" "$tmp"
  if ! cmp -s "$tmp" "$CONF"; then
    "${SUDO[@]}" cp -f "$CONF" "$CONF.before-omarchy-m5"
    "${SUDO[@]}" install -m644 "$tmp" "$CONF"
  fi
  rm -f "$tmp"
}

if [[ ${1:-} == --hook ]]; then
  [[ -r $SNIPPET ]] || exit 0
  fix_conf
  exit 0
fi

if [[ ${1:-} == --disable ]]; then
  "${SUDO[@]}" sed -i "\|^$MARKER\$|d" "$CONF"
  "${SUDO[@]}" rm -f "$SNIPPET"
  rm -f "$hook"
  # Pin the served packages again, as the images ship them.
  tmp=$(mktemp)
  current=$(sed -n 's/^IgnorePkg[[:space:]]*=//p' "$CONF")
  sed -e '/^IgnorePkg[[:space:]]*=/d' -e "0,/^\[options\]/s||[options]\nIgnorePkg = $current ${SERVED[*]}|" "$CONF" >"$tmp"
  "${SUDO[@]}" install -m644 "$tmp" "$CONF"; rm -f "$tmp"
  echo "[omarchy-m5] is off; its packages are pinned again."
  exit 0
fi

key=$(mktemp)
trap 'rm -f "$key"' EXIT
curl -fsSL "$BASE/omarchy-m5-repo.asc" -o "$key"
got=$(gpg --show-keys --with-colons "$key" 2>/dev/null | awk -F: '/^fpr/ {print $10; exit}')
if [[ $got != "$FPR" ]]; then
  echo "The downloaded key is $got, not $FPR. Nothing changed." >&2
  exit 1
fi
"${SUDO[@]}" pacman-key --add "$key" >/dev/null
"${SUDO[@]}" pacman-key --lsign-key "$FPR" >/dev/null
printf '[omarchy-m5]\nSigLevel = Required\nServer = %s\n' "$BASE" | "${SUDO[@]}" tee "$SNIPPET" >/dev/null
fix_conf

# The refresh hook: this script, run with --hook.
install -Dm755 "$0" "$hook.script"
printf '#!/bin/bash\nexec "%s" --hook\n' "$hook.script" >"$hook"
chmod 755 "$hook"
[[ $EUID -eq 0 && $user != root ]] && chown -R "$user:" "$home/.config/omarchy/hooks/pre-refresh-pacman.d"

"${SUDO[@]}" env OMARCHY_ALLOW_DIRECT_PACMAN=1 pacman -Sy >/dev/null
echo "[omarchy-m5] is on. Packages it serves:"
pacman -Sl omarchy-m5
echo "Run 'omarchy update' to install anything newer."
