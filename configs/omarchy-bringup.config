# omarchy-m5 bring-up kernel fragment
#
# Merged on top of arm64 defconfig + arch/arm64/configs/asahi.config.
#
# Everything the console path needs MUST be built in, not a module: the
# bring-up initramfs is a plain Alpine rootfs with no kernel modules in it,
# so anything =m simply never loads. This is exactly how the first tethered
# boot came out silent — DRM was =m and DRM_SIMPLEDRM was unset, so nothing
# ever bound m1n1's simple-framebuffer and console=tty0 had no device.

# --- framebuffer console (the only console that needs no cable) ----------
CONFIG_DRM=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FB=y
CONFIG_FB_CORE=y
CONFIG_FRAMEBUFFER_CONSOLE=y
# NB: CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY cannot be turned off here -
# DRM_CLIENT_SELECTION selects it whenever FRAMEBUFFER_CONSOLE is on, and
# olddefconfig puts it straight back. It is harmless on arm64:
# fbcon_select_primary() only latches a primary device when
# video_is_primary_device() agrees (a PCI VGA notion), otherwise fbcon uses
# the first framebuffer registered.
CONFIG_VT=y
CONFIG_VT_CONSOLE=y

# --- Apple s5l UART, for when the debug cable is attached ----------------
CONFIG_SERIAL_SAMSUNG=y
CONFIG_SERIAL_SAMSUNG_CONSOLE=y
CONFIG_SERIAL_EARLYCON=y

# --- initramfs boot ------------------------------------------------------
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- keep early failures loud -------------------------------------------
CONFIG_PRINTK=y
CONFIG_EARLY_PRINTK=y
CONFIG_PANIC_TIMEOUT=0

# --- early-boot checkpoint markers --------------------------------------
# The panel is the only output channel without a debug cable, and fbcon
# comes up far too late to describe early boot. These paint bands directly
# into m1n1's framebuffer; see <asm/omarchy_fbmarker.h> for the layout.
# BASE/STRIDE/HEIGHT come from m1n1's "fb init:" line and are
# machine-specific. The same geometry feeds `earlycon=efifb`, which prints
# the kernel log on the panel below the bands from parse_early_param() on.
CONFIG_OMARCHY_FB_MARKERS=y
CONFIG_OMARCHY_FB_MARKER_BASE=0x10bd3110000
CONFIG_OMARCHY_FB_MARKER_STRIDE=0x2f40
CONFIG_OMARCHY_FB_MARKER_HEIGHT=1964
CONFIG_EFI_EARLYCON=y
# 8x16 is ~1.6 mm tall on this panel; get_default_font() prefers 16x32 here.
CONFIG_FONTS=y
CONFIG_FONT_8x16=y
CONFIG_FONT_TER16x32=y

# --- no Rust for bring-up ------------------------------------------------
# asahi.config enables CONFIG_RUST (for DRM_APPLE, the DCP driver), which
# requires a matching bindgen on the build host. Nothing on the path to a
# first console needs it: simpledrm is C, and the DCP display driver is
# irrelevant while m1n1 hands us an already-initialized framebuffer.
# CONFIG_RUST is not set

# --- built-in keyboard/trackpad: MTP coprocessor + DockChannel HID ----------
# asahi.config has these =m; the initramfs has no modules. Probe order is
# deferred-probe driven (hid -> rtkit-helper -> mailbox + apple-dart).
CONFIG_APPLE_DART=y
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_RTKIT_HELPER=y
CONFIG_APPLE_DOCKCHANNEL=y
CONFIG_HID_DOCKCHANNEL=y
CONFIG_HID_APPLE=y
CONFIG_HID_MAGICMOUSE=y
CONFIG_HID_GENERIC=y
CONFIG_HIDRAW=y
# A missing trackpad blob would otherwise stall the first open() of its
# evdev node for the 60 s sysfs-fallback timeout.
# CONFIG_FW_LOADER_USER_HELPER is not set
# --- CPU DVFS: the boot cluster comes up at 2.65 GHz (iBoot state 6);
# dt/t6050-cpufreq.dtsi + this driver scale it 1.34-4.31 GHz. Built in:
# the rootfs carries no kernel modules. ---
CONFIG_ARM_APPLE_SOC_CPUFREQ=y
# --- SoC watchdog, built in: its restart handler is how `reboot` resets the
# M5 (back into stage-1 m1n1, ready for the next tethered boot). ---
CONFIG_APPLE_WATCHDOG=y
