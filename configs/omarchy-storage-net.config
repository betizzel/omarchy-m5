# omarchy-m5: storage (ANS NVMe) + USB gadget networking.
# Merge AFTER omarchy-bringup.config. Everything is =y: the bring-up
# initramfs carries no modules.

# --- ANS NVMe: RTKit mailbox (already =y) + SART + NVMe host ------------
CONFIG_APPLE_MAILBOX=y
CONFIG_APPLE_RTKIT=y
CONFIG_APPLE_SART=y
CONFIG_NVME_CORE=y
CONFIG_NVME_APPLE=y
CONFIG_BLK_DEV_NVME=m
CONFIG_EFI_PARTITION=y
CONFIG_EXT4_FS=y

# --- DART (USB DMA goes through dart-usbN; NVMe uses SART, not DART) ----
CONFIG_APPLE_DART=y
CONFIG_IOMMU_IO_PGTABLE_DART=y

# --- USB: plain snps,dwc3 in peripheral mode (no Apple glue / atcphy) ---
CONFIG_USB=y
CONFIG_USB_GADGET=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_DUAL_ROLE=y
# CONFIG_USB_DWC3_APPLE is not set
CONFIG_USB_LIBCOMPOSITE=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_ECM=y
CONFIG_USB_CONFIGFS_ACM=y
CONFIG_CONFIGFS_FS=y
# --- tracing: usb-gadget-net prints the dwc3 tracepoints (setup packets,
# endpoint commands + status, events) to the panel when the host never
# configures the gadget ---
CONFIG_FTRACE=y
CONFIG_ENABLE_DEFAULT_TRACERS=y
