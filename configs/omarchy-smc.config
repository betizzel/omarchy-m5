# omarchy-m5: Apple SMC (core, RTC, lid/power-button input, GPIO, hwmon,
# battery) plus the SPMI PMIC NVMEM they need. asahi.config builds these
# =m and the rootfs has no modules, so they must be =y.
#
# Battery/charger (macsmc-power): the M5 firmware has BCF0 as 4 bytes (the
# driver's pre-27 path), CHTE (written 0 = charging allowed, already 0) and
# CHLS (charge limit); CH0C/CH0I/CH0K/CH0B are absent and skipped/rejected.
# Its critical-battery shutdown fires on BCF0 != 0 or B0AV < BITV (0, and
# 13.0 V vs 9.0 V on the stage-0 probe).
#
# Deliberately NOT built in yet (left =m, i.e. never loaded):
#   CONFIG_POWER_RESET_MACSMC SMC restart/poweroff: outranks the watchdog
#                             restart that remote reboots rely on, and it is
#                             unverified that an SMC restart lands in m1n1.
CONFIG_MFD_MACSMC=y
CONFIG_RTC_DRV_MACSMC=y
CONFIG_INPUT_MACSMC_INPUT=y
CONFIG_GPIO_MACSMC=y
CONFIG_SENSORS_MACSMC_HWMON=y
# CONFIG_MACSMC_POWER (battery) is not built in: it panicked the M5 at boot
# (2026-10-02, cause not yet read off the panel). Off until diagnosed.
CONFIG_SPMI_APPLE=y
CONFIG_NVMEM_APPLE_SPMI=y
