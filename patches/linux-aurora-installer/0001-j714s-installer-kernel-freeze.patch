+	 * each 0x4000 in the ADT; one resource for their union. Interrupt 1373, clock id 440
+	 * (/arm-io clock-frequencies[184], 405 MHz). spi-apple-qspi's T8140 policy: data
+	 * reads anywhere, programs and erases only inside the nvram partition.
+	 */
+	qspi: spi@505118000 {
+		compatible = "apple,t6050-qspi", "apple,t8140-qspi";
+		reg = <0x5 0x05118000 0x0 0x4800>;
+		clocks = <&clk_405m>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 0 1373 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&ps_qspi>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		status = "disabled";
+	};
+
+	/* The ASC v4 mailbox at the AOP ASC + 0x8000; ADT interrupts 578..581 in mailbox order */
+	aop_mbox: mailbox@290608000 {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x2 0x90608000 0x0 0x4000>;
+		interrupts = <AIC_IRQ 0 578 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 579 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 580 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 581 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+		status = "disabled";
+	};
+
+	/*
+	 * dart-aop: streams 0 (AOP), 3, 8 (admac-base-ns), 10 and 16 are the AP's; 1, 9 and 11 are
+	 * exclave streams. iBoot leaves its tables locked on the ADT's l1-tt roots: each consumer
+	 * binds one stream and the locked-DART path publishes into its free slots.
+	 */
+	aop_dart: iommu@290fc0000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0x90fc0000 0x0 0xc000>;
+		#iommu-cells = <1>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 0 616 IRQ_TYPE_LEVEL_HIGH>;
+		status = "disabled";
+	};
+
+	/* ADT admac-base-ns: 13 TX and 13 RX channels; the AOP firmware owns its fabric */
+	admac_base_ns: dma-controller@293800000 {
+		compatible = "apple,t6050-admac", "apple,t8140-admac";
+		reg = <0x2 0x93800000 0x0 0x34000>;
+		dma-channels = <13>;
+		interrupts-extended = <&aic AIC_IRQ 0 637 IRQ_TYPE_LEVEL_HIGH>,
+				      <0>, <0>, <0>;
+		#dma-cells = <1>;
+		iommus = <&aop_dart 8>;
+		apple,dma-range = <0x110 0x00000000 0x0 0x10000000>;
+		status = "disabled";
+	};
+
+	/*
+	 * The AOP: its SRAM window (ADT reg[2]) and its ASC (reg[0]). Its firmware is loaded and
+	 * left halted by iBoot. Booted as on T8152, over the RTKit mailbox alone: the ADT's
+	 * aop-exclave-mailbox (the setup port T8140 and T8142 boot through) is exclave-assigned
+	 * here and takes an SError from the AP.
+	 */
+	aop: aop@290c00000 {
+		compatible = "apple,t6050-aop", "apple,t8152-aop";
+		reg = <0x2 0x90c00000 0x0 0x1e0000>,
+		      <0x2 0x90600000 0x0 0x4000>;
+		reg-names = "mmio", "asc";
+		mboxes = <&aop_mbox>;
+		mbox-names = "mbox";
+		iommus = <&aop_dart 0>;
+		apple,dma-range = <0x110 0x0 0x10 0x0>;
+		status = "disabled";
+
+		/*
+		 * ADT iop-audio-controller: cout/cin (the jack) on base-ns TX2/RX2, spkr on TX0 with
+		 * the amp's V/I sense on RX0 (Linux channel 2N for TX N, 2N+1 for RX N).
+		 */
+		aop_audio: audio {
+			compatible = "apple,t6050-aop-audio";
+			dmas = <&admac_base_ns 4>, <&admac_base_ns 5>,
+			       <&admac_base_ns 0>, <&admac_base_ns 1>;
+			dma-names = "cout", "cin", "spkr", "sense";
+			#sound-dai-cells = <1>;
+		};
+	};
+};
+
+/*
+ * The Type-C chains of ATC2 and ATC3 and the routers' shared AUSS, all disabled where the board
+ * or the display handoff enables them (ATC2's: what dcpext0 references, its PHY's mailbox and
+ * power domains). Addresses from the ADT (arm-io ranges +0x200000000).
+ */
+&pmgr0 {
+	ps_atc2_common: power-controller@238 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x238 4>;
+		label = "atc2_common";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		status = "disabled";
+	};
+
+	/* ATC3_COMMON, ADT gate 62. Its parent FAB5_SOC (+0x1f0) is critical: always on. */
+	ps_atc3_common: power-controller@240 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x240 4>;
+		label = "atc3_common";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+	};
+
+	/*
+	 * AUSS, ADT gate 63 (+0x248), parent FAB5_SOC: the shared parent of die 0's
+	 * router CIO_AUSS domains. Its other users are not described, so Linux never
+	 * turns it off under them.
+	 */
+	ps_auss: power-controller@248 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x248 4>;
+		label = "auss";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		apple,always-on;
+		status = "disabled";
+	};
+
+	/*
+	 * ATC3's USB4 router (/arm-io/acio3 power-gates [122, 85, 120, 121]):
+	 * ATC3_CIO gate 85 (+0x2f8, parent 62), ATC3_CIO_PCIE 120 (+0x410) and ATC3_CIO_USB
+	 * 121 (+0x418, parent 85), ATC3_CIO_AUSS 122 (+0x420, parents 85 and 63). Its
+	 * clock-gate 604, CIO3_RECONFIG_V, has no power state: it is cio_reconfig0's reset 3.
+	 */
+	ps_atc3_cio: power-controller@2f8 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x2f8 4>;
+		label = "atc3_cio";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc3_common>;
+		status = "disabled";
+	};
+
+	ps_atc3_cio_pcie: power-controller@410 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x410 4>;
+		label = "atc3_cio_pcie";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc3_cio>;
+		status = "disabled";
+	};
+
+	ps_atc3_cio_usb: power-controller@418 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x418 4>;
+		label = "atc3_cio_usb";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc3_cio>;
+		status = "disabled";
+	};
+
+	ps_atc3_cio_auss: power-controller@420 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x420 4>;
+		label = "atc3_cio_auss";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc3_cio>, <&ps_auss>;
+		status = "disabled";
+	};
+};
+
+&pmgr1 {
+	ps_i2c1: power-controller@2c8 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x2c8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "i2c1";
+	};
+
+	ps_i2c2: power-controller@2d0 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x2d0 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "i2c2";
+	};
+
+	/*
+	 * The boot NOR's controller: ADT pmgr devices SPI_P (id 199, +0x308) and
+	 * QSPI (id 208, +0x350, /arm-io/qspi clock-gates), group 1. SPI_P's parent
+	 * SIO (184) is left undescribed, as for the I2C states above.
+	 */
+	ps_spi_p: power-controller@308 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x308 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "spi_p";
+	};
+
+	ps_qspi: power-controller@350 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x350 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "qspi";
+		power-domains = <&ps_spi_p>;
+	};
+};
+
+&pmgr2 {
+	ps_atc2_usb_aon: power-controller@178 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x178 4>;
+		label = "atc2_usb_aon";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		status = "disabled";
+	};
+
+	ps_atc2_phymxwrap: power-controller@188 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x188 4>;
+		label = "atc2_phymxwrap";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc2_common>, <&ps_atc2_usb_aon>;
+		status = "disabled";
+	};
+
+	/* usb-drd2's clock gate; the PHY's USB2 banks need it too */
+	ps_atc2_usb: power-controller@180 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x180 4>;
+		label = "atc2_usb";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc2_common>, <&ps_atc2_usb_aon>;
+		status = "disabled";
+	};
+
+	/* ATC3: ADT gates 269, 270 (usb-drd3) and 271 */
+	ps_atc3_usb_aon: power-controller@190 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x190 4>;
+		label = "atc3_usb_aon";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+	};
+
+	ps_atc3_usb: power-controller@198 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x198 4>;
+		label = "atc3_usb";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc3_common>, <&ps_atc3_usb_aon>;
+	};
+
+	ps_atc3_phymxwrap: power-controller@1a0 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x1a0 4>;
+		label = "atc3_phymxwrap";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		power-domains = <&ps_atc3_common>, <&ps_atc3_usb_aon>;
+	};
+};
+
+/*
+ * DisplayPort out through ATC2: die 0's dcpext0 route (crossbar index 0, typec-dptx-phys 2).
+ * The board links the route to its connector.
+ */
+&dcpext0 {
+	apple,connector-type = "USB-C";
+	apple,dptx-die = <0>;
+	apple,typec-dptx-phys = <2>;
+	apple,typec-mux-indices = <0>;
+	phys = <&atc2_phy 6>;
+	phy-names = "typec0";
+	mux-controls = <&atc2_xbar 0>;
+	mux-control-names = "typec0";
+
+	typec-routes {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		route@0 {
+			reg = <0>;
+			mode-switch;
+		};
+	};
+};
+
+/ {
+	/*
+	 * The internal PCIe host (apcie). The boot loader powers and trains the links of the
+	 * ports the board uses and keeps power, clocks, the PHYs and PERST; Linux owns the
+	 * routing, MSI and the DARTs. The board names those ports: their registers and
+	 * interrupts (config and rc, then each port's portN, phyN and intr2axiN), its
+	 * iommu-map and bus-range, and a node per port. One MSI domain for all ports: vectors
+	 * 64-127.
+	 */
+	pcie0: pcie@1cb0000000 {
+		compatible = "apple,t6050-pcie";
+		device_type = "pci";
+		nonposted-mmio;
+
+		msi-controller;
+		msi-parent = <&pcie0>;
+		msi-ranges = <&aic AIC_IRQ 0 1888 IRQ_TYPE_EDGE_RISING 64>;
+		apple,msi-vector-base = <64>;
+
+		iommu-map-mask = <0xffff>;
+		dma-coherent;
+		linux,pci-domain = <0>;
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges = <0x02000000 0x0 0x80000000 0xb 0x80000000 0x0 0x40000000>,
+			 <0x43000000 0xb 0xc0000000 0xb 0xc0000000 0x0 0x20000000>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-dieX.dtsi b/arch/arm64/boot/dts/apple/t6050-dieX.dtsi
new file mode 100644
index 000000000..94e9def55
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-dieX.dtsi
@@ -0,0 +1,283 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Nodes present on every die of the Apple T6050 (M5 Max, M5 Ultra),
+ * included once per die (see t6050-base.dtsi for the macros it uses).
+ * Each block is die 0's at the die stride; its interrupts are die 0's
+ * numbers on its own die of the AIC.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+&SOC_NODE {
+	/*
+	 * The clusters' DVFS command apertures: /arm-io/pmgr reg 16, 26 and 36 (0x12e8 each, the driver uses
+	 * the first 0x1000), at the die stride on die 1 (not in pmgr's reg list). apple,firmware-managed-thermal:
+	 * see the CPU OPP tables.
+	 */
+	DIE_NODE(cpufreq_mc0): performance-controller@DIE_UNIT(210e20000) {
+		compatible = "apple,t6050-cluster-cpufreq";
+		reg = <DIE_HI(0x2) 0x10e20000 0x0 0x1000>;
+		#performance-domain-cells = <0>;
+		apple,firmware-managed-thermal;
+	};
+
+	DIE_NODE(cpufreq_mc1): performance-controller@DIE_UNIT(211e20000) {
+		compatible = "apple,t6050-cluster-cpufreq";
+		reg = <DIE_HI(0x2) 0x11e20000 0x0 0x1000>;
+		#performance-domain-cells = <0>;
+		apple,firmware-managed-thermal;
+	};
+
+	DIE_NODE(cpufreq_pc): performance-controller@DIE_UNIT(212e20000) {
+		compatible = "apple,t6050-cluster-cpufreq";
+		reg = <DIE_HI(0x2) 0x12e20000 0x0 0x1000>;
+		#performance-domain-cells = <0>;
+		apple,firmware-managed-thermal;
+	};
+
+	/*
+	 * The PMGR groups G0, G1 (ADT /arm-io/pmgr reg[0] and reg[1]) and G2 that hold the
+	 * described power states. PMGR offsets from tools/aura's pmgr_adt2dt.py over the ADT; die
+	 * 1's records are die 0's at the same offsets (ADT gate IDs +0x10000000).
+	 */
+	DIE_NODE(pmgr0): power-management@DIE_UNIT(280600000) {
+		compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+		reg = <DIE_HI(0x2) 0x80600000 0x0 0x4000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		/* ATC1_COMMON, ADT gate 56 */
+		DIE_NODE(ps_atc1_common): power-controller@210 {
+			compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x210 4>;
+			label = DIE_ATC1_LABEL(_common);
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+		};
+	};
+
+	DIE_NODE(pmgr1): power-management@DIE_UNIT(280900000) {
+		compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+		reg = <DIE_HI(0x2) 0x80900000 0x0 0x4000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+	};
+
+	DIE_NODE(pmgr2): power-management@DIE_UNIT(288300000) {
+		compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+		reg = <DIE_HI(0x2) 0x88300000 0x0 0xc000>;
+		#address-cells = <1>;
+		#size-cells = <1>;
+
+		/* ATC1: ADT gates 263, 264 (usb-drd1) and 265 */
+		DIE_NODE(ps_atc1_usb_aon): power-controller@160 {
+			compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x160 4>;
+			label = DIE_ATC1_LABEL(_usb_aon);
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+		};
+
+		/* usb-drd1's clock gate (its DARTs' too); the PHY's USB2 banks need it as well */
+		DIE_NODE(ps_atc1_usb): power-controller@168 {
+			compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x168 4>;
+			label = DIE_ATC1_LABEL(_usb);
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			power-domains = <&DIE_NODE(ps_atc1_common)>, <&DIE_NODE(ps_atc1_usb_aon)>;
+		};
+
+		DIE_NODE(ps_atc1_phymxwrap): power-controller@170 {
+			compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+			reg = <0x170 4>;
+			label = DIE_ATC1_LABEL(_phymxwrap);
+			#power-domain-cells = <0>;
+			#reset-cells = <0>;
+			power-domains = <&DIE_NODE(ps_atc1_common)>, <&DIE_NODE(ps_atc1_usb_aon)>;
+		};
+	};
+
+	/*
+	 * dcpext0, the die's first external display engine, as iBoot leaves it: powered, its ASC
+	 * running, both DARTs locked (PROTECT 0xff / 0xb9) on its own four-level tables, DCP SID 23,
+	 * scanout SID 0 and PIODMA SID 16. From the ADT (/arm-io/dcpext0, dispext0, dart-dcpext0,
+	 * dart-dispext0; die 1's are dcpext4 and its DARTs; arm-io ranges +0x200000000). No
+	 * power-domains: the blocks run with auto-enable, and the pwrstate driver would write PS at
+	 * probe. All disabled here: Aura enables them only when its checks of that state pass and it
+	 * has reserved vram.
+	 */
+	DIE_NODE(dart_dcpext0): iommu@DIE_UNIT(2b2340000) {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <DIE_HI(0x2) 0xb2340000 0x0 0x20000>;
+		/* dart-dcpext0 and dart-dispext0 share ADT interrupt 1070 */
+		interrupts = <AIC_IRQ DIE_NO 1070 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		/* ADT vm-base 1 TiB, vm-size 3 TiB */
+		apple,dma-range = <0x100 0x0 0x300 0x0>;
+		status = "disabled";
+	};
+
+	DIE_NODE(dart_dispext0): iommu@DIE_UNIT(2b2300000) {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		/* reg[0] only; the ADT's second bank (0xb2314000) and shared 0x803f0000 are not ours */
+		reg = <DIE_HI(0x2) 0xb2300000 0x0 0xc000>;
+		interrupts = <AIC_IRQ DIE_NO 1070 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x0 0x300 0x0>;
+		status = "disabled";
+	};
+
+	/* The ASC v4 mailbox at dcpext0 + 0x8000; ADT interrupts 1123..1126 in mailbox order */
+	DIE_NODE(dcpext0_mbox): mailbox@DIE_UNIT(2b2e08000) {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <DIE_HI(0x2) 0xb2e08000 0x0 0x4000>;
+		interrupts = <AIC_IRQ DIE_NO 1123 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ DIE_NO 1124 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ DIE_NO 1125 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ DIE_NO 1126 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+		status = "disabled";
+	};
+
+	/* dispext0 reg[4]: the PMC metadata the bandwidth scratch lives in */
+	DIE_NODE(dcpext0_pmc): pmc-metadata@DIE_UNIT(286700000) {
+		reg = <DIE_HI(0x2) 0x86700000 0x0 0x114000>;
+		#apple,bw-scratch-cells = <3>;
+		status = "disabled";
+	};
+
+	DIE_NODE(dcpext0): dcp@DIE_UNIT(2b2e00000) {
+		compatible = "apple,t6050-dcpext", "apple,dcpext";
+		reg = <DIE_HI(0x2) 0xb2e00000 0x0 0x4000>,
+		      <DIE_HI(0x2) 0xb0000000 0x0 0x4000000>,
+		      <DIE_HI(0x2) 0xb2240000 0x0 0x10000>,
+		      <DIE_HI(0x2) 0xb23ac000 0x0 0x4000>,
+		      <DIE_HI(0x2) 0xb2800000 0x0 0x800000>,
+		      <DIE_HI(0x2) 0x86700000 0x0 0x114000>,
+		      <DIE_HI(0x2) 0xb2850000 0x0 0x4000>;
+		reg-names = "coproc", "disp-0", "disp-1", "disp-2", "disp-3", "disp-4", "iop-vbar";
+		mboxes = <&DIE_NODE(dcpext0_mbox)>;
+		mbox-names = "mbox";
+		iommus = <&DIE_NODE(dart_dcpext0) 23>;
+		/* The bandwidth request (BIRQ 0x36) on the die's PMC */
+		apple,bw-scratch = <&DIE_NODE(dcpext0_pmc) 0 5 0x2c000>;
+		/*
+		 * The die-local index, as for the M2 Ultra's die-1 dcpext0 (t602x-dieX.dtsi):
+		 * crossbar ufp endpoint 0 on its die. The ADT's firmware-facing external-index
+		 * of die 1's is 5.
+		 */
+		apple,dcp-index = <1>;
+		/* dcpext has no firmware clocks (an empty list) */
+		apple,clock-ids;
+		/*
+		 * apple,firmware-version/-compat come from Aura's handoff: the stub's firmware,
+		 * 27.0 or 27.2, whose IOMFB method IDs differ (iomfb_v27.c).
+		 */
+		status = "disabled";
+
+		piodma {
+			iommus = <&DIE_NODE(dart_dispext0) 16>;
+		};
+	};
+
+	/*
+	 * ATC1, USB data: its combo PHY, usb-drd1 and dart-usb1 (ADT /arm-io/atc-phy1,
+	 * acio-phy-cpu1, usb-drd1, dart-usb1; die 1's are atc-phy5, acio-phy-cpu5, usb-drd5 and
+	 * dart-usb5).
+	 */
+	/* /arm-io/acio-phy-cpu1 reg[0]: the PHY firmware's mailbox (it runs, pre-loaded by iBoot) */
+	DIE_NODE(atc1_phy_mbox): mailbox@DIE_UNIT(2ab148000) {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <DIE_HI(0x2) 0xab148000 0x0 0x4000>;
+		interrupts = <AIC_IRQ DIE_NO 851 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ DIE_NO 852 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ DIE_NO 853 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ DIE_NO 854 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty", "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	/* /arm-io/atc-phy1 regs [2] [0] usb-drd1[4] [39] [40] [41] [42] [43] [38] [37] usb-drd1[3] */
+	DIE_NODE(atc1_phy): phy@DIE_UNIT(2ab000000) {
+		compatible = "apple,t6050-combo-phy";
+		reg = <DIE_HI(0x2) 0xab000000 0x0 0x2c000>,
+		      <DIE_HI(0x2) 0xaaa90000 0x0 0x4000>,
+		      <DIE_HI(0x2) 0xaa800000 0x0 0x4000>,
+		      <DIE_HI(0x2) 0xab200000 0x0 0x4000>,
+		      <DIE_HI(0x2) 0xab244000 0x0 0x4000>,
+		      <DIE_HI(0x2) 0xa8000000 0x0 0x8000>,
+		      <DIE_HI(0x2) 0xa8020000 0x0 0x4000>,
+		      <DIE_HI(0x2) 0xab250000 0x0 0x4000>,
+		      <DIE_HI(0x2) 0xab140000 0x0 0x4000>,
+		      <DIE_HI(0x2) 0xab0c0000 0x0 0x10000>,
+		      <DIE_HI(0x2) 0xaaa84000 0x0 0x4000>;
+		reg-names = "core", "usb2phy", "usb2-digital", "reset", "fabric", "axi2af", "lioa",
+			    "common-cfg", "usb-control", "firmware-data", "pipehandler";
+		#phy-cells = <1>;
+		#reset-cells = <1>;
+		apple,port-index = <(4 * DIE_NO + 1)>;
+		/* The binding's name for "no other owner"; nothing else drives this port here. */
+		apple,guest-port-reserved;
+		mode-switch;
+		orientation-switch;
+		mboxes = <&DIE_NODE(atc1_phy_mbox)>;
+		power-domains = <&DIE_NODE(ps_atc1_usb_aon)>, <&DIE_NODE(ps_atc1_common)>,
+				<&DIE_NODE(ps_atc1_phymxwrap)>, <&DIE_NODE(ps_atc1_usb)>;
+		power-domain-names = "usb-aon", "common", "wrapper", "usb";
+	};
+
+	/*
+	 * /arm-io/usb-drd1: reg[0] (core and Apple regions), reg[1] (drd-cfg), interrupt 1451. The
+	 * tunables are its ADT tables (DRD_USB31_GBL_DEFAULT with GCTL.PWRDNSCALE = 0xd, as on
+	 * T6040; GBL_HOST, DBG, CFG_HOST, LINK_REGS, CIO_REGS); PIPE_HANDLER goes to the PHY.
+	 */
+	DIE_NODE(usb_drd1): usb@DIE_UNIT(2aa280000) {
+		compatible = "apple,t6050-dwc3", "apple,t8103-dwc3";
+		reg = <DIE_HI(0x2) 0xaa280000 0x0 0xcd00>,
+		      <DIE_HI(0x2) 0xaa28cd00 0x0 0x4b00>,
+		      <DIE_HI(0x2) 0xaa200000 0x0 0x4000>;
+		reg-names = "dwc3-core", "dwc3-apple", "drd-cfg";
+		interrupts = <AIC_IRQ DIE_NO 1451 IRQ_TYPE_LEVEL_HIGH>;
+		dr_mode = "otg";
+		usb-role-switch;
+		role-switch-default-mode = "host";
+		iommus = <&DIE_NODE(usb_drd1_dart_0) 0>, <&DIE_NODE(usb_drd1_dart_1) 1>;
+		power-domains = <&DIE_NODE(ps_atc1_usb)>;
+		resets = <&DIE_NODE(atc1_phy) 0>;
+		phys = <&DIE_NODE(atc1_phy) PHY_TYPE_USB2>, <&DIE_NODE(atc1_phy) PHY_TYPE_USB3>;
+		phy-names = "usb2-phy", "usb3-phy";
+		apple,tunable-gbl-default = <0x64 0x2 0x0>, <0x10 0xfff80000 0x00680000>;
+		apple,tunable-gbl-host = <0x4 0x0001ef00 0x00002f00>, <0x1c 0x00000100 0x0>,
+			<0x2c 0x000a07ff 0x000800c8>, <0x100 0x02000100 0x02000100>,
+			<0x504 0x00001000 0x0>, <0x528 0xff0000ff 0x06000006>,
+			<0x52c 0xff0000ff 0x08000008>, <0x580 0xffffffff 0x6f000006>,
+			<0x584 0xffffffff 0x00060000>;
+		apple,tunable-dbg = <0x0 0x8 0x8>;
+		apple,tunable-cfg-host = <0x20 0xff 0x1b>;
+		apple,tunable-link = <0x10 0xff000000 0xff000000>, <0x20 0x7ff00000 0x4e900000>,
+			<0x24 0x001f8000 0x000b8000>, <0x60 0x0003ffff 0x00000600>;
+		apple,tunable-cio = <0x20 0x00ff0000 0x001e0000>;
+	};
+
+	/* /arm-io/dart-usb1 reg[0] and reg[1], interrupt 1455; vm-base 0x10000004000 +0xffff0000 */
+	DIE_NODE(usb_drd1_dart_0): iommu@DIE_UNIT(2aaf00000) {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <DIE_HI(0x2) 0xaaf00000 0x0 0xc000>;
+		interrupts = <AIC_IRQ DIE_NO 1455 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&DIE_NODE(ps_atc1_usb)>;
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
+	};
+
+	DIE_NODE(usb_drd1_dart_1): iommu@DIE_UNIT(2aaf80000) {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <DIE_HI(0x2) 0xaaf80000 0x0 0xc000>;
+		interrupts = <AIC_IRQ DIE_NO 1455 IRQ_TYPE_LEVEL_HIGH>;
+		power-domains = <&DIE_NODE(ps_atc1_usb)>;
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-j714s.dts b/arch/arm64/boot/dts/apple/t6050-j714s.dts
new file mode 100644
index 000000000..57061b1e2
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-j714s.dts
@@ -0,0 +1,1080 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * MacBook Pro (14-inch, M5 Pro, 2026)
+ *
+ * target-type: J714s (Mac17,9)
+ *
+ * Derived from the published J716s board, whose [ADT] comments below describe
+ * the reference J716s unless a local override says otherwise. Inactive audio,
+ * host USB and N1 nodes are not claims of J714s compatibility.
+ * The owner J714s ADT lists 15 CPU cores; t6050-max.dtsi supplies the physical
+ * slot inventory and m1n1 removes the cores absent from this unit's ADT. Like t6050-j716c.dts, this file only
+ * enables and configures what has been brought up; the SoC's other blocks
+ * stay disabled.
+ *
+ * Tags in the comments: [ADT] the J714s runtime ADT, [J716C] as
+ * t6050-j716c.dts because the J714s ADT shows the same value, [OURS] the
+ * m5pro-linux J714s tree, [INFER] inferred, not measured.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/leds/common.h>
+#include "t6050-max.dtsi"
+
+/ {
+	/* [ADT] /product sub-product-type "Mac17,9", product-name "MacBook Pro (14-inch, M5 Pro)" */
+	compatible = "apple,j714s", "apple,t6050", "apple,arm-platform";
+	model = "Apple MacBook Pro (14-inch, M5 Pro, 2026)";
+	chassis-type = "laptop";
+
+	aliases {
+		serial0 = &dockchannel;			/* [J716C] */
+		/* The loader fills the N1's factory addresses through these [J716C] */
+		wifi0 = &n1_alpha;
+		bluetooth0 = &n1_beta;
+		/* m1n1 dt_set_ipd() fills the layout from the ADT keyboard node [OURS t6050-j714s.dts:21-25] */
+		keyboard = &keyboard;
+		/* m1n1 dt_set_gpu_t6050() fills the GPU hand-off, opt-in (see the GPU nodes below) */
+		gpu = &gpu;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		/* Normally replaced by the loader */
+		bootargs = "";
+
+		framebuffer0: framebuffer@0 {
+			compatible = "apple,simple-framebuffer", "simple-framebuffer";
+			reg = <0 0 0 0>; /* To be filled by the loader */
+			/* Format properties will be added by the loader */
+			/* simpledrm reports an eDP connector for the built-in panel */
+			apple,internal-panel;
+			status = "disabled";
+		};
+	};
+
+	/*
+	 * Keyboard backlight. [ADT] /arm-io/pwm0/kbd-backlight: channel 0,
+	 * default-hz 25000 -> period 40000 ns. [OURS t6050-j714s.dts:35-46]
+	 */
+	led-controller {
+		compatible = "pwm-leds";
+
+		led-0 {
+			pwms = <&fpwm0 0 40000>;
+			label = "kbd_backlight";
+			function = LED_FUNCTION_KBD_BACKLIGHT;
+			color = <LED_COLOR_ID_WHITE>;
+			max-brightness = <255>;
+			default-state = "keep";
+		};
+	};
+
+	/*
+	 * The sound card: the headphone jack on AOP DAI 0 (cout), the six
+	 * speaker amps on AOP DAI 4 (spkr) in [ADT] speakerN order: LW1, RW1,
+	 * LW2, RW2, LT, RT (TDM slots 0-5). The idle masks keep each bus's
+	 * three amps fed with zeros in the other bus's slots.
+	 */
+	sound {
+		compatible = "apple,j716-macaudio", "apple,macaudio";
+		model = "MacBook Pro J716";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		dai-link@0 {
+			reg = <0>;
+			link-name = "Headphone Jack";
+
+			cpu {
+				sound-dai = <&aop_audio 0>;
+			};
+
+			codec {
+				sound-dai = <&jack_codec>;
+			};
+		};
+
+		dai-link@1 {
+			reg = <1>;
+			link-name = "Speakers";
+			dai-tdm-idle-mode-0 = "zero";
+			dai-tdm-idle-mode-1 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f0>;
+			dai-tdm-slot-tx-idle-mask-1 = <0x0f0f0f>;
+
+			cpu {
+				sound-dai = <&aop_audio 4>;
+			};
+
+			codec {
+				sound-dai = <&speaker_lw1>, <&speaker_rw1>,
+					    <&speaker_lw2>, <&speaker_rw2>,
+					    <&speaker_lt>, <&speaker_rt>;
+			};
+		};
+	};
+};
+
+/*
+ * Blocks t6050-die0.dtsi does not describe yet (candidates for that file):
+ * the keyboard backlight PWM, the ATC0 gadget this board's tether runs on,
+ * and the third HPM SPMI bus.
+ */
+&die0 {
+	/* [ADT] /arm-io/pwm0 reg 0x505040000 +0x4000, clock-gate FPWM0 [OURS t6050.dtsi:303-315] */
+	fpwm0: pwm@505040000 {
+		compatible = "apple,t6050-fpwm", "apple,s5l-fpwm";
+		reg = <0x5 0x05040000 0x0 0x4000>;
+		power-domains = <&ps_fpwm0>;
+		clocks = <&clkref>;
+		#pwm-cells = <2>;
+	};
+
+	/*
+	 * ATC0 (left-back, the MagSafe side; [ADT] usb-drd0 port-number 1, hpm0
+	 * port-location "left-back"). The combo PHY driver refuses port 0, and this
+	 * port carries the USB tether, so it stays a device-mode controller on the
+	 * PHY state m1n1's usb_phy_bringup() leaves. [OURS t6050-storage-net.dtsi:50-88]
+	 * [ADT] /arm-io/usb-drd0 reg[0] 0x2a2280000, interrupts[0] 1419;
+	 * /arm-io/dart-usb0 reg[0] 0x2a2f00000, reg[1] 0x2a2f80000, interrupt 1423.
+	 */
+	dwc3_0: usb@2a2280000 {
+		compatible = "snps,dwc3";
+		reg = <0x2 0xa2280000 0x0 0xcd00>;
+		interrupts = <AIC_IRQ 0 1419 IRQ_TYPE_LEVEL_HIGH>;
+		dr_mode = "peripheral";
+		maximum-speed = "high-speed";
+		iommus = <&dwc3_0_dart_0 0>, <&dwc3_0_dart_1 1>;
+		snps,usb2-gadget-lpm-disable;
+		snps,dis_u2_susphy_quirk;
+		snps,dis_u3_susphy_quirk;
+		snps,dis_enblslpm_quirk;
+	};
+
+	dwc3_0_dart_0: iommu@2a2f00000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0xa2f00000 0x0 0xc000>;
+		interrupts = <AIC_IRQ 0 1423 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+
+	dwc3_0_dart_1: iommu@2a2f80000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0xa2f80000 0x0 0xc000>;
+		interrupts = <AIC_IRQ 0 1423 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+
+	/*
+	 * [ADT] /arm-io/nub-spmi-a1: reg[0] 0x8a1a8000 (+0x200000000), gen 4, the
+	 * HPM bus of the right-hand port (hpm2). J716c uses nub-spmi-a2 instead;
+	 * this board has no a2. Polled, like a0: the gen 4 driver refuses an
+	 * interrupt (the ADT lists AIC 763 for it, 761 for a0). No power-domains:
+	 * [ADT] pmgr NUB_SPMI_A1 (group 2 +0x68) is critical, as NUB_SPMI_A0.
+	 */
+	nub_spmi_a1: spmi@28a1a8000 {
+		compatible = "apple,t6050-spmi", "apple,t8142-spmi";
+		reg = <0x2 0x8a1a8000 0x0 0x4000>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+	};
+};
+
+/* [ADT] pmgr device FPWM0, group 1 + 0x2a8 [OURS t6050-pmgr.dtsi:952-959]; parent SIO left undescribed as for ps_i2c1/2 */
+&pmgr1 {
+	ps_fpwm0: power-controller@2a8 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x2a8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "fpwm0";
+	};
+};
+
+/*
+ * PCIe port 0: the N1 (Wi-Fi and Bluetooth). Port 1 is the SD reader
+ * ([ADT] apcie0/pci-bridge1/pcie-sdreader), not described. The loader must
+ * enable port00 and dart_apcie0 after its strict adoption checks, or after
+ * filling all six own host lists for the public kernel-train/manual-DART contract.
+ * The dedicated N1 profile enables the host; no legacy loader train is armed.
+ * [ADT] /arm-io/apcie0 reg[0] 0x1cb0000000, reg[1] 0x414000000 (rc),
+ * reg[16] 0x410028000 (port0), reg[18] 0x417010000 (phy0), reg[19]
+ * 0x410024000 (intr2axi0), interrupts[0] 1523: identical to J716c.
+ */
+&pcie0 {
+	reg = <0x1c 0xb0000000 0x0 0x10000000>,
+	      <0x4 0x14000000 0x0 0x4000>,
+	      <0x4 0x10028000 0x0 0x8000>,
+	      <0x4 0x17010000 0x0 0x4000>,
+	      <0x4 0x10024000 0x0 0x4000>,
+	      <0x4 0x17020000 0x0 0x4000>,
+	      <0x4 0x17004000 0x0 0x4000>,
+	      <0x4 0x16000000 0x0 0x24000>,
+	      <0x4 0x15044000 0x0 0x4000>,
+	      <0x4 0x17000000 0x0 0x24000>,
+	      <0x4 0x17800000 0x0 0x1b4000>;
+	reg-names = "config", "rc", "port0", "phy0", "intr2axi0",
+		    "phy-shared", "phy-common", "axi2af", "pcieclkgen",
+		    "phy-window", "phy-ip";
+	interrupts = <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>;
+	interrupt-names = "port0";
+
+	/* The N1's three functions are on DART streams 1-3 [J716C] */
+	iommu-map = <0x100 &dart_apcie0 1 3>;
+	bus-range = <0 4>;
+
+	port00: pci@0,0 {
+		device_type = "pci";
+		reg = <0x0 0 0 0 0>;
+		bus-range = <1 1>;
+		apple,link-trained-by-bootloader;
+		/* Own 27.3 ADT: pKW4(gP13, 0x00800000); MFD permission is separate. */
+		pwren-gpios = <&smc_j714s_gpio 0x13 GPIO_ACTIVE_HIGH>;
+		/* PERST#: [ADT] pci-bridge0 function-perst = GPIO 80 */
+		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
+		status = "disabled";
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
+				<0 0 0 2 &port00 0 0 0 1>,
+				<0 0 0 3 &port00 0 0 0 2>,
+				<0 0 0 4 &port00 0 0 0 3>;
+
+		/* Existing m1n1 fills target-type/board-id/chip-id; do not keep old inferred IDs. */
+		n1_control: control@0,0 {
+			compatible = "pci106b,1900";
+			reg = <0x10000 0x0 0x0 0x0 0x0>;
+			/* firmware-name and platform-id are filled from this boot ADT by m1n1. */
+
+			apple,centauri-protocol = <27>;
+		};
+
+		/* [ADT] apcie0/pci-bridge0/centauri-alpha (fn 1) */
+		n1_alpha: wifi@0,1 {
+			compatible = "pci106b,1902";
+			reg = <0x10100 0x0 0x0 0x0 0x0>;
+			local-mac-address = [00 00 00 00 00 00];
+		};
+
+		/* [ADT] apcie0/pci-bridge0/centauri-beta (fn 2) */
+		n1_beta: bluetooth@0,2 {
+			compatible = "pci106b,1903";
+			reg = <0x10200 0x0 0x0 0x0 0x0>;
+			local-bd-address = [00 00 00 00 00 00];
+		};
+	};
+};
+
+/*
+ * Type-C. [ADT] port map:
+ *   ATC0 usb-drd0 port 1 left-back  hpm0 nub-spmi-a0 SID 0x0c  (tether, dwc3_0 above)
+ *   ATC1 usb-drd1 port 2 left-front hpm1 nub-spmi-a0 SID 0x0a
+ *   ATC2 usb-drd2 port 3 right      hpm2 nub-spmi-a1 SID 0x0c
+ *   MagSafe                          hpm5 nub-spmi-a0 SID 0x08 (port-type 17, not a USB-C connector)
+ * There is no usb-drd3 in this ADT, so ATC3's USB chain stays off.
+ */
+&atc3_phy_mbox {
+	status = "disabled";
+};
+
+&atc3_phy {
+	status = "disabled";
+};
+
+&usb_drd3 {
+	status = "disabled";
+};
+
+&usb_drd3_dart_0 {
+	status = "disabled";
+};
+
+&usb_drd3_dart_1 {
+	status = "disabled";
+};
+
+&nub_spmi_a2 {
+	status = "disabled";			/* [ADT] this board has no nub-spmi-a2 */
+};
+
+/*
+ * Left-front port (ATC1): SN201202x hpm1, polled (no interrupts property),
+ * the connector graph into dwc3 (USB2) and the combo PHY (SuperSpeed).
+ * Node shape from t8142-j813-usb.dtsi. USB3 works on this port with the
+ * PHY tunables the loader fills from the ADT (m1n1 kboot_atc).
+ */
+&nub_spmi_a0 {
+	hpm1: usb-pd@a {
+		compatible = "apple,sn201202x";
+		reg = <0xa SPMI_USID>;			/* [ADT] hpm1 reg[0] = 0x0a */
+
+		typec1: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Left-front";	/* [ADT] hpm1 port-location */
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					typec1_hs: endpoint {
+						remote-endpoint = <&usb_drd1_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					typec1_ss: endpoint {
+						remote-endpoint = <&atc1_phy_typec>;
+					};
+				};
+			};
+		};
+	};
+};
+
+&usb_drd1 {
+	port {
+		usb_drd1_hs: endpoint {
+			remote-endpoint = <&typec1_hs>;
+		};
+	};
+};
+
+&atc1_phy {
+	port {
+		atc1_phy_typec: endpoint {
+			remote-endpoint = <&typec1_ss>;
+		};
+	};
+};
+
+/*
+ * Right port (ATC2), the same chain as the left-front port: SN201202x hpm2
+ * on nub_spmi_a1, polled; the connector graph into usb_drd2 (USB2) and the
+ * combo PHY (SuperSpeed). [ADT] /arm-io/nub-spmi-a1/hpm2 reg[0] = 0x0c,
+ * port-number 3, port-location "right", acio-parent acio2; atc-phy2 and
+ * usb-drd2 port-number 3. Only the USB route: dcpext0's DisplayPort route
+ * through ATC2 (atc2_xbar, the PHY's DP lane, the connector's DP port)
+ * stays off, so the connector has no port@2.
+ */
+&nub_spmi_a1 {
+	hpm2: usb-pd@c {
+		compatible = "apple,sn201202x";
+		reg = <0xc SPMI_USID>;			/* [ADT] hpm2 reg[0] = 0x0c */
+
+		typec2: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Right";		/* [ADT] hpm2 port-location */
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					typec2_hs: endpoint {
+						remote-endpoint = <&usb_drd2_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					typec2_ss: endpoint {
+						remote-endpoint = <&atc2_phy_typec>;
+					};
+				};
+			};
+		};
+	};
+};
+
+/*
+ * [ADT] /arm-io/atc-phy2 reg[2] 0x183000000 (core), acio-phy-cpu2 reg[0]
+ * 0x183148000 with interrupts 861-864, usb-drd2 interrupt 1483, dart-usb2
+ * interrupt 1487 (arm-io ranges +0x200000000): what t6050-die0.dtsi
+ * describes. Power: [ADT] pmgr ATC2_COMMON (group 0 +0x238, gate 61, parent
+ * FAB5_SOC, critical), ATC2_USB_AON (group 2 +0x178, 266), ATC2_USB (+0x180,
+ * 267, usb-drd2's gate) and ATC2_PHYMXWRAP (+0x188, 268), parents 61 and
+ * 266, as ATC1's 56/263-265. The loader fills the PHY's tunables (it finds
+ * the node by its core window) and parks the PIPE of every usb-drdN.
+ */
+&ps_atc2_common {
+	status = "okay";
+};
+
+&ps_atc2_usb_aon {
+	status = "okay";
+};
+
+&ps_atc2_phymxwrap {
+	status = "okay";
+};
+
+&ps_atc2_usb {
+	status = "okay";
+};
+
+&atc2_phy_mbox {
+	status = "okay";
+};
+
+&atc2_phy {
+	status = "okay";
+
+	port {
+		atc2_phy_typec: endpoint {
+			remote-endpoint = <&typec2_ss>;
+		};
+	};
+};
+
+&usb_drd2 {
+	status = "okay";
+
+	port {
+		usb_drd2_hs: endpoint {
+			remote-endpoint = <&typec2_hs>;
+		};
+	};
+};
+
+&usb_drd2_dart_0 {
+	status = "okay";
+};
+
+&usb_drd2_dart_1 {
+	status = "okay";
+};
+
+/*
+ * Audio. [ADT] six SN012776 amps (TAS2764 family) on i2c1 (left: woofers 1
+ * and 2, tweeter) and i2c3 (right), the CS42L84 jack codec on i2c2, all
+ * clocked by the AOP's serializer; the AOP runs the speaker and jack streams
+ * and the microphone array. Node shapes follow edimoldovan's J714c tree
+ * (linux-aurora t6050-j714c). i2c3, its power state, the AOP's setup port
+ * and the LEAP-S ADMAC are not in t6050-die0.dtsi yet (candidates for it);
+ * they are described here, as is everything this board enables.
+ */
+&die0 {
+	/* [ADT] /arm-io/i2c3 reg 0x50501c000 (+0x4000), interrupt 1378 */
+	i2c3: i2c@50501c000 {
+		compatible = "apple,t6050-i2c", "apple,t8103-i2c";
+		reg = <0x5 0x0501c000 0x0 0x4000>;
+		clocks = <&clkref>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 0 1378 IRQ_TYPE_LEVEL_HIGH>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		power-domains = <&ps_i2c3>;
+	};
+
+	/*
+	 * The AOP's setup port, which its AFK endpoints answer only after:
+	 * [ADT] /arm-io/aop-exclave-mailbox reg 0x2d067c000, interrupts 582
+	 * (send-empty) and 585 (recv-not-empty), messages through dart-aop
+	 * stream 1, whose window starts at 0x20000000000.
+	 */
+	aop_setup_mbox: mailbox@2d067c000 {
+		compatible = "apple,t6050-aop-setup-mailbox",
+			     "apple,t8140-aop-setup-mailbox";
+		reg = <0x2 0xd067c000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 0 582 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 585 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "recv-not-empty";
+		iommus = <&aop_dart 1>;
+		apple,dma-range = <0x200 0x0 0x10 0x0>;
+		#mbox-cells = <0>;
+	};
+
+	/*
+	 * The LEAP-S ADMAC through its non-secure proxy: [ADT]
+	 * admac-hp-mic-ec-proxy reg 0x2d3200000, interrupt 638, 9 TX and 9 RX
+	 * channels, dart-aop stream 11. The microphone array is on its RX 0.
+	 */
+	admac_leap_s: dma-controller@2d3200000 {
+		compatible = "apple,t6050-admac", "apple,t8140-admac";
+		reg = <0x2 0xd3200000 0x0 0x34000>;
+		dma-channels = <9>;
+		interrupts-extended = <&aic AIC_IRQ 0 638 IRQ_TYPE_LEVEL_HIGH>,
+				      <0>, <0>, <0>;
+		#dma-cells = <1>;
+		iommus = <&aop_dart 11>;
+		apple,dma-range = <0x110 0x00000000 0x0 0x10000000>;
+	};
+};
+
+/* [ADT] pmgr device I2C3, group 1 + 0x2d8, after I2C1 (+0x2c8) and I2C2 (+0x2d0) */
+&pmgr1 {
+	ps_i2c3: power-controller@2d8 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x2d8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "i2c3";
+	};
+};
+
+&aop_mbox {
+	status = "okay";
+};
+
+/*
+ * dart-aop: iBoot locks it with inherited roots; the T8142 compatible
+ * selects apple-dart's per-stream retained-root path, as on the J714c.
+ */
+&aop_dart {
+	compatible = "apple,t6050-dart", "apple,t8142-dart", "apple,t8110-dart";
+	status = "okay";
+};
+
+&admac_base_ns {
+	status = "okay";
+};
+
+&aop {
+	mboxes = <&aop_mbox>, <&aop_setup_mbox>;
+	mbox-names = "mbox", "setup";
+	status = "okay";
+};
+
+/*
+ * [ADT] iop-audio-controller: spkr on base-ns TX0 with the amps' V/I sense
+ * on RX0, cout/cin (the jack) on TX2/RX2 (Linux channel 2N for TX N, 2N+1
+ * for RX N), and the microphone array on LEAP-S RX0 (leap-s-adma-rx-0).
+ */
+&aop_audio {
+	dmas = <&admac_base_ns 0>, <&admac_base_ns 1>,
+	       <&admac_base_ns 4>, <&admac_base_ns 5>,
+	       <&admac_leap_s 1>;
+	dma-names = "spkr", "spkr-sense", "cout", "cin", "hpai";
+	apple,chassis-name = "J716";
+	apple,machine-kind = "MacBook Pro";
+};
+
+/*
+ * The amps share one shutdown line (SDZ, [ADT] AP GPIO 107, active high) and
+ * one level-low interrupt (AP GPIO 106). apple,speaker-config is [ADT]
+ * speaker-config: TX slot, amp level, V sense slot, I sense slot; the amp
+ * level is lowered from the ADT's 15 (18.5 dBV) to 10 (16 dBV), and macaudio
+ * caps the speaker volume at -30 dB on top of that. apple,deferred-shutdown:
+ * the AOP stops its serializer (pw0) only after ASoC has muted the amps, so
+ * a muted amp then sees its clock stop; this marks that as expected.
+ */
+&i2c1 {
+	status = "okay";
+
+	speaker_lw1: codec@38 {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x38>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Woofer 1";
+		ti,imon-slot-no = <0>;
+		ti,vmon-slot-no = <2>;
+		apple,speaker-config = [00 0a 00 02];
+		apple,deferred-shutdown;
+	};
+
+	speaker_lw2: codec@39 {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x39>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Woofer 2";
+		ti,imon-slot-no = <8>;
+		ti,vmon-slot-no = <10>;
+		apple,speaker-config = [02 0a 08 0a];
+		apple,deferred-shutdown;
+	};
+
+	speaker_lt: codec@3a {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3a>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Tweeter";
+		ti,imon-slot-no = <16>;
+		ti,vmon-slot-no = <18>;
+		apple,speaker-config = [04 0a 10 12];
+		apple,deferred-shutdown;
+	};
+};
+
+/* The jack codec: reset [ADT] AP GPIO 139, interrupt AP GPIO 134 (level low) */
+&i2c2 {
+	status = "okay";
+
+	jack_codec: codec@4b {
+		compatible = "cirrus,cs42l84";
+		reg = <0x4b>;
+		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Jack";
+	};
+};
+
+&i2c3 {
+	speaker_rw1: codec@3b {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3b>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Woofer 1";
+		ti,imon-slot-no = <4>;
+		ti,vmon-slot-no = <6>;
+		apple,speaker-config = [01 0a 04 06];
+		apple,deferred-shutdown;
+	};
+
+	speaker_rw2: codec@3c {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3c>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Woofer 2";
+		ti,imon-slot-no = <12>;
+		ti,vmon-slot-no = <14>;
+		apple,speaker-config = [03 0a 0c 0e];
+		apple,deferred-shutdown;
+	};
+
+	speaker_rt: codec@3d {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3d>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Tweeter";
+		ti,imon-slot-no = <20>;
+		ti,vmon-slot-no = <22>;
+		apple,speaker-config = [05 0a 14 16];
+		apple,deferred-shutdown;
+	};
+};
+
+/*
+ * Pin 112 takes an SError when read (J716c finding, same SoC), so only the
+ * pins named here are exposed: 80 (PCIe port 0's PERST#, [ADT] pci-bridge0
+ * function-perst GPIO 80), 106 and 107 (the amps' interrupt and shutdown
+ * line), 134 and 139 (the jack codec's interrupt and reset), the pattern of
+ * t6050-j775d.dts.
+ */
+&pinctrl_ap {
+	gpio-reserved-ranges = <0 80>, <81 25>, <108 26>, <135 4>, <140 81>;
+};
+
+/*
+ * SMC sensors: the shared fan, power, voltage and current keys, and every
+ * readable float T* key through t6050-die0.dtsi's apple,discover-temperatures
+ * (labelled with the key name). Key set from the T6050 J714s SMC dump [OURS
+ * smc-keys-j714s.json]: F0Ac/F1Ac, F0Mn/F0Mx/F0Tg and F1*, PSTR, PDTR, PMVR,
+ * PHPC, VD0R, SBAV, ID0R present; a key this SMC lacks drops only that
+ * channel (macsmc-hwmon skips it).
+ *
+ * Discovery refuses to run once any temperature channel exists, so the
+ * shared temperature nodes go (their keys are discovered anyway: TH0x,
+ * TB0T, TCHP, TW0P), and so does the die0 apple,soc-die-keys list, whose
+ * "SoC die TCMb" channel would also count: with this driver the probe
+ * fails with -EINVAL otherwise. TCMb stays as a discovered channel; only
+ * the macsmc_soc_die thermal zone, which nothing in this DT uses, is lost.
+ * Drop the /delete-property/ once the driver has Aurora's b7891bd5f621
+ * ("hwmon: macsmc: Let discovered temperatures join the SoC die zone").
+ */
+#include "hwmon-common.dtsi"
+#include "hwmon-fan-dual.dtsi"
+#include "hwmon-laptop.dtsi"
+
+&smc_hwmon {
+	/delete-property/ apple,soc-die-keys;
+	/delete-node/ temperature-TH0x;
+	/delete-node/ temperature-TB0T;
+	/delete-node/ temperature-TCHP;
+	/delete-node/ temperature-TW0P;
+
+	/*
+	 * The T6050 SMC spells the fan mode keys F0md/F1md (ui8, flags 0xd0),
+	 * not the F0Md/F1Md of hwmon-fan*.dtsi, as on the J775D. No
+	 * apple,fan-manual-control: the SMC drives the fans and userspace only
+	 * reads them (macsmc_hwmon.fan_control=1 opens fan*_target for tests).
+	 */
+	fan-F0Ac {
+		apple,fan-mode = "F0md";
+	};
+
+	fan-F1Ac {
+		apple,fan-mode = "F1md";
+	};
+};
+
+/* The die's CIO reconfiguration register; no consumer is enabled yet */
+&cio_reconfig0 {
+	status = "okay";
+};
+
+/*
+ * The console on the USB debug link drains only while a host reads it
+ * [J716C]. On this board the tether is ATC0's gadget; keep earlycon=efifb.
+ */
+&dockchannel {
+	apple,tx-never-wait;
+	status = "okay";
+};
+
+/*
+ * Keyboard and trackpad: the HID transport on the MTP's DockChannel FIFO
+ * [J716C], with MTP firmware AppleMTPFirmwareMac-6320.86.1.
+ */
+&mtp_dockchannel {
+	mtp_hid: input@8000 {
+		compatible = "apple,dockchannel-hid";
+		reg = <0x8000 0x1000>, <0xc000 0x1000>,
+		      <0x0 0x1000>, <0x4000 0x1000>;
+		reg-names = "config", "data", "rmt-config", "rmt-data";
+		iommus = <&mtp_dart 0>;
+		interrupt-parent = <&mtp_dockchannel>;
+		interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
+			     <3 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "tx", "rx";
+		apple,fifo-size = <0x800>;		/* [ADT] dockchannel-mtp fifo-size 2048 [OURS] */
+		apple,helper-cpu = <&mtp>;
+		/*
+		 * The AFE reset: [ADT] multi-touch function-afe-reset is the SMC pcIO
+		 * output (0x10000, 0x11c0000), as on J716c, but this tree has no
+		 * apple,smc-pcio-gpio driver. The same line is SMC GPIO gp1c, active
+		 * low, which gpio-macsmc drives ("Touch MT ready" on 3 of 3 boots).
+		 */
+		apple,afe-reset-gpios = <&smc_j714s_gpio 28 GPIO_ACTIVE_HIGH>;
+
+		multi-touch {
+			apple,power-method = <2>;	/* [OURS] 6320.x accepts only method 2 */
+			firmware-name = "apple/tpmtfw-j714s.bin";	/* [OURS t6050-j714s.dts:79] */
+		};
+
+		keyboard: keyboard {
+			hid-country-code = <0>;		/* filled by m1n1 [OURS] */
+			apple,keyboard-layout-id = <0>;
+		};
+
+		stm {
+		};
+
+		/* [ADT] mtp-transport children actuator and tp-accel; optional */
+		actuator {
+		};
+
+
+	};
+};
+
+/*
+ * No driver here handles the SMC pcIO outputs (apple,smc-pcio-gpio), and the
+ * AFE reset above uses gp1c instead, so the node goes. Its J714s templates
+ * [ADT], pKW8('pcIO', lo, hi) as (hi << 32) | lo, are identical to J716c's:
+ *   0 dp2hdmi-gpio0 dp2hdmi_pwr_en (0x0, 0x1a0000)
+ *   1 dp2hdmi-gpio0 hdmi_pwr_en    (0x800000, 0xf0000)
+ *   2 multi-touch   afe-reset      (0x10000, 0x11c0000)
+ */
+/delete-node/ &smc_pcio;
+
+/*
+ * GPU (G17S, 2 x 10 cores) for aurora-silicon/linux's G17 M5 driver (apple,agx-g17s).
+ *
+ * Everything here is disabled. The loader enables it only on request: m1n1
+ * dt_set_gpu_t6050(), with the payload variable chosen.m5pro,gpu=1, fills in the six
+ * regions and the mailbox windows from the ADT of that boot, checks the rest against the
+ * ADT, and only then sets the regions, the mailboxes, &gpu and &pmgr_gfx okay. Without it
+ * no node below probes, and the PMGR group 3 registers stay untouched by Linux.
+ *
+ * Addresses from the J714s runtime ADT [ADT] (arm-io + 0x2_0000_0000):
+ *   sgx       /arm-io/sgx reg[0]        0x23_0000_0000 + 0x3fdc000
+ *   gfx-asc   reg[0..1]  0x23_0260_0000 + 0x88000, 0x23_0205_0000 + 0x8, role GFX,
+ *             interrupts 2798, 2797, 2800, 2799
+ *   gfx1-asc  reg[0..1]  0x23_02e0_0000 + 0x88000, 0x23_0285_0000 (+0x60000 in the ADT; the
+ *             mailbox driver maps exactly 8 bytes), role GFX1, interrupts 2802, 2801, 2804, 2803
+ *   power     pmgr reg[51] 0x23_00e8_0000 + 0x30000 (PS group 3): GPX +0x0, AFR +0x100,
+ *             CS +0x108 (parent AFR), GFX +0x110 (parents AFR, GPX; notify_pmp, id1 16)
+ * The send-empty / recv-not-empty choice (2797/2800, 2801/2804) is edimoldovan's J714c
+ * mapping, which booted RTKit there.
+ *
+ * The mailboxes use the native-address ASCWrap v6 profile of drivers/soc/apple/mailbox.c
+ * (apple,t6050-native-ascwrap-v6), whose role table holds these windows; with the hand-off
+ * the GPU driver can start both coprocessors through them.
+ */
+/ {
+	reserved-memory {
+		/* All six filled in per boot by the loader from the ADT (sgx and segment-ranges). */
+		gpu_fw_text: gpu-fw-text {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		gpu_fw_data: gpu-fw-data {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_ttbs: uat-ttbs {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_pagetables: uat-pagetables {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_l2_pagetables: uat-l2-pagetables {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_handoff: uat-handoff {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+	};
+
+	/* The GPU block, outside die 0's MMIO range: arm-io's second range maps it 1:1. */
+	soc@2300000000 {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges = <0x23 0x0 0x23 0x0 0x0 0x4000000>;
+		nonposted-mmio;
+
+		pmgr_gfx: power-management@2300e80000 {
+			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x23 0x00e80000 0x0 0x30000>;
+			status = "disabled";
+
+			ps_gpx: power-controller@0 {
+				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+				reg = <0x0 4>;
+				#power-domain-cells = <0>;
+				#reset-cells = <0>;
+				label = "gpx";
+				apple,always-on;	/* [ADT] critical */
+			};
+
+			ps_afr: power-controller@100 {
+				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+				reg = <0x100 4>;
+				#power-domain-cells = <0>;
+				#reset-cells = <0>;
+				label = "afr";
+				apple,always-on;	/* [ADT] critical */
+			};
+
+			ps_cs: power-controller@108 {
+				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+				reg = <0x108 4>;
+				#power-domain-cells = <0>;
+				#reset-cells = <0>;
+				label = "cs";
+				power-domains = <&ps_afr>;
+			};
+
+			ps_gfx: power-controller@110 {
+				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+				reg = <0x110 4>;
+				#power-domain-cells = <0>;
+				#reset-cells = <0>;
+				label = "gfx";
+				power-domains = <&ps_afr>, <&ps_gpx>;
+				/* As on J616/J700: the loaded firmware lives across sleep. */
+				apple,always-on;
+			};
+		};
+
+		gfx_mbox: mailbox@2302600000 {
+			compatible = "apple,t6050-native-ascwrap-v6";
+			reg = <0x23 0x02600000 0x0 0x88000>,	/* filled in by the loader */
+			      <0x23 0x02050000 0x0 0x8>;
+			reg-names = "wrapper", "iop-vbar";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 0 2797 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 0 2800 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "recv-not-empty";
+			apple,firmware-role = "GFX";
+			power-domains = <&ps_gfx>;
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
+		gfx1_mbox: mailbox@2302e00000 {
+			compatible = "apple,t6050-native-ascwrap-v6";
+			reg = <0x23 0x02e00000 0x0 0x88000>,	/* filled in by the loader */
+			      <0x23 0x02850000 0x0 0x8>;
+			reg-names = "wrapper", "iop-vbar";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 0 2801 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 0 2804 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "recv-not-empty";
+			apple,firmware-role = "GFX1";
+			power-domains = <&ps_gfx>;
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
+		gpu: gpu@2300000000 {
+			compatible = "apple,agx-g17s";
+			/* The G17 path maps only sgx; the coprocessor wrappers belong to the mailboxes. */
+			reg = <0x23 0x00000000 0x0 0x3fdc000>;
+			reg-names = "sgx";
+			mboxes = <&gfx_mbox>, <&gfx1_mbox>;
+			power-domains = <&ps_gfx>;
+			memory-region = <&uat_ttbs>, <&uat_pagetables>, <&uat_handoff>,
+					<&gpu_fw_data>, <&uat_l2_pagetables>, <&gpu_fw_text>;
+			memory-region-names = "ttbs", "pagetables", "handoff", "fw-data",
+					      "l2-pagetables", "fw-text";
+			/* No operating-points-v2: the M5 path takes its tables from the board table. */
+			status = "disabled";
+		};
+	};
+};
+
+/* Local J714s trial: only pcIO AFE GPIO, generic ATC1 USB2 gadget, simpledrm scanout.
+ * ATC1 resources match owner 26C5035r ADT; no Linux PHY/glue owns this controller.
+ * The GPU and PMGR group are enabled for the public m1n1 #37 handoff.
+ */
+/ { sound { status = "disabled"; }; };
+&smc {
+    smc_j714s_gpio: gpio-j714s {
+        compatible = "apple,smc-gpio";
+        gpio-controller;
+        #gpio-cells = <2>;
+    };
+};
+&usb_drd1 {
+    compatible = "snps,dwc3";
+    reg = <0x2 0xaa280000 0x0 0xcd00>;
+    /delete-property/ reg-names;
+    /delete-property/ phys;
+    /delete-property/ phy-names;
+    /delete-property/ resets;
+    /delete-property/ reset-names;
+    /delete-property/ usb-role-switch;
+    /delete-property/ role-switch-default-mode;
+    /delete-property/ power-domains;
+    /delete-property/ port;
+    dr_mode = "peripheral";
+    maximum-speed = "high-speed";
+    snps,usb2-gadget-lpm-disable;
+    snps,dis_u2_susphy_quirk;
+    snps,dis_u3_susphy_quirk;
+    snps,dis_enblslpm_quirk;
+    status = "okay";
+};
+&usb_drd1_dart_0 { /delete-property/ power-domains; status = "okay"; };
+&usb_drd1_dart_1 { /delete-property/ power-domains; status = "okay"; };
+&atc1_phy { status = "disabled"; };
+&atc1_phy_mbox { status = "disabled"; };
+&usb_drd2 { status = "disabled"; };
+&atc2_phy { status = "disabled"; };
+&atc2_phy_mbox { status = "disabled"; };
+&dwc3_0 { status = "disabled"; };
+&aop { status = "disabled"; };
+&aop_mbox { status = "disabled"; };
+&aop_dart { status = "disabled"; };
+/* Dedicated N1 source profile: root/port/DART admission still needs new S2. */
+&pcie0 { status = "okay"; };
+&gpu { status = "okay"; };
+&pmgr_gfx { status = "okay"; };
+
+/* Public N1 domains; own cached PMGR group/offset/parents independently match. */
+&dart_apcie0 { apple,manual-availability; };
+&pmgr1 {
+	ps_apcie_gp: power-controller@118 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x118 4>;
+		label = "apcie_gp";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		apple,always-on;
+	};
+
+	ps_fab6_soc: power-controller@138 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x138 4>;
+		label = "fab6_soc";
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		apple,always-on;
+	};
+
+	ps_apcie_sys_gp: power-controller@148 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x148 4>;
+		label = "apcie_sys_gp";
+		power-domains = <&ps_apcie_gp>, <&ps_fab6_soc>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		apple,always-on;
+		apple,no-auto-pm;
+	};
+
+	ps_apcie_phy_sw: power-controller@1b0 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x1b0 4>;
+		label = "apcie_phy_sw";
+		power-domains = <&ps_apcie_sys_gp>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		apple,always-on;
+		apple,no-auto-pm;
+	};
+
+	ps_aphy_gp_aus5_a: power-controller@258 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x258 4>;
+		label = "aphy_gp_aus5_a";
+		power-domains = <&ps_apcie_phy_sw>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		apple,always-on;
+	};
+
+	power-controller@280 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x280 4>;
+		label = "aphy_gp_aus5";
+		power-domains = <&ps_aphy_gp_aus5_a>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		apple,always-on;
+		apple,no-auto-pm;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-j716c.dts b/arch/arm64/boot/dts/apple/t6050-j716c.dts
new file mode 100644
index 000000000..da061edcb
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-j716c.dts
@@ -0,0 +1,223 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * MacBook Pro (16-inch, M5 Max, 2026)
+ *
+ * target-type: J716c
+ *
+ * The M5 Max is one T6050 die, die 0 (t6050-max.dtsi). This file enables
+ * and configures what has been brought up on this board; the SoC's other
+ * ports and buses stay disabled until each is described for it.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+/dts-v1/;
+
+#include "t6050-max.dtsi"
+
+/ {
+	compatible = "apple,j716c", "apple,t6050", "apple,arm-platform";
+	model = "Apple MacBook Pro (16-inch, M5 Max, 2026)";
+	chassis-type = "laptop";
+
+	aliases {
+		serial0 = &dockchannel;
+		/* kboot fills the N1's factory addresses from /chosen through these */
+		wifi0 = &n1_alpha;
+		bluetooth0 = &n1_beta;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		/* Normally replaced by the loader */
+		bootargs = "maxcpus=1";
+
+		framebuffer0: framebuffer@0 {
+			compatible = "apple,simple-framebuffer", "simple-framebuffer";
+			reg = <0 0 0 0>; /* To be filled by the loader */
+			/* Format properties will be added by the loader */
+			status = "disabled";
+		};
+	};
+};
+
+/*
+ * PCIe port 0: the N1 (Wi-Fi and Bluetooth), the only GP port this board uses besides the SD
+ * reader on port 1 (not yet described). The boot loader trains the link after the SMC releases
+ * the N1's reset and keeps power, clocks, the PHY and PERST; Linux owns the routing, MSI and
+ * the DART. Disabled with its DART until the boot loader trains it, which also renumbers the
+ * bus here to the PCI core's order.
+ */
+&pcie0 {
+	reg = <0x1c 0xb0000000 0x0 0x10000000>,
+	      <0x4 0x14000000 0x0 0x4000>,
+	      <0x4 0x10028000 0x0 0x8000>,
+	      <0x4 0x17010000 0x0 0x4000>,
+	      <0x4 0x10024000 0x0 0x4000>;
+	reg-names = "config", "rc", "port0", "phy0", "intr2axi0";
+	interrupts = <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>;
+	interrupt-names = "port0";
+
+	/* The N1's three functions are on DART streams 1-3 */
+	iommu-map = <0x100 &dart_apcie0 1 3>;
+	bus-range = <0 4>;
+
+	port00: pci@0,0 {
+		device_type = "pci";
+		reg = <0x0 0 0 0 0>;
+		bus-range = <1 1>;
+		apple,link-trained-by-bootloader;
+		/* PERST#, driven only by the root-port reset after the N1's ROM stage */
+		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
+		status = "disabled";
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
+				<0 0 0 2 &port00 0 0 0 1>,
+				<0 0 0 3 &port00 0 0 0 2>,
+				<0 0 0 4 &port00 0 0 0 3>;
+
+		/* platform ID (board 0x0e << 16) | chip 0x6050 */
+		n1_control: control@0,0 {
+			compatible = "pci106b,1900";
+			reg = <0x10000 0x0 0x0 0x0 0x0>;
+			firmware-name = "apple/centauri/j716c-ftab.bin";
+			apple,centauri-platform-id = <0x000e6050>;
+			apple,centauri-protocol = <27>;
+		};
+
+		n1_alpha: wifi@0,1 {
+			compatible = "pci106b,1902";
+			reg = <0x10100 0x0 0x0 0x0 0x0>;
+			local-mac-address = [00 00 00 00 00 00];
+		};
+
+		n1_beta: bluetooth@0,2 {
+			compatible = "pci106b,1903";
+			reg = <0x10200 0x0 0x0 0x0 0x0>;
+			local-bd-address = [00 00 00 00 00 00];
+		};
+	};
+};
+
+/* ATC1, ATC3 and the PD controller buses nub-spmi-a0 and -a2: not yet described for this board */
+&nub_spmi_a0 {
+	status = "disabled";
+};
+
+&nub_spmi_a2 {
+	status = "disabled";
+};
+
+&atc1_phy_mbox {
+	status = "disabled";
+};
+
+&atc1_phy {
+	status = "disabled";
+};
+
+&usb_drd1 {
+	status = "disabled";
+};
+
+&usb_drd1_dart_0 {
+	status = "disabled";
+};
+
+&usb_drd1_dart_1 {
+	status = "disabled";
+};
+
+&atc3_phy_mbox {
+	status = "disabled";
+};
+
+&atc3_phy {
+	status = "disabled";
+};
+
+&usb_drd3 {
+	status = "disabled";
+};
+
+&usb_drd3_dart_0 {
+	status = "disabled";
+};
+
+&usb_drd3_dart_1 {
+	status = "disabled";
+};
+
+&i2c1 {
+	status = "disabled";
+};
+
+&i2c2 {
+	status = "disabled";
+};
+
+/*
+ * Pin 112's register (0x29c0001c0) takes an SError when read, so only the pins a node
+ * here names are exposed: 80 (PCIe port 0's PERST#, ADT pci-bridge0 function-perst).
+ * A reserved line cannot be requested, so a node that names a new pin opens it here too.
+ */
+&pinctrl_ap {
+	gpio-reserved-ranges = <0 80>, <81 140>;
+};
+
+/* This board's SMC fan and power keys are not yet checked */
+&smc_hwmon {
+	status = "disabled";
+};
+
+/*
+ * The console is on the USB debug link, which drains only while a host reads
+ * it; the machine also boots with nothing attached there.
+ */
+&dockchannel {
+	apple,tx-never-wait;
+	status = "okay";
+};
+
+/* The keyboard and trackpad: the HID transport on the MTP's DockChannel FIFO */
+&mtp_dockchannel {
+	mtp_hid: input@8000 {
+		compatible = "apple,dockchannel-hid";
+		reg = <0x8000 0x1000>, <0xc000 0x1000>,
+		      <0x0 0x1000>, <0x4000 0x1000>;
+		reg-names = "config", "data", "rmt-config", "rmt-data";
+		iommus = <&mtp_dart 0>;
+		interrupt-parent = <&mtp_dockchannel>;
+		interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
+			     <3 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "tx", "rx";
+		apple,fifo-size = <0x800>;
+		apple,helper-cpu = <&mtp>;
+		apple,afe-reset-gpios = <&smc_pcio 2 GPIO_ACTIVE_HIGH>;
+
+		multi-touch {
+			apple,power-method = <2>;
+			firmware-name = "apple/tpmtfw-j716c.bin";
+		};
+
+		keyboard {
+		};
+
+		stm {
+		};
+	};
+};
+
+/* This board's PCIO outputs, the trackpad AFE reset (2) among them */
+&smc_pcio {
+	apple,output-commands = /bits/ 64 <0x001a000000000000 0x000f000000800000 0x011c000000010000>;
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-j716s.dts b/arch/arm64/boot/dts/apple/t6050-j716s.dts
new file mode 100644
index 000000000..7035fd101
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-j716s.dts
@@ -0,0 +1,960 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * MacBook Pro (16-inch, M5 Pro, 2026)
+ *
+ * target-type: J716s (Mac17,8)
+ *
+ * One T6050 die. The runtime ADT lists all 18 CPUs (cpu0-17) in the order
+ * t6050-max.dtsi uses, so its CPU list applies unchanged; the boot loader
+ * removes any core it did not start. Like t6050-j716c.dts, this file only
+ * enables and configures what has been brought up; the SoC's other blocks
+ * stay disabled.
+ *
+ * Tags in the comments: [ADT] the J716s runtime ADT, [J716C] as
+ * t6050-j716c.dts because the J716s ADT shows the same value, [OURS] the
+ * m5pro-linux J716s tree, [INFER] inferred, not measured.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+/dts-v1/;
+
+#include <dt-bindings/leds/common.h>
+#include "t6050-max.dtsi"
+
+/ {
+	/* [ADT] /product sub-product-type "Mac17,8", product-name "MacBook Pro (16-inch, M5 Pro)" */
+	compatible = "apple,j716s", "apple,t6050", "apple,arm-platform";
+	model = "Apple MacBook Pro (16-inch, M5 Pro, 2026)";
+	chassis-type = "laptop";
+
+	aliases {
+		serial0 = &dockchannel;			/* [J716C] */
+		/* The loader fills the N1's factory addresses through these [J716C] */
+		wifi0 = &n1_alpha;
+		bluetooth0 = &n1_beta;
+		/* m1n1 dt_set_ipd() fills the layout from the ADT keyboard node [OURS t6050-j716s.dts:21-25] */
+		keyboard = &keyboard;
+		/* m1n1 dt_set_gpu_t6050() fills the GPU hand-off, opt-in (see the GPU nodes below) */
+		gpu = &gpu;
+	};
+
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		/* Normally replaced by the loader */
+		bootargs = "maxcpus=1";
+
+		framebuffer0: framebuffer@0 {
+			compatible = "apple,simple-framebuffer", "simple-framebuffer";
+			reg = <0 0 0 0>; /* To be filled by the loader */
+			/* Format properties will be added by the loader */
+			/* simpledrm reports an eDP connector for the built-in panel */
+			apple,internal-panel;
+			status = "disabled";
+		};
+	};
+
+	/*
+	 * Keyboard backlight. [ADT] /arm-io/pwm0/kbd-backlight: channel 0,
+	 * default-hz 25000 -> period 40000 ns. [OURS t6050-j716s.dts:35-46]
+	 */
+	led-controller {
+		compatible = "pwm-leds";
+
+		led-0 {
+			pwms = <&fpwm0 0 40000>;
+			label = "kbd_backlight";
+			function = LED_FUNCTION_KBD_BACKLIGHT;
+			color = <LED_COLOR_ID_WHITE>;
+			max-brightness = <255>;
+			default-state = "keep";
+		};
+	};
+
+	/*
+	 * The sound card: the headphone jack on AOP DAI 0 (cout), the six
+	 * speaker amps on AOP DAI 4 (spkr) in [ADT] speakerN order: LW1, RW1,
+	 * LW2, RW2, LT, RT (TDM slots 0-5). The idle masks keep each bus's
+	 * three amps fed with zeros in the other bus's slots.
+	 */
+	sound {
+		compatible = "apple,j716-macaudio", "apple,macaudio";
+		model = "MacBook Pro J716";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		dai-link@0 {
+			reg = <0>;
+			link-name = "Headphone Jack";
+
+			cpu {
+				sound-dai = <&aop_audio 0>;
+			};
+
+			codec {
+				sound-dai = <&jack_codec>;
+			};
+		};
+
+		dai-link@1 {
+			reg = <1>;
+			link-name = "Speakers";
+			dai-tdm-idle-mode-0 = "zero";
+			dai-tdm-idle-mode-1 = "zero";
+			dai-tdm-slot-tx-idle-mask-0 = <0xf0f0f0>;
+			dai-tdm-slot-tx-idle-mask-1 = <0x0f0f0f>;
+
+			cpu {
+				sound-dai = <&aop_audio 4>;
+			};
+
+			codec {
+				sound-dai = <&speaker_lw1>, <&speaker_rw1>,
+					    <&speaker_lw2>, <&speaker_rw2>,
+					    <&speaker_lt>, <&speaker_rt>;
+			};
+		};
+	};
+};
+
+/*
+ * Blocks t6050-die0.dtsi does not describe yet (candidates for that file):
+ * the keyboard backlight PWM, the ATC0 gadget this board's tether runs on,
+ * and the third HPM SPMI bus.
+ */
+&die0 {
+	/* [ADT] /arm-io/pwm0 reg 0x505040000 +0x4000, clock-gate FPWM0 [OURS t6050.dtsi:303-315] */
+	fpwm0: pwm@505040000 {
+		compatible = "apple,t6050-fpwm", "apple,s5l-fpwm";
+		reg = <0x5 0x05040000 0x0 0x4000>;
+		power-domains = <&ps_fpwm0>;
+		clocks = <&clkref>;
+		#pwm-cells = <2>;
+	};
+
+	/*
+	 * ATC0 (left-back, the MagSafe side; [ADT] usb-drd0 port-number 1, hpm0
+	 * port-location "left-back"). The combo PHY driver refuses port 0, and this
+	 * port carries the USB tether, so it stays a device-mode controller on the
+	 * PHY state m1n1's usb_phy_bringup() leaves. [OURS t6050-storage-net.dtsi:50-88]
+	 * [ADT] /arm-io/usb-drd0 reg[0] 0x2a2280000, interrupts[0] 1419;
+	 * /arm-io/dart-usb0 reg[0] 0x2a2f00000, reg[1] 0x2a2f80000, interrupt 1423.
+	 */
+	dwc3_0: usb@2a2280000 {
+		compatible = "snps,dwc3";
+		reg = <0x2 0xa2280000 0x0 0xcd00>;
+		interrupts = <AIC_IRQ 0 1419 IRQ_TYPE_LEVEL_HIGH>;
+		dr_mode = "peripheral";
+		maximum-speed = "high-speed";
+		iommus = <&dwc3_0_dart_0 0>, <&dwc3_0_dart_1 1>;
+		snps,usb2-gadget-lpm-disable;
+		snps,dis_u2_susphy_quirk;
+		snps,dis_u3_susphy_quirk;
+		snps,dis_enblslpm_quirk;
+	};
+
+	dwc3_0_dart_0: iommu@2a2f00000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0xa2f00000 0x0 0xc000>;
+		interrupts = <AIC_IRQ 0 1423 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+
+	dwc3_0_dart_1: iommu@2a2f80000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0xa2f80000 0x0 0xc000>;
+		interrupts = <AIC_IRQ 0 1423 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+	};
+
+	/*
+	 * [ADT] /arm-io/nub-spmi-a1: reg[0] 0x8a1a8000 (+0x200000000), gen 4, the
+	 * HPM bus of the right-hand port (hpm2). J716c uses nub-spmi-a2 instead;
+	 * this board has no a2. Polled, like a0: the gen 4 driver refuses an
+	 * interrupt (the ADT lists AIC 763 for it, 761 for a0). No power-domains:
+	 * [ADT] pmgr NUB_SPMI_A1 (group 2 +0x68) is critical, as NUB_SPMI_A0.
+	 */
+	nub_spmi_a1: spmi@28a1a8000 {
+		compatible = "apple,t6050-spmi", "apple,t8142-spmi";
+		reg = <0x2 0x8a1a8000 0x0 0x4000>;
+		#address-cells = <2>;
+		#size-cells = <0>;
+	};
+};
+
+/* [ADT] pmgr device FPWM0, group 1 + 0x2a8 [OURS t6050-pmgr.dtsi:952-959]; parent SIO left undescribed as for ps_i2c1/2 */
+&pmgr1 {
+	ps_fpwm0: power-controller@2a8 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x2a8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "fpwm0";
+	};
+};
+
+/*
+ * PCIe port 0: the N1 (Wi-Fi and Bluetooth). Port 1 is the SD reader
+ * ([ADT] apcie0/pci-bridge1/pcie-sdreader), not described. The loader must
+ * train port 0 and then enable port00 and dart_apcie0; until it does, both
+ * stay disabled. m1n1 does not do this today.
+ * [ADT] /arm-io/apcie0 reg[0] 0x1cb0000000, reg[1] 0x414000000 (rc),
+ * reg[16] 0x410028000 (port0), reg[18] 0x417010000 (phy0), reg[19]
+ * 0x410024000 (intr2axi0), interrupts[0] 1523: identical to J716c.
+ */
+&pcie0 {
+	reg = <0x1c 0xb0000000 0x0 0x10000000>,
+	      <0x4 0x14000000 0x0 0x4000>,
+	      <0x4 0x10028000 0x0 0x8000>,
+	      <0x4 0x17010000 0x0 0x4000>,
+	      <0x4 0x10024000 0x0 0x4000>;
+	reg-names = "config", "rc", "port0", "phy0", "intr2axi0";
+	interrupts = <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>;
+	interrupt-names = "port0";
+
+	/* The N1's three functions are on DART streams 1-3 [J716C] */
+	iommu-map = <0x100 &dart_apcie0 1 3>;
+	bus-range = <0 4>;
+
+	port00: pci@0,0 {
+		device_type = "pci";
+		reg = <0x0 0 0 0 0>;
+		bus-range = <1 1>;
+		apple,link-trained-by-bootloader;
+		/* PERST#: [ADT] pci-bridge0 function-perst = GPIO 80 */
+		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
+		status = "disabled";
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
+				<0 0 0 2 &port00 0 0 0 1>,
+				<0 0 0 3 &port00 0 0 0 2>,
+				<0 0 0 4 &port00 0 0 0 3>;
+
+		/*
+		 * platform ID = (board << 16) | chip: [ADT] /chosen board-id = 0x0c,
+		 * chip 0x6050 (binding apple,centauri.yaml: chip in bits 15..0,
+		 * board in 30..16). The FTAB is personalised for each unit; its name
+		 * follows J716c's scheme [INFER].
+		 */
+		n1_control: control@0,0 {
+			compatible = "pci106b,1900";
+			reg = <0x10000 0x0 0x0 0x0 0x0>;
+			firmware-name = "apple/centauri/j716s-ftab.bin";
+			apple,centauri-platform-id = <0x000c6050>;
+			apple,centauri-protocol = <27>;
+		};
+
+		/* [ADT] apcie0/pci-bridge0/centauri-alpha (fn 1) */
+		n1_alpha: wifi@0,1 {
+			compatible = "pci106b,1902";
+			reg = <0x10100 0x0 0x0 0x0 0x0>;
+			local-mac-address = [00 00 00 00 00 00];
+		};
+
+		/* [ADT] apcie0/pci-bridge0/centauri-beta (fn 2) */
+		n1_beta: bluetooth@0,2 {
+			compatible = "pci106b,1903";
+			reg = <0x10200 0x0 0x0 0x0 0x0>;
+			local-bd-address = [00 00 00 00 00 00];
+		};
+	};
+};
+
+/*
+ * Type-C. [ADT] port map:
+ *   ATC0 usb-drd0 port 1 left-back  hpm0 nub-spmi-a0 SID 0x0c  (tether, dwc3_0 above)
+ *   ATC1 usb-drd1 port 2 left-front hpm1 nub-spmi-a0 SID 0x0a
+ *   ATC2 usb-drd2 port 3 right      hpm2 nub-spmi-a1 SID 0x0c
+ *   MagSafe                          hpm5 nub-spmi-a0 SID 0x08 (port-type 17, not a USB-C connector)
+ * There is no usb-drd3 in this ADT, so ATC3's USB chain stays off.
+ */
+&atc3_phy_mbox {
+	status = "disabled";
+};
+
+&atc3_phy {
+	status = "disabled";
+};
+
+&usb_drd3 {
+	status = "disabled";
+};
+
+&usb_drd3_dart_0 {
+	status = "disabled";
+};
+
+&usb_drd3_dart_1 {
+	status = "disabled";
+};
+
+&nub_spmi_a2 {
+	status = "disabled";			/* [ADT] this board has no nub-spmi-a2 */
+};
+
+/*
+ * Left-front port (ATC1): SN201202x hpm1, polled (no interrupts property),
+ * the connector graph into dwc3 (USB2) and the combo PHY (SuperSpeed).
+ * Node shape from t8142-j813-usb.dtsi. USB3 works on this port with the
+ * PHY tunables the loader fills from the ADT (m1n1 kboot_atc).
+ */
+&nub_spmi_a0 {
+	hpm1: usb-pd@a {
+		compatible = "apple,sn201202x";
+		reg = <0xa SPMI_USID>;			/* [ADT] hpm1 reg[0] = 0x0a */
+
+		typec1: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Left-front";	/* [ADT] hpm1 port-location */
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					typec1_hs: endpoint {
+						remote-endpoint = <&usb_drd1_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					typec1_ss: endpoint {
+						remote-endpoint = <&atc1_phy_typec>;
+					};
+				};
+			};
+		};
+	};
+};
+
+&usb_drd1 {
+	port {
+		usb_drd1_hs: endpoint {
+			remote-endpoint = <&typec1_hs>;
+		};
+	};
+};
+
+&atc1_phy {
+	port {
+		atc1_phy_typec: endpoint {
+			remote-endpoint = <&typec1_ss>;
+		};
+	};
+};
+
+/*
+ * Right port (ATC2), the same chain as the left-front port: SN201202x hpm2
+ * on nub_spmi_a1, polled; the connector graph into usb_drd2 (USB2) and the
+ * combo PHY (SuperSpeed). [ADT] /arm-io/nub-spmi-a1/hpm2 reg[0] = 0x0c,
+ * port-number 3, port-location "right", acio-parent acio2; atc-phy2 and
+ * usb-drd2 port-number 3. Only the USB route: dcpext0's DisplayPort route
+ * through ATC2 (atc2_xbar, the PHY's DP lane, the connector's DP port)
+ * stays off, so the connector has no port@2.
+ */
+&nub_spmi_a1 {
+	hpm2: usb-pd@c {
+		compatible = "apple,sn201202x";
+		reg = <0xc SPMI_USID>;			/* [ADT] hpm2 reg[0] = 0x0c */
+
+		typec2: connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Right";		/* [ADT] hpm2 port-location */
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					typec2_hs: endpoint {
+						remote-endpoint = <&usb_drd2_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					typec2_ss: endpoint {
+						remote-endpoint = <&atc2_phy_typec>;
+					};
+				};
+			};
+		};
+	};
+};
+
+/*
+ * [ADT] /arm-io/atc-phy2 reg[2] 0x183000000 (core), acio-phy-cpu2 reg[0]
+ * 0x183148000 with interrupts 861-864, usb-drd2 interrupt 1483, dart-usb2
+ * interrupt 1487 (arm-io ranges +0x200000000): what t6050-die0.dtsi
+ * describes. Power: [ADT] pmgr ATC2_COMMON (group 0 +0x238, gate 61, parent
+ * FAB5_SOC, critical), ATC2_USB_AON (group 2 +0x178, 266), ATC2_USB (+0x180,
+ * 267, usb-drd2's gate) and ATC2_PHYMXWRAP (+0x188, 268), parents 61 and
+ * 266, as ATC1's 56/263-265. The loader fills the PHY's tunables (it finds
+ * the node by its core window) and parks the PIPE of every usb-drdN.
+ */
+&ps_atc2_common {
+	status = "okay";
+};
+
+&ps_atc2_usb_aon {
+	status = "okay";
+};
+
+&ps_atc2_phymxwrap {
+	status = "okay";
+};
+
+&ps_atc2_usb {
+	status = "okay";
+};
+
+&atc2_phy_mbox {
+	status = "okay";
+};
+
+&atc2_phy {
+	status = "okay";
+
+	port {
+		atc2_phy_typec: endpoint {
+			remote-endpoint = <&typec2_ss>;
+		};
+	};
+};
+
+&usb_drd2 {
+	status = "okay";
+
+	port {
+		usb_drd2_hs: endpoint {
+			remote-endpoint = <&typec2_hs>;
+		};
+	};
+};
+
+&usb_drd2_dart_0 {
+	status = "okay";
+};
+
+&usb_drd2_dart_1 {
+	status = "okay";
+};
+
+/*
+ * Audio. [ADT] six SN012776 amps (TAS2764 family) on i2c1 (left: woofers 1
+ * and 2, tweeter) and i2c3 (right), the CS42L84 jack codec on i2c2, all
+ * clocked by the AOP's serializer; the AOP runs the speaker and jack streams
+ * and the microphone array. Node shapes follow edimoldovan's J714c tree
+ * (linux-aurora t6050-j714c). i2c3, its power state, the AOP's setup port
+ * and the LEAP-S ADMAC are not in t6050-die0.dtsi yet (candidates for it);
+ * they are described here, as is everything this board enables.
+ */
+&die0 {
+	/* [ADT] /arm-io/i2c3 reg 0x50501c000 (+0x4000), interrupt 1378 */
+	i2c3: i2c@50501c000 {
+		compatible = "apple,t6050-i2c", "apple,t8103-i2c";
+		reg = <0x5 0x0501c000 0x0 0x4000>;
+		clocks = <&clkref>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 0 1378 IRQ_TYPE_LEVEL_HIGH>;
+		#address-cells = <1>;
+		#size-cells = <0>;
+		power-domains = <&ps_i2c3>;
+	};
+
+	/*
+	 * The AOP's setup port, which its AFK endpoints answer only after:
+	 * [ADT] /arm-io/aop-exclave-mailbox reg 0x2d067c000, interrupts 582
+	 * (send-empty) and 585 (recv-not-empty), messages through dart-aop
+	 * stream 1, whose window starts at 0x20000000000.
+	 */
+	aop_setup_mbox: mailbox@2d067c000 {
+		compatible = "apple,t6050-aop-setup-mailbox",
+			     "apple,t8140-aop-setup-mailbox";
+		reg = <0x2 0xd067c000 0x0 0x4000>;
+		interrupt-parent = <&aic>;
+		interrupts = <AIC_IRQ 0 582 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 585 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "recv-not-empty";
+		iommus = <&aop_dart 1>;
+		apple,dma-range = <0x200 0x0 0x10 0x0>;
+		#mbox-cells = <0>;
+	};
+
+	/*
+	 * The LEAP-S ADMAC through its non-secure proxy: [ADT]
+	 * admac-hp-mic-ec-proxy reg 0x2d3200000, interrupt 638, 9 TX and 9 RX
+	 * channels, dart-aop stream 11. The microphone array is on its RX 0.
+	 */
+	admac_leap_s: dma-controller@2d3200000 {
+		compatible = "apple,t6050-admac", "apple,t8140-admac";
+		reg = <0x2 0xd3200000 0x0 0x34000>;
+		dma-channels = <9>;
+		interrupts-extended = <&aic AIC_IRQ 0 638 IRQ_TYPE_LEVEL_HIGH>,
+				      <0>, <0>, <0>;
+		#dma-cells = <1>;
+		iommus = <&aop_dart 11>;
+		apple,dma-range = <0x110 0x00000000 0x0 0x10000000>;
+	};
+};
+
+/* [ADT] pmgr device I2C3, group 1 + 0x2d8, after I2C1 (+0x2c8) and I2C2 (+0x2d0) */
+&pmgr1 {
+	ps_i2c3: power-controller@2d8 {
+		compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+		reg = <0x2d8 4>;
+		#power-domain-cells = <0>;
+		#reset-cells = <0>;
+		label = "i2c3";
+	};
+};
+
+&aop_mbox {
+	status = "okay";
+};
+
+/*
+ * dart-aop: iBoot locks it with inherited roots; the T8142 compatible
+ * selects apple-dart's per-stream retained-root path, as on the J714c.
+ */
+&aop_dart {
+	compatible = "apple,t6050-dart", "apple,t8142-dart", "apple,t8110-dart";
+	status = "okay";
+};
+
+&admac_base_ns {
+	status = "okay";
+};
+
+&aop {
+	mboxes = <&aop_mbox>, <&aop_setup_mbox>;
+	mbox-names = "mbox", "setup";
+	status = "okay";
+};
+
+/*
+ * [ADT] iop-audio-controller: spkr on base-ns TX0 with the amps' V/I sense
+ * on RX0, cout/cin (the jack) on TX2/RX2 (Linux channel 2N for TX N, 2N+1
+ * for RX N), and the microphone array on LEAP-S RX0 (leap-s-adma-rx-0).
+ */
+&aop_audio {
+	dmas = <&admac_base_ns 0>, <&admac_base_ns 1>,
+	       <&admac_base_ns 4>, <&admac_base_ns 5>,
+	       <&admac_leap_s 1>;
+	dma-names = "spkr", "spkr-sense", "cout", "cin", "hpai";
+	apple,chassis-name = "J716";
+	apple,machine-kind = "MacBook Pro";
+};
+
+/*
+ * The amps share one shutdown line (SDZ, [ADT] AP GPIO 107, active high) and
+ * one level-low interrupt (AP GPIO 106). apple,speaker-config is [ADT]
+ * speaker-config: TX slot, amp level, V sense slot, I sense slot; the amp
+ * level is lowered from the ADT's 15 (18.5 dBV) to 10 (16 dBV), and macaudio
+ * caps the speaker volume at -30 dB on top of that. apple,deferred-shutdown:
+ * the AOP stops its serializer (pw0) only after ASoC has muted the amps, so
+ * a muted amp then sees its clock stop; this marks that as expected.
+ */
+&i2c1 {
+	status = "okay";
+
+	speaker_lw1: codec@38 {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x38>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Woofer 1";
+		ti,imon-slot-no = <0>;
+		ti,vmon-slot-no = <2>;
+		apple,speaker-config = [00 0a 00 02];
+		apple,deferred-shutdown;
+	};
+
+	speaker_lw2: codec@39 {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x39>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Woofer 2";
+		ti,imon-slot-no = <8>;
+		ti,vmon-slot-no = <10>;
+		apple,speaker-config = [02 0a 08 0a];
+		apple,deferred-shutdown;
+	};
+
+	speaker_lt: codec@3a {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3a>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Left Tweeter";
+		ti,imon-slot-no = <16>;
+		ti,vmon-slot-no = <18>;
+		apple,speaker-config = [04 0a 10 12];
+		apple,deferred-shutdown;
+	};
+};
+
+/* The jack codec: reset [ADT] AP GPIO 139, interrupt AP GPIO 134 (level low) */
+&i2c2 {
+	status = "okay";
+
+	jack_codec: codec@4b {
+		compatible = "cirrus,cs42l84";
+		reg = <0x4b>;
+		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Jack";
+	};
+};
+
+&i2c3 {
+	speaker_rw1: codec@3b {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3b>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Woofer 1";
+		ti,imon-slot-no = <4>;
+		ti,vmon-slot-no = <6>;
+		apple,speaker-config = [01 0a 04 06];
+		apple,deferred-shutdown;
+	};
+
+	speaker_rw2: codec@3c {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3c>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Woofer 2";
+		ti,imon-slot-no = <12>;
+		ti,vmon-slot-no = <14>;
+		apple,speaker-config = [03 0a 0c 0e];
+		apple,deferred-shutdown;
+	};
+
+	speaker_rt: codec@3d {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x3d>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Right Tweeter";
+		ti,imon-slot-no = <20>;
+		ti,vmon-slot-no = <22>;
+		apple,speaker-config = [05 0a 14 16];
+		apple,deferred-shutdown;
+	};
+};
+
+/*
+ * Pin 112 takes an SError when read (J716c finding, same SoC), so only the
+ * pins named here are exposed: 80 (PCIe port 0's PERST#, [ADT] pci-bridge0
+ * function-perst GPIO 80), 106 and 107 (the amps' interrupt and shutdown
+ * line), 134 and 139 (the jack codec's interrupt and reset), the pattern of
+ * t6050-j775d.dts.
+ */
+&pinctrl_ap {
+	gpio-reserved-ranges = <0 80>, <81 25>, <108 26>, <135 4>, <140 81>;
+};
+
+/*
+ * SMC sensors: the shared fan, power, voltage and current keys, and every
+ * readable float T* key through t6050-die0.dtsi's apple,discover-temperatures
+ * (labelled with the key name). Key set from the T6050 J714s SMC dump [OURS
+ * smc-keys-j714s.json]: F0Ac/F1Ac, F0Mn/F0Mx/F0Tg and F1*, PSTR, PDTR, PMVR,
+ * PHPC, VD0R, SBAV, ID0R present; a key this SMC lacks drops only that
+ * channel (macsmc-hwmon skips it).
+ *
+ * Discovery refuses to run once any temperature channel exists, so the
+ * shared temperature nodes go (their keys are discovered anyway: TH0x,
+ * TB0T, TCHP, TW0P), and so does the die0 apple,soc-die-keys list, whose
+ * "SoC die TCMb" channel would also count: with this driver the probe
+ * fails with -EINVAL otherwise. TCMb stays as a discovered channel; only
+ * the macsmc_soc_die thermal zone, which nothing in this DT uses, is lost.
+ * Drop the /delete-property/ once the driver has Aurora's b7891bd5f621
+ * ("hwmon: macsmc: Let discovered temperatures join the SoC die zone").
+ */
+#include "hwmon-common.dtsi"
+#include "hwmon-fan-dual.dtsi"
+#include "hwmon-laptop.dtsi"
+
+&smc_hwmon {
+	/delete-property/ apple,soc-die-keys;
+	/delete-node/ temperature-TH0x;
+	/delete-node/ temperature-TB0T;
+	/delete-node/ temperature-TCHP;
+	/delete-node/ temperature-TW0P;
+
+	/*
+	 * The T6050 SMC spells the fan mode keys F0md/F1md (ui8, flags 0xd0),
+	 * not the F0Md/F1Md of hwmon-fan*.dtsi, as on the J775D. No
+	 * apple,fan-manual-control: the SMC drives the fans and userspace only
+	 * reads them (macsmc_hwmon.fan_control=1 opens fan*_target for tests).
+	 */
+	fan-F0Ac {
+		apple,fan-mode = "F0md";
+	};
+
+	fan-F1Ac {
+		apple,fan-mode = "F1md";
+	};
+};
+
+/* The die's CIO reconfiguration register; no consumer is enabled yet */
+&cio_reconfig0 {
+	status = "okay";
+};
+
+/*
+ * The console on the USB debug link drains only while a host reads it
+ * [J716C]. On this board the tether is ATC0's gadget; keep earlycon=efifb.
+ */
+&dockchannel {
+	apple,tx-never-wait;
+	status = "okay";
+};
+
+/*
+ * Keyboard and trackpad: the HID transport on the MTP's DockChannel FIFO
+ * [J716C], with MTP firmware AppleMTPFirmwareMac-6320.86.1.
+ */
+&mtp_dockchannel {
+	mtp_hid: input@8000 {
+		compatible = "apple,dockchannel-hid";
+		reg = <0x8000 0x1000>, <0xc000 0x1000>,
+		      <0x0 0x1000>, <0x4000 0x1000>;
+		reg-names = "config", "data", "rmt-config", "rmt-data";
+		iommus = <&mtp_dart 0>;
+		interrupt-parent = <&mtp_dockchannel>;
+		interrupts = <2 IRQ_TYPE_LEVEL_HIGH>,
+			     <3 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "tx", "rx";
+		apple,fifo-size = <0x800>;		/* [ADT] dockchannel-mtp fifo-size 2048 [OURS] */
+		apple,helper-cpu = <&mtp>;
+		/*
+		 * The AFE reset: [ADT] multi-touch function-afe-reset is the SMC pcIO
+		 * output (0x10000, 0x11c0000), as on J716c, but this tree has no
+		 * apple,smc-pcio-gpio driver. The same line is SMC GPIO gp1c, active
+		 * low, which gpio-macsmc drives ("Touch MT ready" on 3 of 3 boots).
+		 */
+		apple,afe-reset-gpios = <&smc_gpio_low 28 GPIO_ACTIVE_LOW>;
+
+		multi-touch {
+			apple,power-method = <2>;	/* [OURS] 6320.x accepts only method 2 */
+			firmware-name = "apple/tpmtfw-j716s.bin";	/* [OURS t6050-j716s.dts:79] */
+		};
+
+		keyboard: keyboard {
+			hid-country-code = <0>;		/* filled by m1n1 [OURS] */
+			apple,keyboard-layout-id = <0>;
+		};
+
+		stm {
+		};
+
+		/* [ADT] mtp-transport children actuator and tp-accel; optional */
+		actuator {
+		};
+
+		tp-accel {
+		};
+	};
+};
+
+/*
+ * No driver here handles the SMC pcIO outputs (apple,smc-pcio-gpio), and the
+ * AFE reset above uses gp1c instead, so the node goes. Its J716s templates
+ * [ADT], pKW8('pcIO', lo, hi) as (hi << 32) | lo, are identical to J716c's:
+ *   0 dp2hdmi-gpio0 dp2hdmi_pwr_en (0x0, 0x1a0000)
+ *   1 dp2hdmi-gpio0 hdmi_pwr_en    (0x800000, 0xf0000)
+ *   2 multi-touch   afe-reset      (0x10000, 0x11c0000)
+ */
+/delete-node/ &smc_pcio;
+
+/*
+ * GPU (G17S, 2 x 10 cores) for aurora-silicon/linux's G17 M5 driver (apple,agx-g17s).
+ *
+ * Everything here is disabled. The loader enables it only on request: m1n1
+ * dt_set_gpu_t6050(), with the payload variable chosen.m5pro,gpu=1, fills in the six
+ * regions and the mailbox windows from the ADT of that boot, checks the rest against the
+ * ADT, and only then sets the regions, the mailboxes, &gpu and &pmgr_gfx okay. Without it
+ * no node below probes, and the PMGR group 3 registers stay untouched by Linux.
+ *
+ * Addresses from the J716s runtime ADT [ADT] (arm-io + 0x2_0000_0000):
+ *   sgx       /arm-io/sgx reg[0]        0x23_0000_0000 + 0x3fdc000
+ *   gfx-asc   reg[0..1]  0x23_0260_0000 + 0x88000, 0x23_0205_0000 + 0x8, role GFX,
+ *             interrupts 2798, 2797, 2800, 2799
+ *   gfx1-asc  reg[0..1]  0x23_02e0_0000 + 0x88000, 0x23_0285_0000 (+0x60000 in the ADT; the
+ *             mailbox driver maps exactly 8 bytes), role GFX1, interrupts 2802, 2801, 2804, 2803
+ *   power     pmgr reg[51] 0x23_00e8_0000 + 0x30000 (PS group 3): GPX +0x0, AFR +0x100,
+ *             CS +0x108 (parent AFR), GFX +0x110 (parents AFR, GPX; notify_pmp, id1 16)
+ * The send-empty / recv-not-empty choice (2797/2800, 2801/2804) is edimoldovan's J714c
+ * mapping, which booted RTKit there.
+ *
+ * The mailboxes use the native-address ASCWrap v6 profile of drivers/soc/apple/mailbox.c
+ * (apple,t6050-native-ascwrap-v6), whose role table holds these windows; with the hand-off
+ * the GPU driver can start both coprocessors through them.
+ */
+/ {
+	reserved-memory {
+		/* All six filled in per boot by the loader from the ADT (sgx and segment-ranges). */
+		gpu_fw_text: gpu-fw-text {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		gpu_fw_data: gpu-fw-data {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_ttbs: uat-ttbs {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_pagetables: uat-pagetables {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_l2_pagetables: uat-l2-pagetables {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+
+		uat_handoff: uat-handoff {
+			reg = <0 0 0 0>;
+			no-map;
+			status = "disabled";
+		};
+	};
+
+	/* The GPU block, outside die 0's MMIO range: arm-io's second range maps it 1:1. */
+	soc@2300000000 {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges = <0x23 0x0 0x23 0x0 0x0 0x4000000>;
+		nonposted-mmio;
+
+		pmgr_gfx: power-management@2300e80000 {
+			compatible = "apple,t6050-pmgr", "apple,t8103-pmgr", "syscon", "simple-mfd";
+			#address-cells = <1>;
+			#size-cells = <1>;
+			reg = <0x23 0x00e80000 0x0 0x30000>;
+			status = "disabled";
+
+			ps_gpx: power-controller@0 {
+				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+				reg = <0x0 4>;
+				#power-domain-cells = <0>;
+				#reset-cells = <0>;
+				label = "gpx";
+				apple,always-on;	/* [ADT] critical */
+			};
+
+			ps_afr: power-controller@100 {
+				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+				reg = <0x100 4>;
+				#power-domain-cells = <0>;
+				#reset-cells = <0>;
+				label = "afr";
+				apple,always-on;	/* [ADT] critical */
+			};
+
+			ps_cs: power-controller@108 {
+				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+				reg = <0x108 4>;
+				#power-domain-cells = <0>;
+				#reset-cells = <0>;
+				label = "cs";
+				power-domains = <&ps_afr>;
+			};
+
+			ps_gfx: power-controller@110 {
+				compatible = "apple,t6050-pmgr-pwrstate", "apple,t8103-pmgr-pwrstate";
+				reg = <0x110 4>;
+				#power-domain-cells = <0>;
+				#reset-cells = <0>;
+				label = "gfx";
+				power-domains = <&ps_afr>, <&ps_gpx>;
+				/* As on J616/J700: the loaded firmware lives across sleep. */
+				apple,always-on;
+			};
+		};
+
+		gfx_mbox: mailbox@2302600000 {
+			compatible = "apple,t6050-native-ascwrap-v6";
+			reg = <0x23 0x02600000 0x0 0x88000>,	/* filled in by the loader */
+			      <0x23 0x02050000 0x0 0x8>;
+			reg-names = "wrapper", "iop-vbar";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 0 2797 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 0 2800 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "recv-not-empty";
+			apple,firmware-role = "GFX";
+			power-domains = <&ps_gfx>;
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
+		gfx1_mbox: mailbox@2302e00000 {
+			compatible = "apple,t6050-native-ascwrap-v6";
+			reg = <0x23 0x02e00000 0x0 0x88000>,	/* filled in by the loader */
+			      <0x23 0x02850000 0x0 0x8>;
+			reg-names = "wrapper", "iop-vbar";
+			interrupt-parent = <&aic>;
+			interrupts = <AIC_IRQ 0 2801 IRQ_TYPE_LEVEL_HIGH>,
+				     <AIC_IRQ 0 2804 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "send-empty", "recv-not-empty";
+			apple,firmware-role = "GFX1";
+			power-domains = <&ps_gfx>;
+			#mbox-cells = <0>;
+			status = "disabled";
+		};
+
+		gpu: gpu@2300000000 {
+			compatible = "apple,agx-g17s";
+			/* The G17 path maps only sgx; the coprocessor wrappers belong to the mailboxes. */
+			reg = <0x23 0x00000000 0x0 0x3fdc000>;
+			reg-names = "sgx";
+			mboxes = <&gfx_mbox>, <&gfx1_mbox>;
+			power-domains = <&ps_gfx>;
+			memory-region = <&uat_ttbs>, <&uat_pagetables>, <&uat_handoff>,
+					<&gpu_fw_data>, <&uat_l2_pagetables>, <&gpu_fw_text>;
+			memory-region-names = "ttbs", "pagetables", "handoff", "fw-data",
+					      "l2-pagetables", "fw-text";
+			/* No operating-points-v2: the M5 path takes its tables from the board table. */
+			status = "disabled";
+		};
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-j775d.dts b/arch/arm64/boot/dts/apple/t6050-j775d.dts
new file mode 100644
index 000000000..5c0b238dc
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-j775d.dts
@@ -0,0 +1,701 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Mac Studio (M5 Ultra, 2026)
+ *
+ * target-type: J775D
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+/dts-v1/;
+
+#include "t6050-ultra.dtsi"
+
+/ {
+	compatible = "apple,j775d", "apple,t6050", "apple,arm-platform";
+	model = "Apple Mac Studio (M5 Ultra, 2026)";
+	chassis-type = "desktop";
+
+	aliases {
+		serial0 = &dockchannel;
+		/* the boot loader fills in the MAC address through this alias */
+		ethernet0 = &ethernet0;
+		/* kboot fills the N1's factory addresses from /chosen through these */
+		wifi0 = &n1_alpha;
+		bluetooth0 = &n1_beta;
+		/* Aura's kboot_setup_atc() fills this PHY's tunables from /arm-io/atc-phy2. */
+		atcphy2 = &atc2_phy;
+		/* The same fills /arm-io/atc-phy1's (rear USB-C port 2, USB data). */
+		atcphy1 = &atc1_phy;
+		/* And rear port 4's and the front ports' (die 1), while their chains wait for the PHY. */
+		atcphy3 = &atc3_phy;
+		atcphy4 = &atc4_phy;
+		atcphy5 = &atc1_phy_die1;
+		/* Aura's ACIO tunable copy fills rear port 4's router (/arm-io/acio3) through these. */
+		usb4-3-acio = &usb4_3_acio;
+		usb4-3-nhi = &usb4_3_nhi;
+		/* asahi-bless and the boot loader's dt_set_nvram find the partition by this alias */
+		nvram = &nvram;
+	};
+
+	/*
+	 * No stdout-path: the boot loader passes the console on the command
+	 * line when it wants one.
+	 */
+	chosen {
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges;
+		/*
+		 * Normally replaced by the loader. With no console= named,
+		 * NULL_TTY_DEFAULT_CONSOLE makes the console ttynull.
+		 */
+		bootargs = "maxcpus=1 rdinit=/init";
+	};
+
+	/*
+	 * The jack (CS42L84) and the speaker (SN012776) through the AOP's audio services. The card waits
+	 * for its CPU component, the AOP audio node, which exists only after Aura's AOP handoff.
+	 */
+	sound {
+		compatible = "apple,j775d-macaudio", "apple,macaudio";
+		model = "Mac Studio J775D";
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		dai-link@0 {
+			reg = <0>;
+			link-name = "Headphone Jack";
+
+			cpu {
+				sound-dai = <&aop_audio 0>;
+			};
+
+			codec {
+				sound-dai = <&jack_codec>;
+			};
+		};
+
+		dai-link@1 {
+			reg = <1>;
+			link-name = "Speaker";
+
+			cpu {
+				sound-dai = <&aop_audio 3>;
+			};
+
+			codec {
+				sound-dai = <&speaker_amp>;
+			};
+		};
+	};
+};
+
+/*
+ * PCIe ports 2 (the onboard 10 Gb Ethernet) and 3 (the rear USB-A xHCI). The boot loader
+ * powers and trains both links; it disables a port, and its DART, whose link did not come up.
+ *
+ * Port 0 carries the N1 (Wi-Fi and Bluetooth), described disabled until the boot loader trains
+ * it (pci@0,0 below).
+ */
+&pcie0 {
+	reg = <0x1c 0xb0000000 0x0 0x10000000>,
+	      <0x4 0x14000000 0x0 0x4000>,
+	      <0x4 0x12028000 0x0 0x8000>,
+	      <0x4 0x17018000 0x0 0x4000>,
+	      <0x4 0x12024000 0x0 0x4000>,
+	      <0x4 0x13028000 0x0 0x8000>,
+	      <0x4 0x1701c000 0x0 0x4000>,
+	      <0x4 0x13024000 0x0 0x4000>,
+	      <0x4 0x10028000 0x0 0x8000>,
+	      <0x4 0x17010000 0x0 0x4000>,
+	      <0x4 0x10024000 0x0 0x4000>;
+	reg-names = "config", "rc", "port2", "phy2", "intr2axi2",
+		    "port3", "phy3", "intr2axi3",
+		    "port0", "phy0", "intr2axi0";
+	interrupts = <AIC_IRQ 0 1539 IRQ_TYPE_LEVEL_HIGH>,
+		     <AIC_IRQ 0 1547 IRQ_TYPE_LEVEL_HIGH>,
+		     <AIC_IRQ 0 1523 IRQ_TYPE_LEVEL_HIGH>;
+	interrupt-names = "port2", "port3", "port0";
+
+	/*
+	 * The boot loader numbers port 2's secondary bus 1 and port 3's 2;
+	 * port 0's is 3 until a boot loader that trains it renumbers all three
+	 * in the PCI core's order. The N1's three functions are on DART
+	 * streams 1-3.
+	 */
+	iommu-map = <0x100 &dart_apcie2 1 1>,
+		    <0x200 &dart_apcie3 1 1>,
+		    <0x300 &dart_apcie0 1 3>;
+	bus-range = <0 3>;
+
+	port02: pci@2,0 {
+		device_type = "pci";
+		reg = <0x1000 0 0 0 0>;
+		bus-range = <1 1>;
+		apple,link-trained-by-bootloader;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &port02 0 0 0 0>,
+				<0 0 0 2 &port02 0 0 0 1>,
+				<0 0 0 3 &port02 0 0 0 2>,
+				<0 0 0 4 &port02 0 0 0 3>;
+
+		/* The RTL8127A keeps no MAC address of its own */
+		ethernet0: ethernet@0,0 {
+			reg = <0x10000 0x0 0x0 0x0 0x0>;
+			/* To be filled by the loader */
+			local-mac-address = [00 00 00 00 00 00];
+		};
+	};
+
+	port03: pci@3,0 {
+		device_type = "pci";
+		reg = <0x1800 0 0 0 0>;
+		bus-range = <2 2>;
+		apple,link-trained-by-bootloader;
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &port03 0 0 0 0>,
+				<0 0 0 2 &port03 0 0 0 1>,
+				<0 0 0 3 &port03 0 0 0 2>,
+				<0 0 0 4 &port03 0 0 0 3>;
+	};
+
+	/*
+	 * The N1 Wi-Fi/Bluetooth (106b:1900, its ROM), trained by the bootloader after the SMC
+	 * releases its reset. Its driver boots the firmware and has this port reset after the ROM
+	 * stage; Control, Alpha (Wi-Fi) and Beta (Bluetooth) then answer at functions 0-2.
+	 * Disabled with its DART: a bootloader that trains the port enables both and renumbers the
+	 * buses here (bus-range, reg, iommu-map) to the PCI core's order, port 0 first.
+	 */
+	port00: pci@0,0 {
+		device_type = "pci";
+		reg = <0x0 0 0 0 0>;
+		bus-range = <3 3>;
+		apple,link-trained-by-bootloader;
+		/*
+		 * Its PERST# (pci-bridge0 function-perst): /arm-io/gpio0 pin 0x50, pad
+		 * register 0x140 of pinctrl_ap, which owns the pad (and exposes it: see
+		 * its gpio-reserved-ranges below). Driven only by the root-port reset after
+		 * the N1's ROM stage.
+		 */
+		reset-gpios = <&pinctrl_ap 80 GPIO_ACTIVE_LOW>;
+		status = "disabled";
+
+		#address-cells = <3>;
+		#size-cells = <2>;
+		ranges;
+
+		interrupt-controller;
+		#interrupt-cells = <1>;
+		interrupt-map-mask = <0 0 0 7>;
+		interrupt-map = <0 0 0 1 &port00 0 0 0 0>,
+				<0 0 0 2 &port00 0 0 0 1>,
+				<0 0 0 3 &port00 0 0 0 2>,
+				<0 0 0 4 &port00 0 0 0 3>;
+
+		/* The firmware: the chip's image with this board's ticket; platform ID is
+		 * (board 0x12 << 16) | chip 0x6050 */
+		n1_control: control@0,0 {
+			compatible = "pci106b,1900";
+			reg = <0x30000 0x0 0x0 0x0 0x0>;
+			firmware-name = "apple/centauri/j775d-ftab.bin";
+			apple,centauri-platform-id = <0x00126050>;
+			apple,centauri-protocol = <27>;
+		};
+
+		n1_alpha: wifi@0,1 {
+			compatible = "pci106b,1902";
+			reg = <0x30100 0x0 0x0 0x0 0x0>;
+			local-mac-address = [00 00 00 00 00 00];
+		};
+
+		n1_beta: bluetooth@0,2 {
+			compatible = "pci106b,1903";
+			reg = <0x30200 0x0 0x0 0x0 0x0>;
+			local-bd-address = [00 00 00 00 00 00];
+		};
+	};
+};
+
+/* The pins this board's nodes name, and no others */
+&pinctrl_ap {
+	/*
+	 * Every pin reads cleanly, but only
+	 * the pins a node in this file names are exposed: 80 (PCIe port 0's PERST#, ADT
+	 * pci-bridge0 function-perst), 106 (amp IRQ), 107 (amp shutdown), 134 (jack IRQ)
+	 * and 139 (jack codec reset), from the ADT's audio-speaker and audio-codec-output.
+	 * A reserved line cannot be requested (gpiolib answers -EINVAL), so a node that
+	 * names a new pin of pinctrl_ap opens it here too.
+	 */
+	gpio-reserved-ranges = <0 80>, <81 25>, <108 26>, <135 4>, <140 81>;
+};
+
+&i2c1 {
+	/*
+	 * ADT speaker-config: playback slot 0, amp gain 20, V sense in slot 0 and I sense
+	 * in slot 2. The firmware's speaker frame is 250 BCLKs of 12 MHz (ADT
+	 * iop-audio-controller/audio-speaker), which the amp's ratio detection rejects.
+	 */
+	speaker_amp: codec@38 {
+		compatible = "ti,sn012776", "ti,tas2764";
+		reg = <0x38>;
+		shutdown-gpios = <&pinctrl_ap 107 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 106 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		ti,imon-slot-no = <2>;
+		ti,vmon-slot-no = <0>;
+		ti,bclk-ratio = <250>;
+	};
+};
+
+&i2c2 {
+	jack_codec: codec@4b {
+		compatible = "cirrus,cs42l84";
+		reg = <0x4b>;
+		reset-gpios = <&pinctrl_ap 139 GPIO_ACTIVE_HIGH>;
+		interrupts-extended = <&pinctrl_ap 134 IRQ_TYPE_LEVEL_LOW>;
+		#sound-dai-cells = <0>;
+		sound-name-prefix = "Jack";
+	};
+};
+
+/*
+ * The console is on the USB debug link, which drains only while a host reads
+ * it; the machine also boots with nothing attached there.
+ */
+&dockchannel {
+	apple,tx-never-wait;
+	status = "okay";
+};
+
+&dart_apcie2 {
+	status = "okay";
+};
+
+&dart_apcie3 {
+	status = "okay";
+};
+
+/*
+ * The Studio's DC input. PSTR and PDTR read 0 on the Studio; PD0R is its DC input (36.5 W at an
+ * idle desktop).
+ */
+&smc_hwmon {
+	power-PD0R {
+		apple,key-id = "PD0R";
+		label = "DC Input Power";
+	};
+};
+
+#include "hwmon-fan-dual.dtsi"
+
+/*
+ * The Studio's SMC has F0Ac/F0Mn/F0Mx/F0Tg and F1*, but its mode keys are F0md/F1md (ui8, flags 0xd0:
+ * readable, writable, a function key), not the F0Md/F1Md the dtsi names; with the dtsi's names fan
+ * creation failed on the missing key. With the real keys the fans can be set by the kernel's
+ * thermal policy (the M5 GPU governor, through macsmc_hwmon_fans_request()). No
+ * apple,fan-manual-control: userspace still only reads them.
+ */
+&smc_hwmon {
+	fan-F0Ac {
+		apple,fan-mode = "F0md";
+	};
+
+	fan-F1Ac {
+		apple,fan-mode = "F1md";
+	};
+};
+
+/*
+ * The boot NOR's NVRAM: the loader fills the partition from ADT /arm-io/qspi/spinor/anvram reg
+ * (0x700000, 0xc0000 here), 12 banks of 64 KiB (/chosen nvram-bank-count, nvram-bank-size). The
+ * flash is spinor's CS0 (its reg's first cell; the second is 0x19, 25), clocked as on T8140's
+ * J700. Only this partition is exposed (no MTD_PARTITIONED_MASTER), so the rest of the boot NOR
+ * has no device node, and the controller's T8140 policy admits programs and erases only inside
+ * this partition.
+ */
+&qspi {
+	status = "okay";
+
+	flash@0 {
+		compatible = "jedec,spi-nor";
+		reg = <0>;
+		spi-max-frequency = <25000000>;
+		/* Single-wire, as on T8132's J713: no quad-enable status write at probe */
+		spi-rx-bus-width = <1>;
+		spi-tx-bus-width = <1>;
+
+		partitions {
+			compatible = "fixed-partitions";
+			#address-cells = <1>;
+			#size-cells = <1>;
+
+			nvram: partition@700000 {
+				label = "nvram";
+				/* To be filled by the loader */
+				reg = <0x0 0x0>;
+				status = "disabled";
+			};
+		};
+	};
+};
+
+/*
+ * The HDMI converter's two power outputs (ADT dp2hdmi-gpio1): line 0 hdmi_pwr_en ('pcIO',
+ * 0x800000, 0xf0000), line 1 dp2hdmi_pwr_en ('pcIO', 0x0, 0x1a0000). Nothing drives them until
+ * the HDMI output does.
+ */
+&smc_pcio {
+	apple,output-commands = /bits/ 64 <0x000f000000800000 0x001a000000000000>;
+};
+
+/*
+ * The USB-C ports: rear ports 1-4 on ATC0-3 of die 0, front ports 5 and 6 on ATC0 and ATC1 of
+ * die 1. The HPMs of the rear ports are on nub-spmi-a0, those of the front ports on nub-spmi-a2.
+ */
+&nub_spmi_a0 {
+	/*
+	 * /arm-io/nub-spmi-a0/hpm0: SN201202x (ACE3), SPMI address 0xc, port-number 1 (back-right).
+	 * Reserved: rear port 1 carries the DFU cable, the host's VDM reboot path and the
+	 * debug console (KIS) through usb-drd0; a probe wakes the controller and sets its
+	 * power state even when polled. No ATC0, usb-drd0 or dart-usb0 node either.
+	 */
+	hpm0: usb-pd@c {
+		compatible = "apple,sn201202x";
+		reg = <0xc SPMI_USID>;
+		status = "disabled";
+	};
+
+	/* /arm-io/nub-spmi-a0/hpm1: SN201202x (ACE3), SPMI address 0xa, port-number 2 */
+	hpm1: usb-pd@a {
+		compatible = "apple,sn201202x";
+		reg = <0xa SPMI_USID>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Back-right-middle";
+			power-role = "dual";
+			data-role = "host";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					hpm1_hs: endpoint {
+						remote-endpoint = <&usb_drd1_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					hpm1_ss: endpoint {
+						remote-endpoint = <&atc1_phy_ep>;
+					};
+				};
+			};
+		};
+	};
+
+	/* /arm-io/nub-spmi-a0/hpm2: SN201202x (ACE3), SPMI address 8, port-number 3 */
+	hpm2: usb-pd@8 {
+		compatible = "apple,sn201202x";
+		reg = <0x8 SPMI_USID>;
+		status = "disabled";
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Back-left-middle";
+			power-role = "dual";
+			data-role = "dual";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					hpm2_hs: endpoint {
+						remote-endpoint = <&usb_drd2_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					hpm2_ss: endpoint {
+						remote-endpoint = <&atc2_phy_ep>;
+					};
+				};
+
+				port@2 {
+					reg = <2>;
+					hpm2_dp: endpoint {
+						remote-endpoint = <&dcpext0_typec>;
+					};
+				};
+			};
+		};
+	};
+
+	/* /arm-io/nub-spmi-a0/hpm3: SN201202x (ACE3), SPMI address 6, port-number 4 */
+	hpm3: usb-pd@6 {
+		compatible = "apple,sn201202x";
+		reg = <0x6 SPMI_USID>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Back-left";
+			power-role = "dual";
+			data-role = "host";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					hpm3_hs: endpoint {
+						remote-endpoint = <&usb_drd3_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					hpm3_ss: endpoint {
+						remote-endpoint = <&atc3_phy_ep>;
+					};
+				};
+
+				/* The USB4 router (usb4_3_acio), the PD driver's thunderbolt-switch */
+				port@2 {
+					reg = <2>;
+					hpm3_tbt: endpoint {
+						remote-endpoint = <&usb4_3_ep>;
+					};
+				};
+			};
+		};
+	};
+};
+
+&nub_spmi_a2 {
+	/* /arm-io/nub-spmi-a2/hpm4: SN201202x (ACE3), SPMI address 0xc, port-number 5 */
+	hpm4: usb-pd@c {
+		compatible = "apple,sn201202x";
+		reg = <0xc SPMI_USID>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Front-right";
+			power-role = "dual";
+			data-role = "host";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					hpm4_hs: endpoint {
+						remote-endpoint = <&usb_drd4_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					hpm4_ss: endpoint {
+						remote-endpoint = <&atc4_phy_ep>;
+					};
+				};
+			};
+		};
+	};
+
+	/* /arm-io/nub-spmi-a2/hpm5: SN201202x (ACE3), SPMI address 0xa, port-number 6 */
+	hpm5: usb-pd@a {
+		compatible = "apple,sn201202x";
+		reg = <0xa SPMI_USID>;
+
+		connector {
+			compatible = "usb-c-connector";
+			label = "USB-C Front-left";
+			power-role = "dual";
+			data-role = "host";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				port@0 {
+					reg = <0>;
+					hpm5_hs: endpoint {
+						remote-endpoint = <&usb_drd5_hs>;
+					};
+				};
+
+				port@1 {
+					reg = <1>;
+					hpm5_ss: endpoint {
+						remote-endpoint = <&atc5_phy_ep>;
+					};
+				};
+			};
+		};
+	};
+};
+
+/*
+ * Rear USB-C port 2 (HPM1, "back-right-middle"), USB data: ATC1's combo PHY, usb-drd1 and
+ * dart-usb1.
+ */
+&atc1_phy {
+	port {
+		atc1_phy_ep: endpoint {
+			remote-endpoint = <&hpm1_ss>;
+		};
+	};
+};
+
+&usb_drd1 {
+	port {
+		usb_drd1_hs: endpoint {
+			remote-endpoint = <&hpm1_hs>;
+		};
+	};
+};
+
+/*
+ * Rear USB-C port 3 (HPM2, "back-left-middle", the display port): DisplayPort out from dcpext0
+ * through ATC2, and USB beside it (usb-drd2, dart-usb2). The chain stays disabled: Aura's T6050
+ * display handoff enables what dcpext0 references (phys, mux-controls, the PHY's mailbox and
+ * power domains, the typec route's HPM and its SPMI bus).
+ */
+&atc2_phy {
+	port {
+		atc2_phy_ep: endpoint {
+			remote-endpoint = <&hpm2_ss>;
+		};
+	};
+};
+
+&usb_drd2 {
+	port {
+		usb_drd2_hs: endpoint {
+			remote-endpoint = <&hpm2_hs>;
+		};
+	};
+};
+
+&dcpext0 {
+	typec-routes {
+		route@0 {
+			port {
+				dcpext0_typec: endpoint {
+					remote-endpoint = <&hpm2_dp>;
+				};
+			};
+		};
+	};
+};
+
+/* Rear USB-C port 4 (HPM3, "back-left"): ATC3, and its USB4/Thunderbolt router */
+&atc3_phy {
+	port {
+		atc3_phy_ep: endpoint {
+			remote-endpoint = <&hpm3_ss>;
+		};
+	};
+};
+
+&usb_drd3 {
+	port {
+		usb_drd3_hs: endpoint {
+			remote-endpoint = <&hpm3_hs>;
+		};
+	};
+};
+
+&usb4_3_acio {
+	ports {
+		#address-cells = <1>;
+		#size-cells = <0>;
+
+		port@1 {
+			reg = <1>;
+			usb4_3_ep: endpoint {
+				remote-endpoint = <&hpm3_tbt>;
+			};
+		};
+	};
+};
+
+/* Front USB-C port 5 (HPM4, "front-right"): die 1's ATC0 */
+&atc4_phy {
+	port {
+		atc4_phy_ep: endpoint {
+			remote-endpoint = <&hpm4_ss>;
+		};
+	};
+};
+
+&usb_drd4 {
+	port {
+		usb_drd4_hs: endpoint {
+			remote-endpoint = <&hpm4_hs>;
+		};
+	};
+};
+
+/* Front USB-C port 6 (HPM5, "front-left"): die 1's ATC1 */
+&atc1_phy_die1 {
+	port {
+		atc5_phy_ep: endpoint {
+			remote-endpoint = <&hpm5_ss>;
+		};
+	};
+};
+
+&usb_drd1_die1 {
+	port {
+		usb_drd5_hs: endpoint {
+			remote-endpoint = <&hpm5_hs>;
+		};
+	};
+};
+
+/*
+ * The HDMI port: dcpext4, die 1's dcpext0, through its fixed route (die 1's display crossbar,
+ * ufp endpoint 0, to lpdptx-phy1, dfp endpoint 4). Aura's T6050 handoff enables it with dcpext0
+ * when the engine passes the same checks. No output yet: the HDMI PHY, its converter's power and
+ * hotplug come with their drivers.
+ */
+&dcpext0_die1 {
+	apple,connector-type = "HDMI-A";
+	apple,dptx-die = <1>;
+	apple,dptx-phy = <4>;
+	/*
+	 * The fixed HDMI route: the PHY (its source select picks this engine: the crossbar has no
+	 * registers), the converter's hotplug output (AOP GPIO 14, active high) and its two power
+	 * enables (the SMC's pcIO pins 15 and 26).
+	 */
+	phys = <&lpdptx_phy1>;
+	phy-names = "dp-phy";
+	hdmi-hpd-gpios = <&pinctrl_aop 14 GPIO_ACTIVE_HIGH>;
+	hdmi-pwren-gpios = <&smc_pcio 0 GPIO_ACTIVE_HIGH>;
+	dp2hdmi-pwren-gpios = <&smc_pcio 1 GPIO_ACTIVE_HIGH>;
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-max.dtsi b/arch/arm64/boot/dts/apple/t6050-max.dtsi
new file mode 100644
index 000000000..d3b0a1f7b
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-max.dtsi
@@ -0,0 +1,117 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple T6050 "M5 Max" SoC: one die
+ *
+ * Die 0 alone: t6050-die0.dtsi and one instance of the per-die template
+ * (t6050-dieX.dtsi), then the blocks described so far for this part only.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+#include <dt-bindings/interrupt-controller/apple-aic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/spmi/spmi.h>
+
+#include "multi-die-cpp.h"
+
+#include "t6050-base.dtsi"
+
+/ {
+	/*
+	 * Six cores in each cluster, in the order of the ADT's /cpus (cpu0-17). m1n1
+	 * matches the CPU nodes to the cores it started by position (dt_set_cpus(): node
+	 * N against the ADT's cpu N), prunes the nodes of cores that are not alive and
+	 * stops the boot at the first MPIDR that differs, so the nodes must keep the
+	 * ADT's order; the labels already follow it.
+	 */
+	cpus {
+		T6050_M_CPU(cpu0, 40000, cpufreq_mc0);
+		T6050_M_CPU(cpu1, 40001, cpufreq_mc0);
+		T6050_M_CPU(cpu2, 40002, cpufreq_mc0);
+		T6050_M_CPU(cpu3, 40003, cpufreq_mc0);
+		T6050_M_CPU(cpu4, 40004, cpufreq_mc0);
+		T6050_M_CPU(cpu5, 40005, cpufreq_mc0);
+		T6050_M_CPU(cpu6, 40100, cpufreq_mc1);
+		T6050_M_CPU(cpu7, 40101, cpufreq_mc1);
+		T6050_M_CPU(cpu8, 40102, cpufreq_mc1);
+		T6050_M_CPU(cpu9, 40103, cpufreq_mc1);
+		T6050_M_CPU(cpu10, 40104, cpufreq_mc1);
+		T6050_M_CPU(cpu11, 40105, cpufreq_mc1);
+		T6050_P_CPU(cpu12, 10200, cpufreq_pc);
+		T6050_P_CPU(cpu13, 10201, cpufreq_pc);
+		T6050_P_CPU(cpu14, 10202, cpufreq_pc);
+		T6050_P_CPU(cpu15, 10203, cpufreq_pc);
+		T6050_P_CPU(cpu16, 10204, cpufreq_pc);
+		T6050_P_CPU(cpu17, 10205, cpufreq_pc);
+	};
+};
+
+#define DIE
+#define DIE_NO 0
+#define DIE_UNIT_PREFIX
+#define DIE_ATC1 atc1
+#define SOC_NODE die0
+
+#include "t6050-dieX.dtsi"
+#include "t6050-die0.dtsi"
+
+#undef DIE
+#undef DIE_NO
+#undef DIE_UNIT_PREFIX
+#undef DIE_ATC1
+#undef SOC_NODE
+
+/*
+ * The MTP coprocessor (the keyboard and trackpad's), which iBoot leaves running with its
+ * firmware, behind its DART, and the DockChannel FIFO its HID transport uses; the board adds
+ * that transport. From the ADT: /arm-io/mtp reg[0] 0x294600000 (the ASC, its v4 mailbox at
+ * +0x8000; interrupts [677, 676, 679, 678]: 676..679 in send-empty, send-not-empty, recv-empty,
+ * recv-not-empty order), dart-mtp 0x294800000 (interrupt 659, SID 0, vm-base 0x100_00004000),
+ * dockchannel-mtp 0x294b14000 for its interrupts (660) and 0x294b28000.. for the FIFOs.
+ */
+&die0 {
+	mtp_mbox: mailbox@294608000 {
+		compatible = "apple,t6050-asc-mailbox", "apple,asc-mailbox-v4";
+		reg = <0x2 0x94608000 0x0 0x4000>;
+		interrupts = <AIC_IRQ 0 676 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 677 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 678 IRQ_TYPE_LEVEL_HIGH>,
+			     <AIC_IRQ 0 679 IRQ_TYPE_LEVEL_HIGH>;
+		interrupt-names = "send-empty", "send-not-empty",
+				  "recv-empty", "recv-not-empty";
+		#mbox-cells = <0>;
+	};
+
+	mtp_dart: iommu@294800000 {
+		compatible = "apple,t6050-dart", "apple,t8110-dart";
+		reg = <0x2 0x94800000 0x0 0xc000>;
+		interrupts = <AIC_IRQ 0 659 IRQ_TYPE_LEVEL_HIGH>;
+		#iommu-cells = <1>;
+		apple,dma-range = <0x100 0x4000 0x0 0xffff0000>;
+	};
+
+	mtp: mtp@294600000 {
+		compatible = "apple,t6050-mtp", "apple,mtp", "apple,rtk-helper-asc4";
+		reg = <0x2 0x94600000 0x0 0x4000>,
+		      <0x2 0x94c00000 0x0 0xc4000>;
+		reg-names = "asc", "sram";
+		mboxes = <&mtp_mbox>;
+		iommus = <&mtp_dart 0>;
+		#helper-cells = <0>;
+	};
+
+	mtp_dockchannel: fifo@294b14000 {
+		compatible = "apple,t6050-dockchannel", "apple,dockchannel";
+		reg = <0x2 0x94b14000 0x0 0x1000>;
+		reg-names = "irq";
+		interrupts = <AIC_IRQ 0 660 IRQ_TYPE_LEVEL_HIGH>;
+		ranges = <0 0x2 0x94b28000 0x10000>;
+		nonposted-mmio;
+		#address-cells = <1>;
+		#size-cells = <1>;
+		interrupt-controller;
+		#interrupt-cells = <2>;
+	};
+};
diff --git a/arch/arm64/boot/dts/apple/t6050-ultra.dtsi b/arch/arm64/boot/dts/apple/t6050-ultra.dtsi
new file mode 100644
index 000000000..fae562126
--- /dev/null
+++ b/arch/arm64/boot/dts/apple/t6050-ultra.dtsi
@@ -0,0 +1,502 @@
+// SPDX-License-Identifier: GPL-2.0+ OR MIT
+/*
+ * Apple T6050 "M5 Ultra" SoC: two dies
+ *
+ * Die 0 and die 1 each get the per-die template (t6050-dieX.dtsi); the
+ * blocks used from die 0 only are in t6050-die0.dtsi. The video decoders,
+ * the memory cache controllers and the display subsystem are so far
+ * described for the two-die part only, as are die 1's ATC0 port and its
+ * DisplayPort PHY.
+ *
+ * Copyright The Asahi Linux Contributors
+ */
+
+#include <dt-bindings/interrupt-controller/apple-aic.h>
+#include <dt-bindings/interrupt-controller/irq.h>
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/phy/phy.h>
+#include <dt-bindings/spmi/spmi.h>
+
+#include "multi-die-cpp.h"
+
+#include "t6050-base.dtsi"
+
+/ {
+	/*
+	 * Five cores in each cluster, die 0's first, so that nr_cpus= brings the CPUs up in that
+	 * order.
+	 */
+	cpus {
+		T6050_M_CPU(cpu0, 40000, cpufreq_mc0);
+		T6050_M_CPU(cpu1, 40001, cpufreq_mc0);
+		T6050_M_CPU(cpu2, 40002, cpufreq_mc0);
+		T6050_M_CPU(cpu3, 40003, cpufreq_mc0);
+		T6050_M_CPU(cpu4, 40004, cpufreq_mc0);
+		T6050_M_CPU(cpu6, 40100, cpufreq_mc1);
+		T6050_M_CPU(cpu7, 40101, cpufreq_mc1);
+		T6050_M_CPU(cpu8, 40102, cpufreq_mc1);
+		T6050_M_CPU(cpu9, 40103, cpufreq_mc1);
+		T6050_M_CPU(cpu10, 40104, cpufreq_mc1);
+		T6050_P_CPU(cpu12, 10200, cpufreq_pc);
+		T6050_P_CPU(cpu13, 10201, cpufreq_pc);
+		T6050_P_CPU(cpu14, 10202, cpufreq_pc);
+		T6050_P_CPU(cpu15, 10203, cpufreq_pc);
+		T6050_P_CPU(cpu16, 10204, cpufreq_pc);
+		T6050_M_CPU(cpu18, 41000, cpufreq_mc0_die1);
+		T6050_M_CPU(cpu19, 41001, cpufreq_mc0_die1);
+		T6050_M_CPU(cpu20, 41002, cpufreq_mc0_die1);
+		T6050_M_CPU(cpu21, 41003, cpufreq_mc0_die1);
+		T6050_M_CPU(cpu22, 41004, cpufreq_mc0_die1);
+		T6050_M_CPU(cpu24, 41100, cpufreq_mc1_die1);
+		T6050_M_CPU(cpu25, 41101, cpufreq_mc1_die1);
+		T6050_M_CPU(cpu26, 41102, cpufreq_mc1_die1);
+		T6050_M_CPU(cpu27, 41103, cpufreq_mc1_die1);
+		T6050_M_CPU(cpu28, 41104, cpufreq_mc1_die1);
+		T6050_P_CPU(cpu30, 11200, cpufreq_pc_die1);
+		T6050_P_CPU(cpu31, 11201, cpufreq_pc_die1);
+		T6050_P_CPU(cpu32, 11202, cpufreq_pc_die1);
+		T6050_P_CPU(cpu33, 11203, cpufreq_pc_die1);
+		T6050_P_CPU(cpu34, 11204, cpufreq_pc_die1);
+	};
+
+	/* Die 1 MMIO. The boot loader needs each die's bus. */
+	die1: soc@4200000000 {
+		compatible = "simple-bus";
+		#address-cells = <2>;
+		#size-cells = <2>;
+		ranges = <0x42 0x0 0x42 0x0 0x3 0xc0000000>;
+		nonposted-mmio;
+	};
+};
