new file mode 100644
index 000000000..6b1a33cac
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/bluetooth/apple,centauri.yaml
@@ -0,0 +1,48 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/bluetooth/apple,centauri.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple N1 Centauri Beta Bluetooth PCI function
+
+maintainers:
+  - Dj <hey@djdev.me>
+
+description: |
+  PCI function two is the Beta Bluetooth HCI/ACL transport. It depends on
+  the Control function in the same PCI slot, which boots the shared N1
+  firmware using the protocol profile described on its own DT node.
+  The factory address is supplied in network byte order for the firmware
+  address-provisioning command; HCI returns the standard Bluetooth order.
+
+properties:
+  compatible:
+    const: pci106b,1903
+
+  reg:
+    maxItems: 1
+    description: Standard five-cell PCI function address
+
+  local-bd-address:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 6
+    maxItems: 6
+    description: Factory Bluetooth public address, least significant byte
+      first (the standard Bluetooth property a boot loader fills)
+
+  local-mac-address:
+    $ref: /schemas/types.yaml#/definitions/uint8-array
+    minItems: 6
+    maxItems: 6
+    description: Factory Bluetooth public address in network byte order
+
+oneOf:
+  - required: [local-bd-address]
+  - required: [local-mac-address]
+
+required:
+  - compatible
+  - reg
+
+additionalProperties: false
diff --git a/Documentation/devicetree/bindings/net/wireless/apple,centauri.yaml b/Documentation/devicetree/bindings/net/wireless/apple,centauri.yaml
new file mode 100644
index 000000000..f73dd9afc
--- /dev/null
+++ b/Documentation/devicetree/bindings/net/wireless/apple,centauri.yaml
@@ -0,0 +1,50 @@
+# SPDX-License-Identifier: GPL-2.0-only
+%YAML 1.2
+---
+$id: http://devicetree.org/schemas/net/wireless/apple,centauri.yaml#
+$schema: http://devicetree.org/meta-schemas/core.yaml#
+
+title: Apple N1 Centauri Control PCI function
+
+maintainers:
+  - Dj <hey@djdev.me>
+
+description: |
+  PCI function zero owns the shared N1 firmware bootstrap. The boot producer
+  supplies the personalized FTAB filename and packed firmware platform ID.
+  The endpoint must be left in its stopped ROM personality with DMA and MSI
+  quiesced. The host's root-port reset retrains the link after the ROM
+  bootstrap. This binding does not authorize adopting an existing live
+  firmware session or releasing another owner's retained DART streams.
+
+properties:
+  compatible:
+    enum:
+      - pci106b,1900
+      - pci106b,1901
+
+  reg:
+    maxItems: 1
+    description: Standard five-cell PCI function address
+
+  firmware-name:
+    $ref: /schemas/types.yaml#/definitions/string
+    description: Personalized FTAB including the required per-device calibration
+
+  apple,centauri-platform-id:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    description: Firmware chip ID in bits 15..0 and board ID in bits 30..16
+
+  apple,centauri-protocol:
+    $ref: /schemas/types.yaml#/definitions/uint32
+    const: 27
+    description: Shared firmware wire protocol profile
+
+required:
+  - compatible
+  - reg
+  - firmware-name
+  - apple,centauri-platform-id
+  - apple,centauri-protocol
+
+additionalProperties: false
