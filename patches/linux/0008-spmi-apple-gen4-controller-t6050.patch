diff --git a/drivers/spmi/spmi-apple-controller.c b/drivers/spmi/spmi-apple-controller.c
index 239017445..b2972a6b2 100644
--- a/drivers/spmi/spmi-apple-controller.c
+++ b/drivers/spmi/spmi-apple-controller.c
@@ -22,14 +22,12 @@
 #include <linux/irqdomain.h>
 #include <linux/module.h>
 #include <linux/mutex.h>
+#include <linux/of.h>
 #include <linux/platform_device.h>
 #include <linux/spinlock.h>
 #include <linux/spmi.h>
 
 /* SPMI Controller Registers */
-#define SPMI_STATUS_REG 0
-#define SPMI_CMD_REG 0x4
-#define SPMI_RSP_REG 0x8
 #define SPMI_ACT_REG 0xa4
 
 #define SPMI_IRQ_MASK_BASE 0x20
@@ -39,20 +37,42 @@
 
 #define SPMI_IRQ_NOTIFY 256
 
-/* SPMI_RSP_REG reply word */
+/* reply word read from the RSP FIFO */
 #define SPMI_REPLY_FRAME_PARITY_STATUS GENMASK(31, 16)
 #define SPMI_REPLY_ACK BIT(15)
 #define SPMI_REPLY_SLAVE_ID GENMASK(14, 8)
 #define SPMI_REPLY_CMD GENMASK(7, 0)
 
 #define SPMI_ACT_FIFO_FLUSH BIT(0)
-#define SPMI_RX_FIFO_EMPTY BIT(24)
 
 #define REG_POLL_INTERVAL_US 10000
 #define REG_POLL_TIMEOUT_US (REG_POLL_INTERVAL_US * 5)
 
+/*
+ * FIFO register layout per controller generation (the ADT "gen" property).
+ * Gen 4 (M4/M5) moved the FIFOs; its IRQ mask/ack and FIFO-flush registers
+ * are undocumented (m1n1 src/spmi.c and proxyclient hw/spmi4.py only know
+ * STATUS/CMD/REPLY), so gen 4 runs polled and never touches them.
+ */
+struct apple_spmi_hw {
+	u32 status;
+	u32 cmd;
+	u32 rsp;
+	u32 rx_empty;
+	bool irq_regs;		/* IRQ mask/ack + SPMI_ACT_REG at the gen 1 offsets */
+};
+
+static const struct apple_spmi_hw apple_spmi_gen1 = {
+	.status = 0x0, .cmd = 0x4, .rsp = 0x8, .rx_empty = BIT(24), .irq_regs = true,
+};
+
+static const struct apple_spmi_hw apple_spmi_gen4 = {
+	.status = 0x200, .cmd = 0x210, .rsp = 0x220, .rx_empty = BIT(30), .irq_regs = false,
+};
+
 struct apple_spmi {
 	void __iomem *regs;
+	const struct apple_spmi_hw *hw;
 	struct mutex fifo_lock;
 	struct completion fifo_rx;
 	struct irq_domain *irqd;
@@ -134,12 +154,12 @@ static int apple_spmi_wait_rx_not_empty(struct spmi_controller *ctrl)
 			usecs_to_jiffies(REG_POLL_TIMEOUT_US));
 		if (!ret)
 			ret = -ETIMEDOUT;
-		else if (readl(spmi->regs + SPMI_STATUS_REG) & SPMI_RX_FIFO_EMPTY)
+		else if (readl(spmi->regs + spmi->hw->status) & spmi->hw->rx_empty)
 			ret = -EIO;
 		else
 			ret = 0;
 	} else {
-		ret = poll_reg(spmi, SPMI_STATUS_REG, status, !(status & SPMI_RX_FIFO_EMPTY));
+		ret = poll_reg(spmi, spmi->hw->status, status, !(status & spmi->hw->rx_empty));
 	}
 
 	if (ret) {
@@ -164,19 +184,27 @@ static int spmi_raw_cmd(struct spmi_controller *ctrl, u8 opc, u8 sid, u16 param,
 	guard(mutex)(&spmi->fifo_lock);
 
 	if (spmi->prev_fail) {
-		writel(SPMI_ACT_FIFO_FLUSH, spmi->regs + SPMI_ACT_REG);
-		apple_spmi_irq_ack_raw(spmi, SPMI_IRQ_NOTIFY);
+		if (spmi->hw->irq_regs) {
+			writel(SPMI_ACT_FIFO_FLUSH, spmi->regs + SPMI_ACT_REG);
+			apple_spmi_irq_ack_raw(spmi, SPMI_IRQ_NOTIFY);
+		} else {
+			/* No known flush register: drain stale replies. */
+			for (i = 0; i < 64 && !(readl(spmi->regs + spmi->hw->status) &
+						 spmi->hw->rx_empty); i++)
+				readl(spmi->regs + spmi->hw->rsp);
+			i = 0;
+		}
 		spmi->prev_fail = false;
 	}
 	reinit_completion(&spmi->fifo_rx);
 
-	writel(spmi_cmd, spmi->regs + SPMI_CMD_REG);
+	writel(spmi_cmd, spmi->regs + spmi->hw->cmd);
 
 	while (i < len_wr) {
 		j = min_t(size_t, sizeof(spmi_cmd), len_wr - i);
 		spmi_cmd = 0;
 		memcpy(&spmi_cmd, buf_wr + i, j);
-		writel(spmi_cmd, spmi->regs + SPMI_CMD_REG);
+		writel(spmi_cmd, spmi->regs + spmi->hw->cmd);
 		i += j;
 	}
 
@@ -184,24 +212,24 @@ static int spmi_raw_cmd(struct spmi_controller *ctrl, u8 opc, u8 sid, u16 param,
 	if (ret)
 		return ret;
 
-	reply = readl(spmi->regs + SPMI_RSP_REG);
+	reply = readl(spmi->regs + spmi->hw->rsp);
 
 	/* Read SPMI data reply */
 	i = 0;
 	while (i < len_rd) {
-		if (readl(spmi->regs + SPMI_STATUS_REG) & SPMI_RX_FIFO_EMPTY) {
+		if (readl(spmi->regs + spmi->hw->status) & spmi->hw->rx_empty) {
 			spmi->prev_fail = true;
 			dev_err_ratelimited(&ctrl->dev,
 					    "FIFO lacks reply data, controller stuck?\n");
 			return -EIO;
 		}
-		rsp = readl(spmi->regs + SPMI_RSP_REG);
+		rsp = readl(spmi->regs + spmi->hw->rsp);
 		j = min_t(size_t, sizeof(spmi_cmd), len_rd - i);
 		memcpy(buf_rd + i, &rsp, j);
 		i += j;
 	}
 
-	if (!(readl(spmi->regs + SPMI_STATUS_REG) & SPMI_RX_FIFO_EMPTY)) {
+	if (!(readl(spmi->regs + spmi->hw->status) & spmi->hw->rx_empty)) {
 		dev_warn(&ctrl->dev, "FIFO has extra data\n");
 		spmi->prev_fail = true;
 	}
@@ -446,6 +474,7 @@ static int apple_spmi_probe(struct platform_device *pdev)
 	mutex_init(&spmi->fifo_lock);
 	init_completion(&spmi->fifo_rx);
 	platform_set_drvdata(pdev, spmi);
+	spmi->hw = of_device_get_match_data(&pdev->dev);
 
 	spmi->regs = devm_platform_ioremap_resource(pdev, 0);
 	if (IS_ERR(spmi->regs))
@@ -457,7 +486,7 @@ static int apple_spmi_probe(struct platform_device *pdev)
 	ctrl->write_cmd = spmi_write_cmd;
 	ctrl->cmd = spmi_cmd;
 
-	spmi->irq = platform_get_irq_optional(pdev, 0);
+	spmi->irq = spmi->hw->irq_regs ? platform_get_irq_optional(pdev, 0) : -ENXIO;
 	if (spmi->irq < 0 && spmi->irq != -ENXIO)
 		return spmi->irq;
 	if (spmi->irq >= 0) {
@@ -475,8 +504,9 @@ static int apple_spmi_probe(struct platform_device *pdev)
 }
 
 static const struct of_device_id apple_spmi_match_table[] = {
-	{ .compatible = "apple,t8103-spmi", },
-	{ .compatible = "apple,spmi", },
+	{ .compatible = "apple,t6050-spmi", .data = &apple_spmi_gen4 },
+	{ .compatible = "apple,t8103-spmi", .data = &apple_spmi_gen1 },
+	{ .compatible = "apple,spmi", .data = &apple_spmi_gen1 },
 	{}
 };
 MODULE_DEVICE_TABLE(of, apple_spmi_match_table);
