+
+config OMARCHY_FB_MARKER_STRIDE
+	hex "Framebuffer stride in bytes"
+	depends on OMARCHY_FB_MARKERS
+	default 0x2f40
+
+config OMARCHY_FB_MARKER_HEIGHT
+	int "Framebuffer height in pixels"
+	depends on OMARCHY_FB_MARKERS
