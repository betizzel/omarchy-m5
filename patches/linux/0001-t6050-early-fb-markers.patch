+	 */
+	omarchy_fb_earlycon_init();
+
 	parse_early_param();
 
 	dynamic_scs_init();
@@ -333,6 +347,12 @@ void __init __no_sanitize_address setup_arch(char **cmdline_p)
 
 	paging_init();
 
+	/*
+	 * omarchy-m5: memblock and the linear map survived, which means the
+	 * memory nodes m1n1 patched into the FDT were sane.
+	 */
+	omarchy_fb_marker(OMARCHY_MARK_PAGING);
+
 	acpi_table_upgrade();
 
 	/* Parse the ACPI tables for possible boot-time configuration */
