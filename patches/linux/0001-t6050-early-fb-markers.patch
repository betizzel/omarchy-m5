diff --git a/arch/arm64/kernel/head.S b/arch/arm64/kernel/head.S
index 87a822e5c..80e575f5f 100644
--- a/arch/arm64/kernel/head.S
+++ b/arch/arm64/kernel/head.S
@@ -35,6 +35,7 @@
 #include <asm/stacktrace/frame.h>
 #include <asm/thread_info.h>
 #include <asm/virt.h>
+#include <asm/omarchy_fbmarker.h>
 
 #include "efi-header.S"
 
@@ -86,6 +87,29 @@ SYM_CODE_START(primary_entry)
 	bl	record_mmu_state
 	bl	preserve_boot_args
 
+#ifdef CONFIG_OMARCHY_FB_MARKERS
+	/*
+	 * omarchy-m5: earliest possible proof of life. The MMU is off here,
+	 * so this writes the framebuffer's physical address directly and the
+	 * display controller scans it straight out of DRAM - no mapping, no
+	 * console, no DT. boot args are already stashed by preserve_boot_args
+	 * above, and x19/x20/x21 are live, so only x8-x13 are touched.
+	 */
+	mov_q	x8, CONFIG_OMARCHY_FB_MARKER_BASE
+	mov_q	x9, 0x3FF00000			// red, x2r10g10b10
+	mov_q	x13, CONFIG_OMARCHY_FB_MARKER_STRIDE
+	mov	x10, #OMARCHY_MARK_ROWS
+8:	mov	x11, #OMARCHY_MARK_COLS
+	mov	x12, x8
+9:	str	w9, [x12], #4
+	subs	x11, x11, #1
+	b.ne	9b
+	add	x8, x8, x13
+	subs	x10, x10, #1
+	b.ne	8b
+	dsb	sy
+#endif
+
 	adrp	x1, early_init_stack
 	mov	sp, x1
 	mov	x29, xzr
diff --git a/arch/arm64/kernel/omarchy_fbmarker.c b/arch/arm64/kernel/omarchy_fbmarker.c
new file mode 100644
index 000000000..183d3f8f1
--- /dev/null
+++ b/arch/arm64/kernel/omarchy_fbmarker.c
@@ -0,0 +1,104 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * omarchy-m5 bring-up: framebuffer checkpoint markers. See
+ * <asm/omarchy_fbmarker.h> for the row/colour layout and rationale.
+ */
+
+#include <linux/init.h>
+#include <linux/io.h>
+#include <linux/types.h>
+#include <linux/screen_info.h>
+#include <linux/slab.h>
+#include <linux/sysfb.h>
+#include <asm/barrier.h>
+#include <asm/omarchy_fbmarker.h>
+
+/* x2r10g10b10, matching the format m1n1 advertises for this 30bpp panel */
+static const u32 omarchy_marker_color[] = {
+	[OMARCHY_MARK_ENTRY]	= 0x3FF00000,	/* red   */
+	[OMARCHY_MARK_MMU]	= 0x000FFC00,	/* green */
+	[OMARCHY_MARK_PAGING]	= 0x000003FF,	/* blue  */
+	[OMARCHY_MARK_CONSOLE]	= 0x3FFFFFFF,	/* white   */
+	[OMARCHY_MARK_SIMPLEDRM]= 0x000FFFFF,	/* cyan    */
+	[OMARCHY_MARK_FBCON]	= 0x3FF003FF,	/* magenta */
+	[OMARCHY_MARK_USERSPACE]= 0x3FF66000,	/* orange  */
+};
+
+void omarchy_fb_marker(int slot)
+{
+	const u32 stride = CONFIG_OMARCHY_FB_MARKER_STRIDE;
+	phys_addr_t row0 = (phys_addr_t)slot * OMARCHY_MARK_ROWS * stride;
+	void __iomem *fb;
+	bool late;
+	u32 x, y;
+
+	if (slot < 0 || slot >= ARRAY_SIZE(omarchy_marker_color))
+		return;
+
+	/*
+	 * early_ioremap() yields a Device-nGnRE mapping, so the stores reach
+	 * memory with no cache maintenance of our own - which matters because
+	 * the display controller scans this out of DRAM behind the CPU.
+	 */
+	/*
+	 * early_ioremap() only exists during early boot; the simpledrm/fbcon/
+	 * userspace checkpoints run long after it is torn down, so switch to
+	 * the real ioremap once the allocator is up.
+	 */
+	late = slab_is_available();
+	fb = late ? ioremap(CONFIG_OMARCHY_FB_MARKER_BASE + row0,
+			    OMARCHY_MARK_ROWS * stride)
+		  : early_ioremap(CONFIG_OMARCHY_FB_MARKER_BASE + row0,
+				  OMARCHY_MARK_ROWS * stride);
+	if (!fb)
+		return;
+
+	for (y = 0; y < OMARCHY_MARK_ROWS; y++)
+		for (x = 0; x < OMARCHY_MARK_COLS; x++)
+			__raw_writel(omarchy_marker_color[slot],
+				     fb + y * stride + x * 4);
+
+	dsb(sy);
+	if (late)
+		iounmap(fb);
+	else
+		early_iounmap(fb, OMARCHY_MARK_ROWS * stride);
+}
+
+/*
+ * Describe the panel below the marker bands to the EFI framebuffer
+ * earlycon, which then prints the kernel log there from parse_early_param()
+ * on - with no driver, fbcon or interrupts involved. A DT boot never fills
+ * screen_info, so without this `earlycon=efifb` refuses to attach.
+ */
+void __init omarchy_fb_earlycon_init(void)
+{
+	struct screen_info *si = &sysfb_primary_display.screen;
+	const u32 stride = CONFIG_OMARCHY_FB_MARKER_STRIDE;
+	const u64 base = CONFIG_OMARCHY_FB_MARKER_BASE +
+			 (u64)OMARCHY_EARLYCON_ROW0 * stride;
+	const u32 height = CONFIG_OMARCHY_FB_MARKER_HEIGHT - OMARCHY_EARLYCON_ROW0;
+
+	si->orig_video_isVGA = VIDEO_TYPE_EFI;
+	si->capabilities |= VIDEO_CAPABILITY_64BIT_BASE;
+	si->lfb_base = lower_32_bits(base);
+	si->ext_lfb_base = upper_32_bits(base);
+	si->lfb_width = stride / 4;
+	si->lfb_height = height;
+	si->lfb_linelength = stride;
+	si->lfb_depth = 32;
+	si->lfb_size = stride * height;
+}
+
+/*
+ * efifb earlycon remaps the framebuffer at early_initcall. Withdraw the EFI
+ * type before sysfb_init() (subsys_initcall) so sysfb does not hand the same
+ * memory to efifb: simpledrm from the DT stays the only framebuffer driver,
+ * exactly as without the earlycon.
+ */
+static int __init omarchy_fb_earlycon_hide(void)
+{
+	sysfb_primary_display.screen.orig_video_isVGA = 0;
+	return 0;
+}
+arch_initcall(omarchy_fb_earlycon_hide);
