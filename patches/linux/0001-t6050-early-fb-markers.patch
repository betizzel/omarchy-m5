+config OMARCHY_FB_MARKERS
+	bool "omarchy-m5: framebuffer checkpoint markers"
+	depends on ARCH_APPLE
+	help
+	  Paint coloured bands into the framebuffer handed over by the
+	  bootloader at fixed early-boot checkpoints (kernel entry, MMU on,
