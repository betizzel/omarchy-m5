diff --git a/arch/arm64/include/asm/omarchy_fbmarker.h b/arch/arm64/include/asm/omarchy_fbmarker.h
new file mode 100644
index 000000000..74fe96cea
--- /dev/null
+++ b/arch/arm64/include/asm/omarchy_fbmarker.h
@@ -0,0 +1,58 @@
+/* SPDX-License-Identifier: GPL-2.0-only */
+/*
+ * omarchy-m5 bring-up: framebuffer checkpoint markers.
+ *
+ * On an unsupported SoC with no debug cable the panel is the only output
+ * channel, and every console the kernel has (fbcon via simpledrm, earlycon
+ * via the s5l UART) comes up far too late to describe early boot. A kernel
+ * that dies in head.S and one that dies in console_init() look identical:
+ * the m1n1 logo, frozen.
+ *
+ * These markers paint a band straight into the framebuffer m1n1 handed over,
+ * so each checkpoint is visible with no driver, no console and no DT
+ * involved. Each band is 16 rows of 256 px:
+ *
+ *   rows  0..15  RED     kernel entry (head.S, MMU off, physical stores)
+ *   rows 16..31  GREEN   C reached, MMU on (setup_arch, after fixmap init)
+ *   rows 32..47  BLUE    paging_init() returned
+ *   rows 48..63  WHITE   start_kernel() reached console_init()
+ *   rows 64..79  CYAN    simpledrm probed the framebuffer successfully
+ *   rows 80..95  MAGENTA fbcon took over the console
+ *   rows 96..111 ORANGE  kernel_init is about to exec /init
+ *   rows 144..159 YELLOW painted by m1n1 before the jump
+ *
+ * Yellow is the control: if it appears and red does not, the mechanism is
+ * proven and the kernel genuinely never executed. Diagnostic code.
+ */
+#ifndef __ASM_OMARCHY_FBMARKER_H
+#define __ASM_OMARCHY_FBMARKER_H
+
+#define OMARCHY_MARK_ENTRY	0	/* red     */
+#define OMARCHY_MARK_MMU	1	/* green   */
+#define OMARCHY_MARK_PAGING	2	/* blue    */
+#define OMARCHY_MARK_CONSOLE	3	/* white   */
+#define OMARCHY_MARK_SIMPLEDRM	4	/* cyan    */
+#define OMARCHY_MARK_FBCON	5	/* magenta */
+#define OMARCHY_MARK_USERSPACE	6	/* orange  */
+#define OMARCHY_MARK_NR		7
+
+#define OMARCHY_MARK_ROWS	16
+#define OMARCHY_MARK_COLS	256
+
+/*
+ * Text from `earlycon=efifb` (drawn by drivers/firmware/efi/earlycon.c)
+ * starts below the marker and yellow bands, so those stay readable.
+ */
+#define OMARCHY_EARLYCON_ROW0	160
+
+#ifndef __ASSEMBLY__
+#ifdef CONFIG_OMARCHY_FB_MARKERS
+void omarchy_fb_marker(int slot);
+void omarchy_fb_earlycon_init(void);
+#else
+static inline void omarchy_fb_marker(int slot) { }
+static inline void omarchy_fb_earlycon_init(void) { }
+#endif
+#endif /* __ASSEMBLY__ */
+
+#endif /* __ASM_OMARCHY_FBMARKER_H */
