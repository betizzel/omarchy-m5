From b10b85be0eeea839f4ee410bdd3962520bc194cc Mon Sep 17 00:00:00 2001
From: TripleU <usher@gentechsolution.com>
Date: Wed, 11 Nov 2026 19:25:29 -0500
Subject: [PATCH 3/7] kboot: T6050: also admit the M5 Max's 27.3 GPU build
 (aura #172)

joshuaswarren's aurora-silicon/aura #172 (60a3b0fdb3) accepts the 26C5035r digest he
measured on an M5 Max, normalized with the 27.0 record offsets. Our 27.3 hand-off keeps a
table of builds, so his digest goes in as one more entry rather than a second check.

Co-authored-by: Joshua Warren <816217+joshuaswarren@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 src/kboot_gpu.c | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/src/kboot_gpu.c b/src/kboot_gpu.c
index 19572731..d44fcddc 100644
--- a/src/kboot_gpu.c
+++ b/src/kboot_gpu.c
@@ -4018,7 +4018,7 @@ static const struct {
         u32 fill[8][2];
         u8 sha[32];
         char name[8];
-    } build[4];
+    } build[5];
 } t6050_gpu = {
     /* The UAT ranges (base, size), then the bounds of both roles' __DATA and SRO */
     {"gpu-region-base", "gpu-region-size", "gfx-shared-region-base", "gfx-shared-region-size",
@@ -4090,6 +4090,19 @@ static const struct {
       {0xb5, 0x53, 0x7c, 0x8f, 0x06, 0xbd, 0x19, 0xeb, 0xf0, 0xef, 0xd0,
        0xcb, 0xfb, 0x65, 0x52, 0x33, 0x9a, 0x10, 0xd4, 0xaf, 0xc4, 0xed,
        0xa9, 0xd2, 0x1c, 0xbe, 0xdc, 0x36, 0x66, 0x76, 0x36, 0x00},
+      "26C5035"},
+     /* 26C5035r (27.3) on the M5 Max, with 26A428's records: aura #172 (joshuaswarren) */
+     {{{0x224, 4},
+       {0x23c, 8},
+       {0x49720, 0x740},
+       {0x49e60, 0x231},
+       {0x50224, 4},
+       {0x5023c, 8},
+       {0x9d1d8, 0x740},
+       {0x9d918, 0x231}},
+      {0xb7, 0x97, 0x17, 0x83, 0x72, 0xd1, 0xde, 0xb2, 0x8b, 0x56, 0xb5,
+       0xcc, 0x43, 0xe6, 0x45, 0xb1, 0x09, 0x88, 0x60, 0xc1, 0x6d, 0x69,
+       0x1f, 0x59, 0x91, 0xc1, 0xad, 0x8a, 0xfd, 0x5c, 0x07, 0xeb},
       "26C5035"}},
 };
 extern void aura_sha256(const void *data, size_t size, u8 digest[32]);
