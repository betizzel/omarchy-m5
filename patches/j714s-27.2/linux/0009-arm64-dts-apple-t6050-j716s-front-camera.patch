From 20775c50a773f57257594769cac83c3f1c962677 Mon Sep 17 00:00:00 2001
From: Julian Arango <95070226+ja-818@users.noreply.github.com>
Date: Sun, 22 Nov 2026 21:46:25 -0500
Subject: [PATCH 09/11] arm64: dts: apple: t6050-j716s: front camera

The J716s's camera: the shared T6050 ISP description (as upstream's
#2275 adds for the J716s), the camera light (ADT eic offset 141, the
J714s's eic), presets 1920x1080 and 1280x720 on config 5, and
apple,imx958-setfile = <0x2224>. The J716sAP 27.2 (26B123) ADT's isp0
and its DARTs are the J714s's but for the sensor type (0x76), and the
loader's handoff checks that and the firmware segments before enabling
anything.

Seen on one J716s (27.2 stub, with the loader's J716s row): the camera
streams in the browser and the green light turns on with it.

Signed-off-by: Julian Arango <95070226+ja-818@users.noreply.github.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 arch/arm64/boot/dts/apple/t6050-j716s.dts | 51 +++++++++++++++++++++++
 1 file changed, 51 insertions(+)

diff --git a/arch/arm64/boot/dts/apple/t6050-j716s.dts b/arch/arm64/boot/dts/apple/t6050-j716s.dts
index 7eb3a3415d8d..d6cf011a7786 100644
--- a/arch/arm64/boot/dts/apple/t6050-j716s.dts
+++ b/arch/arm64/boot/dts/apple/t6050-j716s.dts
@@ -587,3 +587,54 @@ tp-accel {
 
 #define T6050_J716S
 #include "t6050-peripherals.dtsi"
+
+/*
+ * The front camera: the T6050 ISP as on the J716c and J714s. The J716sAP 27.2
+ * (26B123) ADT's isp0 and its DARTs are the J714s's but for the sensor type
+ * (0x76), and the boot loader's hand-off checks that and the firmware segments
+ * before it enables anything.
+ */
+#include "t6050-j716c-isp.dtsi"
+
+&isp0 {
+	/*
+	 * The camera light: ADT eic cil-gpio-offset 141 in the eic's own GPIO
+	 * block, cil-gpio-config 0x474002, active high (the J716sAP eic is the
+	 * J714sAP's).
+	 */
+	reg = <0x5 0x80000000 0 0x1604000>,
+	      <0x5 0x82924000 0 0x40>,
+	      <0x5 0x829241d0 0 0x20>,
+	      <0x5 0x82924464 0 0x10>,
+	      <0x5 0xc3b50000 0 0x8000>,
+	      <0x2 0xdc000234 0 0x4>;
+	reg-names = "coproc", "mbox", "gpio", "mbox2", "wdt", "cil";
+	apple,cil-config = <0x474002>;
+	apple,cil-active-high;
+
+	/*
+	 * The 16-inch's IMX958 module as on rolotrealanis98's J716s (27.3 beta,
+	 * streaming): setfile 2224_01, firmware configuration 5 (1920x2160), as
+	 * on the J616s and J716c. apple_isp.imx958_setfile=0x2226 tries 2226_02.
+	 */
+	apple,imx958-setfile = <0x2224>;
+
+	/delete-node/ sensor-presets;
+
+	sensor-presets {
+		/* 1920x1080 */
+		preset0 {
+			apple,config-index = <5>;
+			apple,input-size = <1920 2160>;
+			apple,output-size = <1920 1080>;
+			apple,crop = <0 0 1920 1080>;
+		};
+		/* 1280x720: the same window as 1920x1080, scaled down */
+		preset1 {
+			apple,config-index = <5>;
+			apple,input-size = <1920 2160>;
+			apple,output-size = <1280 720>;
+			apple,crop = <0 0 1920 1080>;
+		};
+	};
+};
