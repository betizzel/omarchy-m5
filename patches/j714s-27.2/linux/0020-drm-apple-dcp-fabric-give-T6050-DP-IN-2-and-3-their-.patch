-			   unsigned int dpin);
+			   unsigned int dpin, bool per_dpin);
 struct dcp_fabric_route *
 dcp_fabric_tunnel_candidate(const struct dcp_fabric_port *port,
 			    const struct dcp_fabric_policy *policy,
