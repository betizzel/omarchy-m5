+	 * IN 1, and 3 unless per-DP IN), [2] and [3] DP IN 2 and 3 with per-DP
+	 * IN slots.
+	 */
+	struct dcp_fabric_route *owner[DCP_FABRIC_DPIN_MAX];
 	struct dcp_fabric_route *preferred;
