@@ -288,11 +288,18 @@ void dcp_fabric_plan(struct dcp_fabric_pipeline *pipelines,
 }
 EXPORT_SYMBOL_GPL(dcp_fabric_plan);
 
-/* 1 means an already handed, matching stream; zero admits allocation. */
+/*
+ * 1 means an already handed, matching stream; zero admits allocation.
+ * @per_dpin: DP IN 2 and 3 have owner slots of their own.
+ */
 int dcp_fabric_tunnel_slot(const struct dcp_fabric_port *port,
-			   unsigned int dpin)
+			   unsigned int dpin, bool per_dpin)
 {
-	const struct dcp_fabric_route *slot = port->owner[dcp_fabric_dpin_slot(dpin)];
+	const struct dcp_fabric_route *slot;
+
+	if (dpin >= DCP_FABRIC_DPIN_MAX)
+		return -EINVAL;
+	slot = port->owner[dcp_fabric_tunnel_owner(dpin, per_dpin)];
 
 	if (slot)
 		return slot->tunnel && slot->dpin == dpin ? 1 : -EADDRINUSE;
diff --git a/drivers/gpu/drm/apple/dcp-fabric-core.h b/drivers/gpu/drm/apple/dcp-fabric-core.h
index 602e7b2efb7f..a775649ff934 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-core.h
+++ b/drivers/gpu/drm/apple/dcp-fabric-core.h
@@ -8,8 +8,10 @@
 /*
  * A Thunderbolt DP tunnel enters through one of up to four DP IN adapters of
  * the port's host router, each behind a crossbar output of its own. A port
- * carries at most two streams, primary and secondary: DP IN n and n + 2 share
- * a stream slot.
+ * carries two streams, primary and secondary: DP IN n and n + 2 share a
+ * stream slot. Where every pipeline drives one DP IN of its own (T6050, fixed
+ * CRTCs), DP IN 2 and 3 have owner slots of their own as well; see
+ * dcp_fabric_tunnel_owner().
  */
 #define DCP_FABRIC_DPIN_MAX	4
 
@@ -18,6 +20,16 @@ static inline unsigned int dcp_fabric_dpin_slot(unsigned int dpin)
 	return dpin & 1;
 }
 
+/*
+ * The owner slot (dcp_fabric_port.owner[]) of DP IN @dpin: its stream slot,
+ * or the DP IN itself when @per_dpin, each pipeline taking one DP IN.
+ */
+static inline unsigned int dcp_fabric_tunnel_owner(unsigned int dpin,
+						   bool per_dpin)
+{
+	return per_dpin ? dpin : dcp_fabric_dpin_slot(dpin);
+}
