From 5ec50d8f5e9d6776105b17d31a6d1c589538964e Mon Sep 17 00:00:00 2001
From: Isaac Duarte <31712685+Isaac-Duarte@users.noreply.github.com>
Date: Sat, 14 Nov 2026 10:56:38 -0700
Subject: [PATCH 21/23] dt-bindings: display: apple: allow tunnel-only Type-C
 routes

A DCP route that carries USB4 DP tunnels only is not a Type-C mode-switch:
the Type-C class caps a connector's mode-switch providers
(TYPEC_MUX_MAX_DEVS), and a tunnel finds its port through the route's
endpoint. Add an apple,tunnel-only flag to the route node and require
mode-switch only on routes without it, in both apple,dcp and the common
apple,dcp-typec-routes schema.

The common schema also lacked the typecN-dpin2 and typecN-dpin3 crossbar
names T6050 device trees already use for the host router's third and fourth
DP IN adapters; allow them, up to the 21 controls apple,dcp allows.

Signed-off-by: Isaac Duarte <31712685+Isaac-Duarte@users.noreply.github.com>
---
 .../display/apple,dcp-typec-routes.yaml       | 32 ++++++++++++++++---
 .../bindings/display/apple,dcp.yaml           | 13 +++++++-
 2 files changed, 40 insertions(+), 5 deletions(-)

diff --git a/Documentation/devicetree/bindings/display/apple,dcp-typec-routes.yaml b/Documentation/devicetree/bindings/display/apple,dcp-typec-routes.yaml
index 7b2e28ac3dca..9bd123527b2c 100644
--- a/Documentation/devicetree/bindings/display/apple,dcp-typec-routes.yaml
+++ b/Documentation/devicetree/bindings/display/apple,dcp-typec-routes.yaml
@@ -24,7 +24,9 @@ description: |
   mux cells 0, 1 and 2 describe the DP PHY, DP IN 0 and DP IN 1 outputs,
   respectively. The per-port prefix distinguishes multiple ATCs on one DCP.
   Dual-stream wiring requires these two named controls and two port@3
-  endpoints. It does not describe SoC handshake or retry policy.
+  endpoints. It does not describe SoC handshake or retry policy. T6050 host
+  routers have four DP IN adapters; their crossbars add typecN-dpin2 and
+  typecN-dpin3 (cells 3 and 4).
 
   Legacy typecN-usb4 names describe cell 1 on old j414/j416 DTBs. With two
   port@3 endpoints they retain the existing dual-stream wiring; cell 2 is
@@ -56,12 +58,12 @@ properties:
 
   mux-controls:
     minItems: 1
-    maxItems: 13
+    maxItems: 21
     description: Fixed, DP Alt Mode and wired DP IN crossbar output controls.
 
   mux-control-names:
     minItems: 1
-    maxItems: 13
+    maxItems: 21
     items:
       anyOf:
         - enum:
@@ -72,12 +74,20 @@ properties:
             - typec3
             - typec0-dpin0
             - typec0-dpin1
+            - typec0-dpin2
+            - typec0-dpin3
             - typec1-dpin0
             - typec1-dpin1
+            - typec1-dpin2
+            - typec1-dpin3
             - typec2-dpin0
             - typec2-dpin1
+            - typec2-dpin2
+            - typec2-dpin3
             - typec3-dpin0
             - typec3-dpin1
+            - typec3-dpin2
+            - typec3-dpin3
         - enum: [typec0-usb4, typec1-usb4, typec2-usb4, typec3-usb4]
           deprecated: true
 
@@ -113,12 +123,26 @@ properties:
               - maximum: 3
           mode-switch:
             type: boolean
+          apple,tunnel-only:
+            type: boolean
+            description: |
+              The route carries USB4 DP tunnels only and is never given a DP
+              Alt Mode display. It is not a Type-C mode-switch, so a port
+              whose connector already has as many mode-switch providers as
+              the Type-C class allows can still offer another tunnel
+              pipeline.
           port:
             $ref: /schemas/graph.yaml#/properties/port
         required:
           - reg
-          - mode-switch
           - port
+        if:
+          not:
+            required:
+              - apple,tunnel-only
+        then:
+          required:
+            - mode-switch
     required:
       - '#address-cells'
       - '#size-cells'
diff --git a/Documentation/devicetree/bindings/display/apple,dcp.yaml b/Documentation/devicetree/bindings/display/apple,dcp.yaml
index d0bc33404c24..97da243b79c4 100644
--- a/Documentation/devicetree/bindings/display/apple,dcp.yaml
+++ b/Documentation/devicetree/bindings/display/apple,dcp.yaml
@@ -426,12 +426,23 @@ properties:
             maxItems: 1
           mode-switch:
             type: boolean
+          apple,tunnel-only:
+            type: boolean
+            description:
+              The route carries USB4 DP tunnels only, never a DP Alt Mode
+              display. It is not a Type-C mode-switch.
           port:
             $ref: /schemas/graph.yaml#/properties/port
         required:
           - reg
-          - mode-switch
           - port
+        if:
+          not:
+            required:
+              - apple,tunnel-only
+        then:
+          required:
+            - mode-switch
         additionalProperties: false
     required:
       - '#address-cells'
-- 
2.56.0

