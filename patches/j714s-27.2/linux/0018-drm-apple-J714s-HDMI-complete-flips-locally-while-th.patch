From eba4864d3362ae4e757940f6c24e0a55d4a1e7c0 Mon Sep 17 00:00:00 2001
From: FatBoy721 <203330788+FatBoy721@users.noreply.github.com>
Date: Fri, 13 Nov 2026 13:30:00 -0500
Subject: [PATCH 18/19] drm/apple: J714s HDMI: complete flips locally while the
 link comes up

With a sink already attached at boot, the first link of the J714s HDMI output
(dcpext3, 27.3 firmware) never shows a picture: the sink drops HPD ~2 s after
the mode set. DCP meanwhile swallows the compositor's presents ("swallowed swap
ID n as fControllerPowerState is 0 for External Display") without completing
them. dcp_swap_watchdog_arm() only watches Type-C outputs, desktop pipes and
the fw27 VRR panel, so the dropped present holds the IOMFB queue until the
10 s transaction timeout marks the DCP crashed, and HDMI stays dead until the
next boot ("wait for power timed out, connector will be broken"). A hotplug
after login works, because the compositor is idle while the link comes up.

While the fixed HDMI output connects (sink at boot, power-on, any HPD edge),
complete its flips locally for 8 s instead of presenting them. The automatic
reconnect after the sink drops the first link then works. Tested on the
owner's J714s: cold plug at boot, hotplug and replug all show the desktop;
the internal panel and the shell are not delayed. j714s_hdmi_hold=0 turns it off.

This is a workaround, not the root cause: arming the swap watchdog for a fixed
HDMI output on its own (dcp_swap_watchdog_arm) did not help on the H17P queue
path, and why the first link after boot shows no picture is still open.

Ported unchanged from FatBoy721/omarchy-m5 j714s-hdmi-upstream273 (898d8ad6cb) onto the J714s 27.2
series (integration/aurora a34d26c2 + betizzel/omarchy-m5 patches/j714s-27.2/linux). Not tried on 27.2.

Signed-off-by: FatBoy721 <203330788+FatBoy721@users.noreply.github.com>
---
 drivers/gpu/drm/apple/dcp-fabric.c     |  2 ++
 drivers/gpu/drm/apple/dcp.c            |  4 +++
 drivers/gpu/drm/apple/iomfb.c          | 39 ++++++++++++++++++++++++++
 drivers/gpu/drm/apple/iomfb_template.c |  2 ++
 4 files changed, 47 insertions(+)

diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index e00de74092ed..a0bf1c6cb0bc 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -5206,6 +5206,7 @@ static void dcp_hdmi_update_locked(struct apple_dcp *dcp)
 	dcp_fabric_run_hdmi(&dcp_hdmi_ops, dcp);
 }
 
+void j714s_hdmi_hold_presents(struct apple_dcp *dcp, unsigned int ms, const char *why);
 irqreturn_t dcp_dp2hdmi_hpd(int irq, void *data)
 {
 	struct apple_dcp *dcp = data;
@@ -5213,6 +5214,7 @@ irqreturn_t dcp_dp2hdmi_hpd(int irq, void *data)
 	if (dcp->fw_compat == DCP_FIRMWARE_V_26_6_DESKTOP)
 		return dcp_desktop_dp2hdmi_hpd(dcp);
 
+	j714s_hdmi_hold_presents(dcp, 8000, "HPD");
 	guard(mutex)(&dcp_typec_fabric_lock);
 	dcp_hdmi_update_locked(dcp);
 	/* The GPIO edge detector is off throughout an oneshot handler. */
diff --git a/drivers/gpu/drm/apple/dcp.c b/drivers/gpu/drm/apple/dcp.c
index 9f4993297748..789f3150f388 100644
--- a/drivers/gpu/drm/apple/dcp.c
+++ b/drivers/gpu/drm/apple/dcp.c
@@ -4414,6 +4414,8 @@ static const struct dcp_fabric_resume_ops dcp_resume_ops = {
 	.sample = dcp_resume_sample,
 };
 
+void j714s_hdmi_hold_presents(struct apple_dcp *dcp, unsigned int ms, const char *why);
+
 static int dcp_enable_dp2hdmi_hpd(struct apple_dcp *dcp)
 {
 	if (dcp_is_typec_output(dcp)) {
@@ -4424,6 +4426,8 @@ static int dcp_enable_dp2hdmi_hpd(struct apple_dcp *dcp)
 		bool connected = gpiod_get_value_cansleep(dcp->hdmi_hpd);
 		dev_info(dcp->dev, "%s: DP2HDMI HPD connected:%d\n", __func__, connected);
 
+		if (connected)
+			j714s_hdmi_hold_presents(dcp, 8000, "sink at boot");
 		if (connected && !READ_ONCE(dcp->hdmi_yielded))
 			dcp_dptx_connect(dcp, 0);
 		else if (!connected)
diff --git a/drivers/gpu/drm/apple/iomfb.c b/drivers/gpu/drm/apple/iomfb.c
index 9f82797f1255..546520c36d88 100644
--- a/drivers/gpu/drm/apple/iomfb.c
+++ b/drivers/gpu/drm/apple/iomfb.c
@@ -3735,6 +3735,40 @@ static bool dcp_fw27_vrr_switch(struct apple_dcp *dcp, struct drm_crtc *crtc,
 	return false;
 }
 
+/*
+ * J714s HDMI (2026-11-13 test 20): while the fixed HDMI output connects, its
+ * firmware drops presents without completing them, and one dropped present
+ * blocks the IOMFB queue until the DCP is declared crashed. Complete the
+ * compositor's flips locally instead, as if it were idle, until the link has
+ * been stable for a while.
+ */
+static bool j714s_hdmi_hold = true;
+module_param(j714s_hdmi_hold, bool, 0644);
+MODULE_PARM_DESC(j714s_hdmi_hold, "J714s: complete HDMI flips locally while the link comes up (test)");
+static unsigned long j714s_hdmi_hold_until;
+
+static bool j714s_hdmi_output(struct apple_dcp *dcp)
+{
+	return dcp->hdmi_hpd && dcp->fixed_phy && !dcp->main_display &&
+	       !dcp->active_typec_route;
+}
+
+void j714s_hdmi_hold_presents(struct apple_dcp *dcp, unsigned int ms, const char *why)
+{
+	if (!j714s_hdmi_hold || !j714s_hdmi_output(dcp))
+		return;
+	WRITE_ONCE(j714s_hdmi_hold_until, jiffies + msecs_to_jiffies(ms));
+	dev_info(dcp->dev, "J714S hold HDMI presents %u ms (%s)\n", ms, why);
+}
+
+static bool j714s_hdmi_presents_held(struct apple_dcp *dcp)
+{
+	unsigned long until = READ_ONCE(j714s_hdmi_hold_until);
+
+	return j714s_hdmi_hold && until && j714s_hdmi_output(dcp) &&
+	       time_before(jiffies, until);
+}
+
 void dcp_flush(struct drm_crtc *crtc, struct drm_atomic_commit *commit)
 {
 	struct platform_device *pdev = to_apple_crtc(crtc)->dcp;
@@ -3763,6 +3797,11 @@ void dcp_flush(struct drm_crtc *crtc, struct drm_atomic_commit *commit)
 		return;
 	}
 
+	if (j714s_hdmi_presents_held(dcp)) {
+		dcp_drm_crtc_vblank(to_apple_crtc(crtc));
+		return;
+	}
+
 	if (dcp->fw_compat == DCP_FIRMWARE_V_26_6) {
 		iomfb_v26_6_flush(dcp, crtc, commit);
 		return;
diff --git a/drivers/gpu/drm/apple/iomfb_template.c b/drivers/gpu/drm/apple/iomfb_template.c
index 21ac0deb9785..c118939c9310 100644
--- a/drivers/gpu/drm/apple/iomfb_template.c
+++ b/drivers/gpu/drm/apple/iomfb_template.c
@@ -40,6 +40,7 @@
 #include "dcp-property.h"
 #include "trace.h"
 #include "version_utils.h"
+void j714s_hdmi_hold_presents(struct apple_dcp *dcp, unsigned int ms, const char *why);
 
 /* Register defines used in bandwidth setup structure */
 #define REG_DOORBELL_BIT(idx) (2 + (idx))
@@ -2473,6 +2474,7 @@ void DCP_FW_NAME(iomfb_poweron)(struct apple_dcp *dcp)
 	u32 handle;
 #endif
 	dev_info(dcp->dev, "dcp_poweron() starting\n");
+	j714s_hdmi_hold_presents(dcp, 8000, "power on");
 	/* The firmware announces its compact services again after poweron. */
 	WRITE_ONCE(dcp->afk_power_gen, dcp->afk_power_gen + 1);
 
-- 
