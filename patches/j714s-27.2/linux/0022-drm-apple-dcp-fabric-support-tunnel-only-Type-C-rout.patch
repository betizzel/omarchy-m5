From bb2b2870f240439798ad52a795b65e43972ed610 Mon Sep 17 00:00:00 2001
From: Isaac Duarte <31712685+Isaac-Duarte@users.noreply.github.com>
Date: Sat, 14 Nov 2026 10:56:38 -0700
Subject: [PATCH 22/23] drm/apple: dcp-fabric: support tunnel-only Type-C
 routes

A route marked apple,tunnel-only exists to give USB4 DP tunnels another
pipeline. It is in its port's route list like any other, so a DP alt mode
display on that port could be given it, through a path never tested on it,
and take the pipeline the tunnel was meant to have.

Mark such routes in the fabric core, and pass them over for a direct
stream: when picking a free route, including the port's last one, in the
dual-stream pairing plan, when a route follows its CRTC (as the moved
stream or as the holder swapped away), and where the driver moves a DP alt
mode display to another pipeline (dcp_typec_move_starved_locked(),
dcp_typec_move_off_hybrid_locked() and dcp_typec_hdmi_reclaim()). Tunnels
choose them as before. The pairing plan takes a port's stream for a
tunnel when a tunnel holds any of its owner slots, not only the first.

On T6050 every port/pipeline pair gets a DRM connector, in pipeline
order. A new tunnel-only route would come before the pairs of later
pipelines and renumber their connectors (DP-3 becoming DP-4), which breaks
compositor configurations keyed on connector names. Create the tunnel-only
pairs in a second pass, after all the others, so the existing connectors
keep their names and the new ones come last.

Signed-off-by: Isaac Duarte <31712685+Isaac-Duarte@users.noreply.github.com>
---
 drivers/gpu/drm/apple/apple_drv.c       | 20 +++++--
 drivers/gpu/drm/apple/dcp-fabric-core.c | 26 +++++++--
 drivers/gpu/drm/apple/dcp-fabric-core.h |  2 +
 drivers/gpu/drm/apple/dcp-fabric-test.c | 72 +++++++++++++++++++++++++
 drivers/gpu/drm/apple/dcp-fabric.c      | 26 +++++++++
 drivers/gpu/drm/apple/dcp-fabric.h      |  1 +
 6 files changed, 138 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/apple/apple_drv.c b/drivers/gpu/drm/apple/apple_drv.c
index 9959f24170e9..bd57a279537c 100644
--- a/drivers/gpu/drm/apple/apple_drv.c
+++ b/drivers/gpu/drm/apple/apple_drv.c
@@ -1234,22 +1234,28 @@ static int apple_probe_per_dcp(struct device *dev,
  * connector per port for a dock's second DP tunnel, preserving primary
  * connector names. T6050 instead exposes one connector per port/pipeline
  * pair: tunnel allocation chooses which connector is connected, without
- * changing any encoder's advertised CRTC mask after registration.
+ * changing any encoder's advertised CRTC mask after registration. Pairs
+ * whose route carries DP tunnels only come last, so adding such a route
+ * does not renumber the connectors that existed before it.
  */
 static int apple_probe_typec_ports(struct drm_device *drm,
 				   struct platform_device **dcp,
 				   u32 *crtc_mask, int num_dcp)
 {
-	unsigned int idx, nr_ports = dcp_typec_nr_ports();
+	unsigned int n, nr_ports = dcp_typec_nr_ports();
 	bool fixed = dcp_typec_fixed_crtcs();
 	unsigned int slots = fixed ? num_dcp : (dcp_typec_dual_stream() ? 2 : 1);
+	/* T6050 creates its tunnel-only port/pipeline pairs in a second pass. */
+	unsigned int passes = fixed ? 2 : 1;
 	int i, ret;
 
 	/* Keep the existing physical-port connector numbers stable. On the
 	 * M2 Pro/Max laptops, append one more connector per port for a second
 	 * USB4 DP tunnel.
 	 */
-	for (idx = 0; idx < nr_ports * slots; idx++) {
+	for (n = 0; n < passes * nr_ports * slots; n++) {
+		unsigned int pass = n / (nr_ports * slots);
+		unsigned int idx = n % (nr_ports * slots);
 		struct apple_connector *connector;
 		struct apple_encoder *enc;
 		struct platform_device *pipeline = fixed ? dcp[idx / nr_ports] : NULL;
@@ -1259,14 +1265,18 @@ static int apple_probe_typec_ports(struct drm_device *drm,
 
 		/* Only a failed T8122 dcpext could drive it: no connector. */
 		if (dcp_typec_port_unusable(port_idx)) {
-			drm_warn(drm, "Type-C port %u: its display pipeline is unusable\n",
-				 port_idx);
+			if (!pass)
+				drm_warn(drm, "Type-C port %u: its display pipeline is unusable\n",
+					 port_idx);
 			continue;
 		}
 
 		if (fixed) {
 			if (!dcp_typec_port_has_candidate(port_idx, pipeline))
 				continue;
+			/* T6050: tunnel-only pairs in the second pass */
+			if (dcp_typec_port_tunnel_only(port_idx, pipeline) != pass)
+				continue;
 			mask = crtc_mask[idx / nr_ports];
 			if (!mask)
 				continue;
diff --git a/drivers/gpu/drm/apple/dcp-fabric-core.c b/drivers/gpu/drm/apple/dcp-fabric-core.c
index 8b87a129eae9..74328af75a7b 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-core.c
+++ b/drivers/gpu/drm/apple/dcp-fabric-core.c
@@ -186,7 +186,8 @@ dcp_fabric_free_route(const struct dcp_fabric_port *port,
 	for (route = port->routes; route; route = route->next) {
 		unsigned int score;
 
-		if (!dcp_fabric_available(route->pipeline, policy))
+		if (route->tunnel_only ||
+		    !dcp_fabric_available(route->pipeline, policy))
 			continue;
 		score = dcp_fabric_score(route->pipeline, policy);
 		if (score < best_score) {
@@ -194,7 +195,8 @@ dcp_fabric_free_route(const struct dcp_fabric_port *port,
 			best_score = score;
 		}
 	}
-	if (!last || !dcp_fabric_available(last->pipeline, policy))
+	if (!last || last->tunnel_only ||
+	    !dcp_fabric_available(last->pipeline, policy))
 		return best;
 	if (!policy->dual_stream && best &&
 	    best_score < dcp_fabric_score(last->pipeline, policy))
@@ -215,6 +217,17 @@ dcp_fabric_port_route(const struct dcp_fabric_port *port,
 	return NULL;
 }
 
+/* Does a DP tunnel hold any of @port's owner slots? */
+static bool dcp_fabric_port_tunneled(const struct dcp_fabric_port *port)
+{
+	unsigned int i;
+
+	for (i = 0; i < DCP_FABRIC_DPIN_MAX; i++)
+		if (port->owner[i] && port->owner[i]->tunnel)
+			return true;
+	return false;
+}
+
 static void dcp_fabric_plan_pipeline(struct dcp_fabric_pipeline *pipeline,
 				     const struct dcp_fabric_port *ports,
 				     const struct dcp_fabric_port *arriving,
@@ -242,10 +255,11 @@ static void dcp_fabric_plan_pipeline(struct dcp_fabric_pipeline *pipeline,
 			      BIT(pipeline->crtc_index)))
 				continue;
 			route = dcp_fabric_port_route(port, pipeline);
-			tunnel = stream || (port->owner[0] && port->owner[0]->tunnel) ||
+			tunnel = stream || dcp_fabric_port_tunneled(port) ||
 				 (port == arriving && dpin == 0);
 			if (!route || (tunnel &&
-				       (route->tunnel_clock_blocked & BIT(stream))))
+				       (route->tunnel_clock_blocked & BIT(stream))) ||
+			    (!tunnel && route->tunnel_only))
 				continue;
 			port->plan->target[stream] = route;
 			return;
@@ -398,6 +412,10 @@ dcp_fabric_follow(const struct dcp_fabric_route *from,
 		(holder->dpin >= DCP_FABRIC_DPIN_MAX ||
 		 (holder_back->tunnel_clock_blocked & BIT(holder->dpin)))))
 		return DCP_FABRIC_FOLLOW_REFUSE;
+	/* A direct stream never moves onto a tunnel-only route. */
+	if ((!from->tunnel && to->tunnel_only) ||
+	    (holder && !holder->tunnel && holder_back && holder_back->tunnel_only))
+		return DCP_FABRIC_FOLLOW_REFUSE;
 	pipeline = to->pipeline;
 	if (!pipeline->bound || pipeline->fixed_busy || pipeline->terminal ||
 	    !pipeline->services_ready)
diff --git a/drivers/gpu/drm/apple/dcp-fabric-core.h b/drivers/gpu/drm/apple/dcp-fabric-core.h
index a775649ff934..8ee2f535dfe6 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-core.h
+++ b/drivers/gpu/drm/apple/dcp-fabric-core.h
@@ -65,6 +65,8 @@ struct dcp_fabric_route {
 	unsigned int dpin;
 	/* DP IN adapters this source cannot clock; direct DP is unaffected. */
 	u8 tunnel_clock_blocked;
+	/* Carries DP tunnels only, never a direct DP-alt stream. */
+	bool tunnel_only;
 };
 
 struct dcp_fabric_plan {
diff --git a/drivers/gpu/drm/apple/dcp-fabric-test.c b/drivers/gpu/drm/apple/dcp-fabric-test.c
index fed2534f6584..542852e4409c 100644
--- a/drivers/gpu/drm/apple/dcp-fabric-test.c
+++ b/drivers/gpu/drm/apple/dcp-fabric-test.c
@@ -2108,6 +2108,77 @@ static void fabric_per_dpin_slot_test(struct kunit *test)
 	KUNIT_EXPECT_EQ(test, dcp_fabric_tunnel_slot(&port, 3, true), -EBUSY);
 }
 
+/* A tunnel-only route never takes a direct DP-alt stream. */
+static void fabric_tunnel_only_test(struct kunit *test)
+{
+	struct fabric_fixture f;
+	int error;
+
+	/* Pipeline 1 would win: the hybrid pipeline 0 is kept for HDMI. */
+	fabric_init(&f, false);
+	f.route[0][1].tunnel_only = true;
+	KUNIT_EXPECT_PTR_EQ(test, dcp_fabric_free_route(&f.port[0], &f.policy),
+			    &f.route[0][0]);
+	/* not even as the port's last route */
+	f.port[0].preferred = &f.route[0][1];
+	KUNIT_EXPECT_PTR_EQ(test, dcp_fabric_free_route(&f.port[0], &f.policy),
+			    &f.route[0][0]);
+	/* It still carries a tunnel. */
+	KUNIT_EXPECT_PTR_EQ(test,
+			    dcp_fabric_tunnel_candidate(&f.port[0], &f.policy, NULL,
+							false, 0, true, &error),
+			    &f.route[0][1]);
+	f.route[0][0].tunnel_only = true;
+	KUNIT_EXPECT_PTR_EQ(test, dcp_fabric_free_route(&f.port[0], &f.policy),
+			    NULL);
+
+	/* The pairing plan passes it over for a direct stream only. */
+	fabric_init(&f, true);
+	f.route[0][0].tunnel_only = true;
+	f.port[0].wanted = true;
+	f.port[0].hpd = true;
+	dcp_fabric_plan(f.pipeline, f.port, NULL, 0);
+	KUNIT_EXPECT_PTR_EQ(test, f.plan[0].target[0], &f.route[0][1]);
+	f.port[0].wanted = false;
+	dcp_fabric_plan(f.pipeline, f.port, &f.port[0], 0);
+	KUNIT_EXPECT_PTR_EQ(test, f.plan[0].target[0], &f.route[0][0]);
+
+	/* A tunnel in a per-DP IN slot makes the port's stream a tunnel. */
+	fabric_init(&f, true);
+	f.route[0][0].tunnel_only = true;
+	f.port[0].wanted = true;
+	f.port[0].hpd = true;
+	f.route[1][1].tunnel = true;
+	f.port[0].owner[2] = &f.route[1][1];
+	dcp_fabric_plan(f.pipeline, f.port, NULL, 0);
+	KUNIT_EXPECT_PTR_EQ(test, f.plan[0].target[0], &f.route[0][0]);
+
+	/* A direct stream does not follow its CRTC onto it; a tunnel does. */
+	fabric_init(&f, false);
+	f.route[0][1].tunnel_only = true;
+	KUNIT_EXPECT_EQ(test, dcp_fabric_follow(&f.route[0][0], &f.route[0][1],
+						NULL, NULL, false, &f.policy),
+			DCP_FABRIC_FOLLOW_REFUSE);
+	f.route[0][0].tunnel = true;
+	KUNIT_EXPECT_EQ(test, dcp_fabric_follow(&f.route[0][0], &f.route[0][1],
+						NULL, NULL, false, &f.policy),
+			DCP_FABRIC_FOLLOW_MOVE);
+	/* nor is a direct holder swapped onto one */
+	f.route[1][0].tunnel_only = true;
+	f.pipeline[1].owned = true;
+	f.route[0][0].tunnel_only = false;
+	f.route[0][1].tunnel_only = false;
+	KUNIT_EXPECT_EQ(test, dcp_fabric_follow(&f.route[0][0], &f.route[0][1],
+						&f.route[1][1], &f.route[1][0], true,
+						&f.policy),
+			DCP_FABRIC_FOLLOW_REFUSE);
+	f.route[1][0].tunnel_only = false;
+	KUNIT_EXPECT_EQ(test, dcp_fabric_follow(&f.route[0][0], &f.route[0][1],
+						&f.route[1][1], &f.route[1][0], true,
+						&f.policy),
+			DCP_FABRIC_FOLLOW_SWAP);
+}
+
 static void fabric_t6030_follow_test(struct kunit *test)
 {
 	struct fabric_fixture f;
@@ -2433,6 +2504,7 @@ static struct kunit_case fabric_tests[] = {
 	KUNIT_CASE(fabric_t6030_plan_test),
 	KUNIT_CASE(fabric_t6030_follow_test),
 	KUNIT_CASE(fabric_per_dpin_slot_test),
+	KUNIT_CASE(fabric_tunnel_only_test),
 	KUNIT_CASE(fabric_reclaim_transaction_test),
 	KUNIT_CASE_PARAM(fabric_shared_wiring_test, fabric_wiring_gen_params),
 	KUNIT_CASE(fabric_binding_cookie_test),
diff --git a/drivers/gpu/drm/apple/dcp-fabric.c b/drivers/gpu/drm/apple/dcp-fabric.c
index 6d50b8dffcf0..d5164ecd5ff5 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.c
+++ b/drivers/gpu/drm/apple/dcp-fabric.c
@@ -1091,6 +1091,7 @@ static bool dcp_typec_move_starved_locked(void)
 			continue;
 		list_for_each_entry(route, &port->routes, port_link) {
 			if (route != owner && route->dcp->fixed_phy &&
+			    !route->core.tunnel_only &&
 			    dcp_typec_route_available(route)) {
 				to = route;
 				break;
@@ -1138,6 +1139,7 @@ static bool dcp_typec_move_off_hybrid_locked(struct apple_dcp_typec_port *port,
 		return false;
 	list_for_each_entry(route, &port->routes, port_link) {
 		if (route != owner && !route->dcp->fixed_phy && route->dcp->crtc &&
+		    !route->core.tunnel_only &&
 		    dcp_typec_route_available(route)) {
 			to = route;
 			break;
@@ -4292,6 +4294,25 @@ bool dcp_typec_port_has_candidate(unsigned int idx, struct platform_device *pdev
 	return false;
 }
 
+/* Is @pdev's route to port @idx for DP tunnels only (apple,tunnel-only)? */
+bool dcp_typec_port_tunnel_only(unsigned int idx, struct platform_device *pdev)
+{
+	struct apple_dcp_typec_port *port;
+	struct apple_dcp_typec_route *route;
+
+	guard(mutex)(&dcp_typec_fabric_lock);
+
+	port = dcp_typec_port_by_index(idx);
+	if (!port)
+		return false;
+
+	list_for_each_entry(route, &port->routes, port_link)
+		if (route->dcp->dev == &pdev->dev)
+			return route->core.tunnel_only;
+
+	return false;
+}
+
 /*
  * Is every pipeline that can drive port @idx unusable (a failed T8122
  * dcpext, or a T8132 dcpext, whose DRM outputs are its own, see
@@ -4553,6 +4574,10 @@ static int dcp_register_typec_routes_present(void *data)
 			return dev_err_probe(dev, ret, "%pOF: missing crossbar state\n",
 					     route_np);
 
+		/* A route for USB4 DP tunnels only is never given a DP-alt stream. */
+		route->core.tunnel_only =
+			of_property_read_bool(route_np, "apple,tunnel-only");
+
 		ret = of_property_read_u32_index(dev->of_node, "apple,typec-dptx-phys",
 						 route_index, &route->dptx_phy);
 		if (ret)
@@ -4990,6 +5015,7 @@ static bool dcp_typec_hdmi_reclaim(struct apple_dcp *dcp)
 		return false;
 	list_for_each_entry(route, &port->routes, port_link) {
 		if (route == owner || !route->dcp->crtc ||
+		    (!owner->tunnel && route->core.tunnel_only) ||
 		    !dcp_typec_route_available(route) ||
 		    (owner->tunnel && !dcp_typec_tunnel_ctl(route, owner->tunnel_dpin)) ||
 		    (port->split_dcp == dcp && !dcp_follow_split_fits(route)))
diff --git a/drivers/gpu/drm/apple/dcp-fabric.h b/drivers/gpu/drm/apple/dcp-fabric.h
index edca8065bd21..98f9d893c568 100644
--- a/drivers/gpu/drm/apple/dcp-fabric.h
+++ b/drivers/gpu/drm/apple/dcp-fabric.h
@@ -76,6 +76,7 @@ bool dcp_has_typec_routes(struct platform_device *pdev);
 unsigned int dcp_typec_nr_ports(void);
 struct device_node *dcp_typec_port_of_node(unsigned int idx);
 bool dcp_typec_port_has_candidate(unsigned int idx, struct platform_device *pdev);
+bool dcp_typec_port_tunnel_only(unsigned int idx, struct platform_device *pdev);
 bool dcp_typec_port_unusable(unsigned int idx);
 void dcp_typec_port_set_connector(unsigned int idx, bool secondary,
 				  struct apple_connector *connector,
