From a9e5791e1adcc6f393c32194fc8f3e3b633aefcd Mon Sep 17 00:00:00 2001
From: Eduard Moldovan <edimoldovan@gmail.com>
Date: Sun, 8 Nov 2026 12:56:35 +0100
Subject: [PATCH 11/23] media: apple: isp: Drive the J714c camera light from
 the driver

On the J714c the camera light belongs to the exclave indicator
controller, which Linux does not run: the sensor streams with the light
off. Frames pass only while the controller's ISP watchdog (eic
mmio-wd-isp) is fed.

Make the light the driver's: before every stream start, drive the light
pin (ADT eic cil-gpio-offset 141 in gpio0, cil-gpio-config 0x474002) as
an output at its on level with its input buffer on, and refuse the
stream unless the pin reads back at that level. Turn it off only after
the stream stops, a start fails or the firmware halts. Feed the capture
watchdog only while the light is on. A T6050 ISP without a described
light does not probe.

Signed-off-by: Eduard Moldovan <edimoldovan@gmail.com>
Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
(cherry picked from commit 5a3e9d8a5f0b2e64cf89b4a96bb6f158afa50df7)
---
 drivers/media/platform/apple/isp/isp-cam.c | 56 +++++++++++++++++++++-
 drivers/media/platform/apple/isp/isp-cam.h |  1 +
 drivers/media/platform/apple/isp/isp-drv.c | 21 ++++++++
 drivers/media/platform/apple/isp/isp-drv.h | 11 +++++
 drivers/media/platform/apple/isp/isp-fw.c  |  1 +
 5 files changed, 89 insertions(+), 1 deletion(-)

diff --git a/drivers/media/platform/apple/isp/isp-cam.c b/drivers/media/platform/apple/isp/isp-cam.c
index c31535de2033..b008dbe75806 100644
--- a/drivers/media/platform/apple/isp/isp-cam.c
+++ b/drivers/media/platform/apple/isp/isp-cam.c
@@ -1,6 +1,7 @@
 // SPDX-License-Identifier: GPL-2.0-only
 /* Copyright 2023 Eileen Yoon <eyn@gmx.com> */
 
+#include <linux/delay.h>
 #include <linux/firmware.h>
 #include <linux/gcd.h>
 #include <linux/log2.h>
@@ -1162,6 +1163,8 @@ static enum hrtimer_restart apple_isp_wdt_timer(struct hrtimer *timer)
 	struct apple_isp *isp = container_of(timer, struct apple_isp,
 					     wdt_timer);
 
+	if (isp->hw->camera_light && !isp->cil_lit)
+		return HRTIMER_NORESTART;
 	apple_isp_wdt_kick(isp);
 	hrtimer_forward_now(timer, ns_to_ktime(ISP_WDT_PERIOD_NS));
 
@@ -1178,6 +1181,8 @@ static void apple_isp_wdt_start(struct apple_isp *isp)
 {
 	if (!isp->wdt || isp->wdt_running)
 		return;
+	if (isp->hw->camera_light && !isp->cil_lit)
+		return;
 
 	isp->wdt_running = true;
 	apple_isp_wdt_kick(isp);
@@ -1194,16 +1199,64 @@ void apple_isp_wdt_stop(struct apple_isp *isp)
 	isp->wdt_running = false;
 }
 
+#define ISP_GPIO_DATA		BIT(0)
+#define ISP_GPIO_MODE		GENMASK(3, 1)
+#define ISP_GPIO_INPUT_ENABLE	BIT(9)
+/* The mode and the pin's level, as the input buffer reads it */
+#define ISP_GPIO_CHECK		(ISP_GPIO_MODE | ISP_GPIO_DATA)
+
+/*
+ * Light the camera light before the sensor may stream: drive its pin as an
+ * output at the on level, with the input buffer on so the pin's level reads
+ * back, and refuse to stream unless it does.
+ */
+static int apple_isp_light_on(struct apple_isp *isp)
+{
+	u32 val, on = isp->cil_on_high ? ISP_GPIO_DATA : 0;
+
+	if (!isp->hw->camera_light)
+		return 0;
+	if (!isp->cil_lit)
+		isp->cil_saved = readl(isp->cil);
+	val = (isp->cil_config & ~ISP_GPIO_DATA) | ISP_GPIO_INPUT_ENABLE | on;
+	writel(val, isp->cil);
+	usleep_range(10, 20);
+	if ((readl(isp->cil) & ISP_GPIO_CHECK) != (val & ISP_GPIO_CHECK)) {
+		dev_err(isp->dev, "camera light did not come on (0x%x, wrote 0x%x), not streaming\n",
+			readl(isp->cil), val);
+		writel(isp->cil_saved, isp->cil);
+		return -EIO;
+	}
+	isp->cil_lit = true;
+	return 0;
+}
+
+/* Only once the sensor has stopped streaming. */
+void apple_isp_light_off(struct apple_isp *isp)
+{
+	if (!isp->hw->camera_light || !isp->cil_lit)
+		return;
+	apple_isp_wdt_stop(isp);
+	isp->cil_lit = false;
+	writel(isp->cil_saved, isp->cil);
+}
+
 int apple_isp_start_capture(struct apple_isp *isp)
 {
 	int err;
 
+	err = apple_isp_light_on(isp);
+	if (err)
+		return err;
+
 	/* Serviced from before the channel starts... */
 	apple_isp_wdt_start(isp);
 
 	err = isp_cmd_ch_start(isp, 0); // TODO channel mask
-	if (err)
+	if (err) {
 		apple_isp_wdt_stop(isp);
+		apple_isp_light_off(isp);
+	}
 
 	return err;
 }
@@ -1217,6 +1270,7 @@ void apple_isp_stop_capture(struct apple_isp *isp)
 
 	/* ... until its buffers are back. */
 	apple_isp_wdt_stop(isp);
+	apple_isp_light_off(isp);
 }
 
 #if IS_ENABLED(CONFIG_VIDEO_APPLE_ISP_KUNIT_TEST)
diff --git a/drivers/media/platform/apple/isp/isp-cam.h b/drivers/media/platform/apple/isp/isp-cam.h
index 51c2f2ec6c07..b81efea0cb33 100644
--- a/drivers/media/platform/apple/isp/isp-cam.h
+++ b/drivers/media/platform/apple/isp/isp-cam.h
@@ -22,6 +22,7 @@ int apple_isp_start_capture(struct apple_isp *isp);
 void apple_isp_stop_capture(struct apple_isp *isp);
 
 void apple_isp_wdt_init(struct apple_isp *isp);
+void apple_isp_light_off(struct apple_isp *isp);
 void apple_isp_wdt_stop(struct apple_isp *isp);
 
 #endif /* __ISP_CAM_H__ */
diff --git a/drivers/media/platform/apple/isp/isp-drv.c b/drivers/media/platform/apple/isp/isp-drv.c
index 0153f1da8263..f9cd871c88a1 100644
--- a/drivers/media/platform/apple/isp/isp-drv.c
+++ b/drivers/media/platform/apple/isp/isp-drv.c
@@ -811,6 +811,25 @@ static int apple_isp_probe(struct platform_device *pdev)
 		apple_isp_wdt_init(isp);
 	}
 
+	if (isp->hw->camera_light) {
+		res = platform_get_resource_byname(pdev, IORESOURCE_MEM, "cil");
+		if (!res ||
+		    of_property_read_u32(dev->of_node, "apple,cil-config",
+					 &isp->cil_config)) {
+			dev_err(dev, "no camera light described, not using the camera\n");
+			err = -ENODEV;
+			goto detach_genpd;
+		}
+		/* Not requested: the pin sits in a GPIO block Linux does not own. */
+		isp->cil = devm_ioremap(dev, res->start, resource_size(res));
+		if (!isp->cil) {
+			err = -ENOMEM;
+			goto detach_genpd;
+		}
+		isp->cil_on_high = of_property_read_bool(dev->of_node,
+							 "apple,cil-active-high");
+	}
+
 	isp->irq = platform_get_irq(pdev, 0);
 	if (isp->irq < 0) {
 		err = isp->irq;
@@ -1438,6 +1457,8 @@ static const struct apple_isp_hw apple_isp_hw_t6050 = {
 	/* As macOS's appleh16camerad sets them for the J714c's IMX958 */
 	.lsc_ideal_percent = 84,
 	.ae_fd_scene_metering = true,
+	/* The camera light, from the device tree's "cil" register */
+	.camera_light = true,
 };
 
 static const struct of_device_id apple_isp_of_match[] = {
diff --git a/drivers/media/platform/apple/isp/isp-drv.h b/drivers/media/platform/apple/isp/isp-drv.h
index c13914ef62e9..82392cbfee51 100644
--- a/drivers/media/platform/apple/isp/isp-drv.h
+++ b/drivers/media/platform/apple/isp/isp-drv.h
@@ -260,6 +260,11 @@ struct apple_isp_hw {
 	 * detected only once.
 	 */
 	bool deferred_start;
+	/*
+	 * The camera light is the driver's to drive: no stream starts unless
+	 * it is lit, and the capture watchdog is fed only while it is.
+	 */
+	bool camera_light;
 
 	/* The xx24 setfiles' lens shading strides need zeroing (T8142). */
 	bool setfile_stride_fixup;
@@ -409,6 +414,12 @@ struct apple_isp {
 	void __iomem *gpio;
 	void __iomem *mbox2;
 	void __iomem *wdt;
+	/* The camera light's GPIO register (hw->camera_light) */
+	void __iomem *cil;
+	u32 cil_config;
+	u32 cil_saved;
+	bool cil_on_high;
+	bool cil_lit;
 	void __iomem *dapf;
 	struct hrtimer wdt_timer;
 	bool wdt_running;
diff --git a/drivers/media/platform/apple/isp/isp-fw.c b/drivers/media/platform/apple/isp/isp-fw.c
index 09b691228650..3c39a1d5fc9d 100644
--- a/drivers/media/platform/apple/isp/isp-fw.c
+++ b/drivers/media/platform/apple/isp/isp-fw.c
@@ -1428,6 +1428,7 @@ void apple_isp_firmware_halt(struct apple_isp *isp)
 		return;
 
 	isp_firmware_shutdown(isp);
+	apple_isp_light_off(isp);
 	pm_runtime_put_sync(isp->dev);
 	isp->ipc_stale = NULL;
 	isp->fw_idle = false;
-- 
2.56.0

